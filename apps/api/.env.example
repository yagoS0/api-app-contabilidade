# =============================================================================
# apps/api/.env.example
#
# Copie para `apps/api/.env` e preencha. NUNCA commite o .env (gitignored).
# Em produção (Railway) estas variáveis vivem no painel do serviço, não em arquivo.
#
# Legenda:  [OBRIGATORIA]  sem ela a API não sobe / quebra em runtime
#           [OPCIONAL]     tem default no código (indicado ao lado)
# =============================================================================

# --- Núcleo ------------------------------------------------------------------
NODE_ENV=development                       # [OPCIONAL] production liga CORS estrito + log JSON
PORT=3000                                  # [OPCIONAL] default 3000
HOST=                                      # [OPCIONAL] default 0.0.0.0
LOG_LEVEL=info                             # [OPCIONAL] pino: trace|debug|info|warn|error
TZ=America/Sao_Paulo                       # [OPCIONAL] competência/fuso das rotinas fiscais

# CORS: só é exigido quando NODE_ENV=production (CSV de origens).
# Em dev qualquer origem passa (vite, ferramentas).
CORS_ALLOWED_ORIGINS=                      # [OPCIONAL em dev] ex: https://app.dominio.com,https://staging.dominio.com

# --- Banco -------------------------------------------------------------------
# [OBRIGATORIA]
# Local com o container Docker `enviar-pg` (postgres:16, volume pgdata_enviar):
#   DATABASE_URL="postgresql://enviar:SUA_SENHA@localhost:5432/enviar?schema=public"
# O container expõe 5432 no host. Se houver um PostgreSQL nativo do Windows ocupando
# a porta, pare-o antes:  Stop-Service postgresql-x64-15 -Force  (terminal admin)
DATABASE_URL=

# --- Autenticação (JWT) ------------------------------------------------------
JWT_SECRET=                                # [OBRIGATORIA] gere: openssl rand -base64 48
PORTAL_AUDIENCE=portal-contador            # [OPCIONAL] default portal-contador (o app do cliente usa outro aud)
JWT_EXPIRES_IN=1h                          # [OPCIONAL] default 1h
REFRESH_TOKEN_EXPIRES_IN=7d                # [OPCIONAL] default 7d
API_KEYS=                                  # [OPCIONAL] CSV de chaves para acesso máquina-a-máquina
AUTH_USERS=                                # [OPCIONAL] array JSON de usuários seed (legado)

# --- Parser de PDF (apps/pdf-reader, FastAPI) --------------------------------
# [OBRIGATORIA na prática] sem ela o upload/parse de guias falha com mensagem explícita.
# Local (serviço rodando na máquina):   http://localhost:8000
# Docker/rede interna (Railway):        http://pdf-reader:8000
PDF_READER_URL=http://localhost:8000
PDF_READER_TIMEOUT_MS=30000                # [OPCIONAL] default 30000, mínimo 1000

# --- Certificados A1 por empresa ---------------------------------------------
# [OBRIGATORIA] chave-mestra que cifra os PFX. NÃO tem fallback pro JWT_SECRET (de propósito:
# rotacionar o JWT tornaria os certificados ilegíveis). Mínimo 32 chars.
# Gere com: openssl rand -base64 48
CERT_SECRET_KEY=
CERT_STORAGE_PATH=./storage/certificates   # [OPCIONAL] default ./storage/certificates

# Cofre AWS KMS (envelope encryption) — opcional. Se AWS_KMS_CERT_KEY_ID vier preenchida,
# novos certificados nascem cifrados por DEK do KMS. Sem isso, usa CERT_SECRET_KEY local.
AWS_KMS_CERT_KEY_ID=                       # [OPCIONAL]
AWS_KMS_REGION=sa-east-1                   # [OPCIONAL] default sa-east-1
AWS_KMS_ACCESS_KEY_ID=                     # [OPCIONAL] cai em AWS_ACCESS_KEY_ID se vazio
AWS_KMS_SECRET_ACCESS_KEY=                 # [OPCIONAL] cai em AWS_SECRET_ACCESS_KEY se vazio

# --- E-mail ------------------------------------------------------------------
# Dois caminhos: Gmail API (delegação/DWD) OU SMTP. USE_GMAIL_API=1 escolhe o primeiro.
USE_GMAIL_API=0                            # [OPCIONAL] "1" liga a Gmail API
GMAIL_DELEGATED_USER=                      # [OBRIGATORIA se USE_GMAIL_API=1] ex: yago@dominio.com.br
GOOGLE_APPLICATION_CREDENTIALS_JSON=       # [OBRIGATORIA se USE_GMAIL_API=1] JSON da service account (string inteira)
GOOGLE_APPLICATION_CREDENTIALS=            # [OPCIONAL] alternativa: caminho do arquivo JSON

SMTP_HOST=smtp.gmail.com                   # [OPCIONAL] default smtp.gmail.com
SMTP_PORT=587                              # [OPCIONAL] default 587
SMTP_USER=                                 # [OBRIGATORIA se usar SMTP]
SMTP_PASS=                                 # [OBRIGATORIA se usar SMTP]
SMTP_FROM=                                 # [OPCIONAL] remetente; se vazio cai em GMAIL_DELEGATED_USER

# --- SERPRO / Integra Contador -----------------------------------------------
# ATENÇÃO: as credenciais efetivas do SERPRO são gravadas no BANCO pela tela
# "Configuração SERPRO" (SerproRuntimeSettings), não por estas vars. Estas servem
# de bootstrap/fallback e para scripts fora do app.
SERPRO_BASE_URL=                           # [OPCIONAL]
SERPRO_AUTH_URL=                           # [OPCIONAL]
SERPRO_TOKEN_PATH=/token                   # [OPCIONAL] default /token
SERPRO_INTEGRA_CONTADOR_PATH=/integra-contador/v1  # [OPCIONAL]
SERPRO_CONSUMER_KEY=                       # [OPCIONAL]
SERPRO_CONSUMER_SECRET=                    # [OPCIONAL]
SERPRO_SCOPE=                              # [OPCIONAL]
SERPRO_ENV=homolog                         # [OPCIONAL] default homolog
SERPRO_TIMEOUT_MS=30000                    # [OPCIONAL] default 30000
SERPRO_CERT_COMPANY_ID=                    # [OPCIONAL] empresa cujo cert A1 assina as chamadas

# Flags de integração — OFF por padrão até validar cada contrato no sandbox.
#
# ⚠ ESTE ARQUIVO NÃO DIZ O QUE ESTÁ LIGADO EM PRODUÇÃO. Ele é o ponto de partida de um ambiente
# novo. Para saber o estado real, LEIA O AMBIENTE (sem imprimir segredo):
#   railway variables --service api-app-contabilidade --kv | grep -E "^INTEGRACAO_|_WORKER_ENABLED="
# Em 2026-08-08 a produção tinha SITFIS, PAGTOWEB e DCTFWEB_LP ligados e PARCELAMENTO desligado —
# o oposto do que os comentários daqui diziam. Foi assim que uma tarefa inteira foi dimensionada
# errado.
INTEGRACAO_SERPRO_SITFIS=1                 # situação fiscal: validada end-to-end em produção
INTEGRACAO_SERPRO_PAGTOWEB=1               # comprovante COMPARRECADACAO72: VALIDADO em produção real
                                           # (2026-07-28) — payload, rateio e ordem multa/juros
INTEGRACAO_SERPRO_PARCELAMENTO=0           # ⚠ só ligar após teste de contrato verde
SERPRO_ENABLE_PGDASD=0                     # [OPCIONAL]
SERPRO_DCTFWEB_LP_PROBE_ENABLED=0          # ⚠ spike read-only; ligar só pra rodar e desligar depois

# Overrides de idServiço/versão (só mexa com fonte oficial na mão)
SERPRO_PAGTOWEB_SYSTEM=PAGTOWEB
SERPRO_PAGTOWEB_SERVICE_COMPROVANTE=COMPARRECADACAO72
SERPRO_SITFIS_SYSTEM=SITFIS
SERPRO_SITFIS_SERVICE_PROTOCOLO=SOLICITARPROTOCOLO91
SERPRO_SITFIS_SERVICE_RELATORIO=RELATORIOSITFIS92
SERPRO_SITFIS_VERSAO=2.0

# --- Workers (todos opt-in; "1" liga) ----------------------------------------
GUIDE_WORKER_ENABLED=0
GUIDE_WORKER_INTERVAL_SECONDS=120          # [OPCIONAL] default 120, mínimo 30
GUIDE_EMAIL_WORKER_ENABLED=0               # envio de guias por e-mail em lote
SERPRO_PGDASD_WORKER_ENABLED=0             # captura DAS + extrato (agenda vem de Rotinas)
SERPRO_DCTFWEB_WORKER_ENABLED=0            # captura INSS/DCTFWeb
SERPRO_PAYMENT_CONFIRMATION_WORKER_ENABLED=0  # cron PAGTOWEB (agenda vem de Rotinas)
APURACAO_BATCH_WORKER_ENABLED=0            # fila de transmissão PGDAS-D
DFE_NOTAS_WORKER_ENABLED=0                 # captura automática NF-e/NFS-e
DFE_NOTAS_WORKER_INTERVAL_MIN=60           # [OPCIONAL] default 60 (NT 2014.002: respeitar rate limit)
DFE_NOTAS_HEARTBEAT_DAYS=7                 # [OPCIONAL] default 7 (limite do NSU é 60 dias)

# --- Notas: NFS-e Padrão Nacional --------------------------------------------
NFSE_CERT_PFX_PATH=                        # [OPCIONAL]
NFSE_CERT_PFX_PASSWORD=                    # [OPCIONAL]
NFSE_BASE_URL=                             # [OPCIONAL]
NFSE_ENV=producao                          # [OPCIONAL] default producao (homolog|homologacao|sandbox → homolog)
NFSE_PATH=/nfse                            # [OPCIONAL]
NFSE_CONSULT_PATH=/nfse/consulta           # [OPCIONAL]
NFSE_DPS_PATH=/dps                         # [OPCIONAL]
NFSE_NFSE_PATH=/nfse                       # [OPCIONAL]
NFSE_COD_MUNICIPIO=                        # [OPCIONAL] cLocEmi — código IBGE, 7 dígitos
NFSE_EVENT_FIELD=pedidoRegistroEventoXmlGZipB64  # [OPCIONAL]
NFSE_EVENT_FORMAT=gzipB64                  # [OPCIONAL] xml|gzipB64

# --- Notas: ADN (Ambiente Nacional de Dados) ---------------------------------
ADN_BASE_URL=                              # [OPCIONAL]
ADN_CERT_PATH=                             # [OPCIONAL]
ADN_KEY_PATH=                              # [OPCIONAL]
ADN_DFE_PATH=                              # [OPCIONAL]
ADN_CNPJ_CONSULTA=                         # [OPCIONAL]
ADN_LOTE_MAX=                              # [OPCIONAL] teto de documentos por lote

# --- Guias: armazenamento ----------------------------------------------------
# LOCAL grava em disco; S3 exige bucket/credenciais. PDFs de guia também vão pro
# Postgres (Guide.pdfBytes), então LOCAL basta em dev.
GUIDE_STORAGE_PROVIDER=LOCAL               # [OPCIONAL] LOCAL|S3 (default LOCAL)
GUIDE_LOCAL_STORAGE_DIR=./storage/guides   # [OPCIONAL]
GUIDE_STORAGE_BUCKET=                      # [OPCIONAL] cai em AWS_S3_BUCKET_NAME
GUIDE_STORAGE_REGION=auto                  # [OPCIONAL] cai em AWS_REGION
GUIDE_STORAGE_ENDPOINT=                    # [OPCIONAL] cai em S3_ENDPOINT (R2/MinIO)
GUIDE_STORAGE_ACCESS_KEY_ID=               # [OPCIONAL] cai em AWS_ACCESS_KEY_ID
GUIDE_STORAGE_SECRET_ACCESS_KEY=           # [OPCIONAL] cai em AWS_SECRET_ACCESS_KEY
GUIDE_STORAGE_FORCE_PATH_STYLE=0           # [OPCIONAL] "1" para MinIO/R2
GUIDE_SCHEDULE_MAX_FILES_PER_COMPANY=15    # [OPCIONAL] default 15, teto 100
GUIDE_COMPLIANCE_COMPETENCIA=              # [OPCIONAL] fixa YYYY-MM nos alertas (homolog). Vazio = mês anterior

# --- Download de notas em lote -----------------------------------------------
NOTAS_DOWNLOAD_STORAGE_PATH=               # [OPCIONAL] onde os ZIPs ficam (validade 7 dias)

# --- Seed do admin (prisma/seed.js) ------------------------------------------
ADMIN_EMAIL=                               # [OPCIONAL] só para `npm run prisma:seed`
ADMIN_PASSWORD=                            # [OPCIONAL]
ADMIN_NAME=                                # [OPCIONAL]
ADMIN_ACCOUNT_TYPE=FIRM                    # [OPCIONAL] FIRM|CLIENT

# --- Rotação da chave-mestra (scripts/rotate-cert-master-key.js) -------------
CERT_SECRET_KEY_OLD=                       # [OPCIONAL] só durante a rotação
CERT_SECRET_KEY_NEW=                       # [OPCIONAL] só durante a rotação
