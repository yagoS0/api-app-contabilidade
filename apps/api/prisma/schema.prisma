model AccountingEntry {
  id                    String    @id @default(uuid())
  portalClientId        String
  circularId            String?
  ruleId                String?
  sourceGuideId         String? // Guide que originou esta provisão (DARFs, INSS, etc.) — null para entries manuais
  eventType             String?
  data                  DateTime
  competencia           String
  historico             String
  tipo                  String    @default("DESPESA") // DESPESA | RECEITA | FOLHA | PROVISAO | BAIXA | OUTRO
  subtipo               String? // SIMPLES | IRRF | ISS | PIS | COFINS | FGTS | null
  origem                String    @default("MANUAL") // MANUAL | OFX | PDF | SERPRO
  loteImportacao        String?
  status                String    @default("RASCUNHO") // RASCUNHO | CONFIRMADO | EXPORTADO
  statusPagamento       String    @default("NA") // NA | ABERTO | PAGO
  openEntryId           String?
  recalculatedAt        DateTime?
  recalculatedFromValor Decimal?  @db.Decimal(18, 2)
  recalculatedToValor   Decimal?  @db.Decimal(18, 2)
  recalculatedNotes     String?
  // Q9: vínculo opcional pra entries que são parcelas de um Parcelamento.
  // numeroParcela=null para a entry de ABERTURA e para entries de RESCISÃO.
  parcelamentoId        String?
  numeroParcela         Int?
  // Papel da linha DENORMALIZADO do `AccountingEntryLine` (que já os tem, Q21). Existem para dar ao
  // banco uma chave que SEPARA os N lançamentos legítimos de uma mesma baixa e REPETE na duplicada
  // — ver migration `20260808120000_add_baixa_tipo_linha`.
  // PRINCIPAL | PARC | JUROS | MULTA | CAIXA | CONTRAPARTIDA | TOTAL (TOTAL = lançamento inteiro,
  // sem decomposição por papel: baixa digitada à mão, importada ou vinda de função).
  tipoLinha             String?
  codigoTributo         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lines                AccountingEntryLine[]
  portalClient         PortalClient            @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  circular             CompanyMonthlyCircular? @relation(fields: [circularId], references: [id], onDelete: SetNull)
  rule                 AccountingEntryRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  sourceGuide          Guide?                  @relation("GuideToEntries", fields: [sourceGuideId], references: [id], onDelete: SetNull)
  openEntry            AccountingEntry?        @relation("BaixaToOpen", fields: [openEntryId], references: [id], onDelete: SetNull)
  baixas               AccountingEntry[]       @relation("BaixaToOpen")
  parcelamento         Parcelamento?           @relation("ParcelamentoParcelas", fields: [parcelamentoId], references: [id], onDelete: SetNull)
  parcelamentoAbertura Parcelamento?           @relation("ParcAberturaEntry")

  @@unique([portalClientId, competencia, eventType, origem])
  // ⚠ MANTIDO DE PROPÓSITO mesmo não mordendo as BAIXAS. Ele vale para as PROVISÕES, que é para
  // quem foi feito: `GuideToProvisionService` grava uma por tributo, cada uma com `eventType`
  // próprio, e faz a idempotência por ele (`where: { uniq_entry_per_guide_event: ... }`). Removê-lo
  // tiraria a única trava contra provisão duplicada por guia e quebraria aquele upsert.
  @@unique([sourceGuideId, eventType], name: "uniq_entry_per_guide_event")
  // ⚠ NÃO DECLARÁVEIS AQUI (o Prisma não modela CHECK nem índice por EXPRESSÃO) — vivem só no SQL
  // da migration `20260808120000_add_baixa_tipo_linha`:
  //   CHECK  chk_baixa_tipo_linha : tipo <> 'BAIXA' OR "tipoLinha" IS NOT NULL
  //   UNIQUE uq_baixa_guia_linha  : ("sourceGuideId","tipoLinha",COALESCE("codigoTributo",''))
  //                                 WHERE tipo='BAIXA' AND "sourceGuideId" IS NOT NULL
  //                                                    AND "tipoLinha" IS NOT NULL
  // NÃO transformar o unique em `@@unique([sourceGuideId, tipoLinha, codigoTributo])`: sem o
  // COALESCE os NULLs voltam a ser distintos e a duplicata passa — é a armadilha que ele fecha.
  @@index([portalClientId])
  @@index([portalClientId, competencia])
  @@index([portalClientId, tipo])
  @@index([portalClientId, status])
  @@index([portalClientId, statusPagamento])
  @@index([portalClientId, subtipo])
  @@index([portalClientId, eventType])
  @@index([circularId])
  @@index([ruleId])
  @@index([sourceGuideId])
  @@index([parcelamentoId])
  @@map("accounting_entries")
}

model CompanyMonthlyCircular {
  id                          String    @id @default(uuid())
  portalClientId              String
  competencia                 String
  receitaBruta                Decimal?  @db.Decimal(18, 2)
  receitaServicos             Decimal   @default(0) @db.Decimal(18, 2)
  receitaVendas               Decimal   @default(0) @db.Decimal(18, 2) // total (= semST + comST)
  receitaVendasSemST          Decimal   @default(0) @db.Decimal(18, 2) // Vendas sem substituição tributária
  receitaVendasComST          Decimal   @default(0) @db.Decimal(18, 2) // Vendas com substituição tributária (ICMS-ST)
  dasTotal                    Decimal?  @db.Decimal(18, 2)
  dasNumeroDocumento          String?
  dasPago                     Boolean?
  dasDataEmissao              DateTime?
  inssTotal                   Decimal?  @db.Decimal(18, 2)
  inssVencimento              DateTime?
  inssPdfFileId               String?
  inssPdfUrl                  String?
  inssStatus                  String?
  pgdasNumeroDeclaracao       String?
  pgdasDeclaracaoFileId       String?
  pgdasDeclaracaoFileUrl      String?
  pgdasReciboFileId           String?
  pgdasReciboFileUrl          String?
  receitaStatus               String?
  dasStatus                   String?
  serproSyncStatus            String?
  serproLastSyncAt            DateTime?
  serproLastError             String?
  metadata                    Json?
  // Módulo Fiscal (Frente B): valor ORIGINAL × ACRÉSCIMO (juros/multa) por tributo.
  // { <tributo>: { principal, juros, multa } } — tributo ∈ {DAS, INSS, PIS, COFINS, IRPJ, CSLL, ISS}.
  // total = principal+juros+multa (derivado). Preenchido no recálculo; editável pelo contador.
  acrescimos                  Json?
  hasAccountingDivergence     Boolean   @default(false)
  accountingDivergenceMessage String?
  // Q12.A: máquina de estados por (empresa, competência) do módulo Notas
  estado                      String    @default("aberto")
  // aberto | em_conferencia | fechado | calculado | revisado | transmitido | confirmado | erro
  lockedAt                    DateTime? // quando virou "fechado"
  lockedByUserId              String?
  reopenedAt                  DateTime?
  reopenedByUserId            String?
  reopenedReason              String?
  fs12Manual                  Decimal?  @db.Decimal(18, 2) // Q12.C: FS12 digitado pelo contador
  fs12Origem                  String? // MANUAL | ESOCIAL (futuro)
  fatorR                      Decimal?  @db.Decimal(6, 4) // 0.28 = 28%
  rb12                        Decimal?  @db.Decimal(18, 2) // soma móvel 12m
  // Q17: fechamento CONTÁBIL do mês (distinto do `estado` da apuração/notas).
  // Setado quando o contador fecha a empresa após lançar tudo; null = aberta.
  fechadoContabilEm           DateTime?
  fechadoContabilPor          String?
  // Q47: contador confirma que a folha/pró-labore do mês foi lançada. Trava o fechamento contábil
  // enquanto não marcada (null/false). Por competência.
  folhaProlaboreOk            Boolean?
  // Checklist de conferência do mês (mesma regra da folha: trava o fechamento até marcar).
  // Cada uma é uma confirmação MANUAL do contador — o sistema não tem como saber se "todas as
  // despesas do mês entraram", só quem lançou sabe.
  despesasOk                  Boolean?
  receitasOk                  Boolean?
  provisoesOk                 Boolean?
  pagamentosOk                Boolean?
  /// O mês NÃO TEVE FATURAMENTO. Afirma só isso: folha, despesas e parcelas seguem normais e
  /// continuam a ser lançadas e conferidas. Tri-estado como o checklist acima — `null` significa
  /// "ninguém disse nada", que é diferente de "disseram que teve".
  ///
  /// É uma afirmação FISCAL, não uma preferência de tela: por isso quem e quando ficam gravados.
  /// O sistema RECUSA marcar quando existe nota EMIT autorizada na competência — vira confirmação
  /// do que ele já enxerga, nunca uma declaração cega contra a evidência.
  semFaturamento              Boolean?
  semFaturamentoEm            DateTime?
  semFaturamentoPor           String?
  /// COMO a afirmação foi verificada contra o ADN no momento em que foi feita:
  /// `"ok"` (conferimos e bateu) · `"nao_conferivel"` (município fora do ADN, sem certificado)
  /// · `"sem_conferencia"` (nunca conferida).
  ///
  /// Existe porque "faturamento zero" e "não conseguimos ver o faturamento" se parecem no banco e
  /// significam coisas opostas. Município fora do ADN, A1 vencido ou cursor NSU travado devolvem
  /// zero sem que ninguém tenha provado ausência de receita — bloquear aí inutilizaria o campo
  /// justamente nessas empresas, então o sistema aceita e REGISTRA que aceitou sem conferir.
  /// Conferência `"divergente"` (o ADN tem nota que nós não temos) é o único caso que RECUSA.
  semFaturamentoConferencia   String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  portalClient      PortalClient      @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  accountingEntries AccountingEntry[]

  @@unique([portalClientId, competencia])
  @@index([portalClientId, competencia])
  @@index([portalClientId, estado])
  @@map("company_monthly_circulars")
}

model AccountingEntryRule {
  id                  String   @id @default(uuid())
  portalClientId      String?
  scope               String   @default("GLOBAL") // GLOBAL | COMPANY
  eventType           String
  descriptionTemplate String
  debitAccountCode    String
  creditAccountCode   String
  amountSource        String
  entryDateStrategy   String   @default("LAST_DAY_OF_MONTH")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  portalClient      PortalClient?     @relation(fields: [portalClientId], references: [id], onDelete: SetNull)
  accountingEntries AccountingEntry[]

  @@index([portalClientId, eventType])
  @@index([scope, eventType, isActive])
  @@index([eventType, isActive])
  @@map("accounting_entry_rules")
}

model AccountingEntryLine {
  id            String  @id @default(uuid())
  entryId       String
  conta         String
  tipo          String // D | C
  valor         Decimal @db.Decimal(18, 2)
  ordem         Int     @default(0)
  historico     String? // Histórico opcional por linha (ex: pró-labore tem histórico distinto por D/C)
  // Q21: papel da linha em lançamentos de parcelamento + tributo (aprendizado por tributo)
  tipoLinha     String? // PARC_DAS | JUROS | MULTA | TOTAL
  codigoTributo String?

  entry AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
