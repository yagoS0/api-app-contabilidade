generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  login           String           @unique
  passwordHash    String
  phone           String?
  cpf             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  companies       Company[]
  invoices        Invoice[]
  serviceInvoices ServiceInvoice[]
}

model Company {
  id                       String            @id @default(uuid())
  clientId                 String
  razaoSocial              String
  cnpj                     String            @unique
  nomeFantasia             String?
  regimeTributario         String?
  simplesAnexo             String?
  simplesDataOpcao         DateTime?
  cnaePrincipal            String?
  cnaesSecundarios         String[]          @default([])
  enderecoJson             Json?
  atividades               String[]
  porte                    String?
  tipoTributario           String?
  anexoSimples             String?
  endereco                 String?
  email                    String?
  telefone                 String?
  capitalSocial            Decimal?          @db.Decimal(18, 2)
  dataAbertura             DateTime?
  quantidadeSocios         Int?
  inscricaoMunicipal       String?
  /// O código de tributação nacional (`cTribNac`) que a DPS LEVA — um só, porque a DPS tem um só.
  ///
  /// ⚠ NÃO É MAIS O CADASTRO. O cadastro dos serviços que a empresa pode prestar é
  /// `codigosServicoNacional` (a lista, logo abaixo). Esta coluna continua existindo porque é ela
  /// que `NfseService.buildMissingFields` exige e que `buildDpsXml` escreve no XML — e porque
  /// remover coluna é migration destrutiva, decisão do dono.
  ///
  /// Regra de coerência (em `application/company/companyProfile.js`): quando a lista tem
  /// EXATAMENTE um código, esta coluna é ele — não há o que escolher. Com mais de um, ela tem de
  /// ser um dos cadastrados, senão o cadastro é RECUSADO com nome próprio. Nunca se elege um
  /// "primeiro da lista" por conta própria: o serviço declarado é dado fiscal.
  codigoServicoNacional    String?
  /// ⚠ OS CÓDIGOS DE SERVIÇO QUE A EMPRESA PODE USAR — decisão do dono, 16/08/2026:
  /// *"ao cadastrar podemos ter mais de um código, a empresa pode usar mais de uma atividade e na
  /// hora da emissão ela deve escolher"*.
  ///
  /// Cada item tem 6 dígitos (`item(2) + subitem(2) + desdobro nacional(2)`) e vem da lista OFICIAL
  /// versionada em `docs/lista-servico-nacional/` (Anexo B do portal `gov.br/nfse`), com hash.
  /// Nada é derivado do CNAE nem sugerido — a mesma regra do seletor de município.
  ///
  /// ⚠ ADITIVA E VAZIA: a coluna nasce `{}` e o dado antigo NÃO some. Medido no schema, o campo
  /// singular acima era a única forma de guardar isto, e nenhuma migração de conteúdo é necessária
  /// (ver a migration `20260816120000_add_codigos_servico_nacional`, que faz o backfill a partir
  /// dele mesmo quando há valor).
  codigosServicoNacional   String[]          @default([])
  codigoServicoMunicipal   String?
  rpsSerie                 String?
  rpsNumero                String?
  /// Código IBGE (7 dígitos) do município EMISSOR da DPS — o `cLocEmi` da NFS-e Nacional.
  ///
  /// ⚠ CRIADO VAZIO, E DE PROPÓSITO. `buildDpsId`/`buildDpsXml` liam `codigoMunicipioIbge` e
  /// `codigoMunicipio` — **nenhum dos dois existia neste model** —, caíam no env
  /// `NFSE_COD_MUNICIPIO` (não definido no Railway) e emitiam `cLocEmi = "0000000"` sozinhos.
  /// Município zerado derruba a emissão inteira, e ainda por cima em silêncio.
  ///
  /// ⚠ O município da empresa HOJE vive em `PortalClient.municipio`/`uf`, como **TEXTO** (medido:
  /// 33 de 33 preenchidos, 32 no Rio de Janeiro). O **código IBGE não existe em lugar nenhum** do
  /// projeto, e o de-para nome→IBGE exige a tabela de municípios do IBGE, que não temos. Preencher
  /// por semelhança de nome erraria em homônimo ("Bom Jesus" existe em 8 estados) e o erro só
  /// apareceria como nota emitida no município errado. Enquanto o campo estiver nulo a emissão é
  /// **RECUSADA com motivo** — nunca completada por palpite.
  codigoMunicipioIbge      String?
  /// ── CARGA TRIBUTÁRIA APROXIMADA (Lei 12.741/2012) — só da empresa NÃO OPTANTE ────────────
  ///
  /// Pedido do dono (18/08/2026): *"as alíquotas efetivas do presumido não precisam ser calculadas
  /// a não ser o ISS que varia de município, mas deve ser configurado do lado do contador, no
  /// portal do contador."*
  ///
  /// São os três percentuais que a DPS leva em `valores/trib/totTrib/pTotTrib` quando
  /// `opSimpNac != 3`. O optante do Simples NÃO usa estes campos: ele declara `pTotTribSN`, que é
  /// a alíquota efetiva da COMPETÊNCIA e sai do extrato do PGDAS-D — muda todo mês, por isso é
  /// informada na emissão e não cadastrada aqui.
  ///
  /// ⚠ DIGITADOS PELO CONTADOR, NUNCA CALCULADOS. Não há de-para CNAE→presunção neste
  /// repositório, e o número vai IMPRESSO ao tomador: é afirmação, não preenchimento técnico.
  ///
  /// ⚠ NULL ≠ 0.00, e a distinção é o motivo de existirem. A NFS-e real versionada
  /// (`docs/leiaute-nfse/nfse-nacional-substituicao.xml`, `opSimpNac=1`) declara
  /// `pTotTribEst 0.00` e `pTotTribMun 0.00` — zero DECLARADO é legítimo. Então zero não pode ser
  /// o que o sistema escreve por omissão: NULL = não configurado (a emissão recusa com
  /// `MISSING_TOT_TRIB_NAO_SIMPLES`, nomeando quais faltam), 0.00 = o contador afirmou zero.
  ///
  /// ⚠ `pTotTribMun` NÃO é a alíquota de ISS. Na mesma amostra o ISS aplicado é
  /// `pAliqAplic = 5.00` e o `pTotTribMun` é `0.00` — mesmo documento, mesma nota, números
  /// diferentes. Um é o que o município cobra; o outro é a parcela municipal da carga aproximada.
  ///
  /// ⚠ Migration `20260818210000_add_carga_tributaria_nao_simples` — APLICAR ANTES de este código
  /// subir: a `Company` é lida sem `select` em várias rotas e por `legacyCompanySelect` com
  /// `select` explícito. Sem a coluna no banco, P2022 derruba a carteira inteira.
  pTotTribFed              Decimal?          @db.Decimal(5, 2)
  pTotTribEst              Decimal?          @db.Decimal(5, 2)
  pTotTribMun              Decimal?          @db.Decimal(5, 2)
  /// ── BENEFÍCIO MUNICIPAL DO ISSQN (grupo `BM` da DPS) — pedido do dono, 20/08/2026 ─────────
  ///
  /// > *"do lado do contador ainda, o seletor de benefício, caso o cliente tenha algum benefício
  /// > fiscal."*
  ///
  /// Fonte: XSD oficial 1.01 (`docs/leiaute-nfse/documentacao-tecnica/esquemas-xsd/Schemas/1.01/
  /// tiposComplexos_v1.01.xsd:1931`, `TCBeneficioMunicipal`) + ANEXO_I, aba `RN DPS_NFS-e`.
  ///
  /// ⚠⚠ **O XML AINDA NÃO LEVA ESTE GRUPO.** `buildDpsXml` monta `<tribMun>` com dois filhos
  /// (`tribISSQN` cravado em 1 e `tpRetISSQN`) dos SETE que o `TCTribMunicipal` admite. Estas
  /// colunas guardam a configuração; a nota continua saindo com o ISS CHEIO, e a tela DIZ isso —
  /// tanto no cadastro quanto no assistente de emissão. Configurar um benefício que o contador
  /// acredita estar sendo aplicado é o defeito que este comentário existe para impedir.
  ///
  /// ⚠ NADA AQUI É DEDUZIDO. O número do benefício é do MUNICÍPIO — cada prefeitura concede o seu,
  /// e o identificador é gerado pelo Sistema Nacional quando o município cadastra o benefício.
  /// Não há lista neste repositório, não se deriva do CNAE, não se sugere valor. Valida-se a
  /// FORMA (`TSNumBeneficioMunicipal`: `[0-9]{14}`) e nunca o conteúdo — quem confere o conteúdo é
  /// o fisco (`E0541`: *"Não existe o código de identificação do benefício municipal informado na
  /// DPS para o municipío de incidência do ISSQN"*).
  ///
  /// Regra de formação (documentação do próprio tipo): 7 dígitos do município (IBGE) + 2 do tipo
  /// de parametrização (01 legislação · 02 regimes especiais · 03 retenções · 04 outros
  /// benefícios) + 5 sequenciais.
  beneficioMunicipalNumero String?
  /// QUAL redução o benefício aplica — e por que isto é um campo e não uma dedução.
  ///
  /// No XSD, `vRedBCBM` e `pRedBCBM` estão num `xs:choice` (excludentes), e **os dois são
  /// `minOccurs="0"`**: um benefício sem NENHUMA redução de base é válido no schema. As RN
  /// confirmam que a escolha depende do TIPO com que o município cadastrou o benefício —
  /// `E0565`: *"Somente é permitido informar vRedBCBM quando o (…) nBM for um benefício do tipo
  /// Redução de Base de Cálculo por Valor Monetário"*; `E0577`, o mesmo para o percentual. E
  /// `E0612` cita benefícios dos tipos "Isenção" e "Alíquota Diferenciada", que não reduzem base.
  ///
  /// ⚠ Ou seja: **o sistema não tem como saber qual dos dois campos vale** — só o contador sabe,
  /// pela concessão do município. Por isso o tipo é DECLARADO, não inferido de qual campo foi
  /// preenchido: "ainda não preenchi" e "este benefício não reduz base" são estados diferentes.
  ///
  /// Valores: `SEM_REDUCAO` · `VALOR` · `PERCENTUAL`. NULL = não declarado.
  beneficioMunicipalTipoReducao String?
  /// `pRedBCBM` — o percentual de redução da base de cálculo (0 a 100, duas casas).
  ///
  /// ⚠ SÓ O PERCENTUAL É CADASTRÁVEL, e a ausência do par monetário é decisão, não esquecimento:
  /// `vRedBCBM` é *"valor monetário informado pelo emitente para redução da BC"* — ele é da NOTA
  /// (depende da base daquela nota), não da empresa. Um valor fixo repetido em toda nota emitida
  /// seria uma afirmação que ninguém fez, e reduziria imposto. O tipo `VALOR` fica registrado; o
  /// valor entra por nota quando o envio ao XML existir.
  beneficioMunicipalPRedBC Decimal?          @db.Decimal(5, 2)
  optanteSimples           Boolean?          @default(false)
  regimeEspecialTributacao String?
  // ── Ficha de cadastro do escritório ──────────────────────────────────────────
  /// Quem abriu a empresa (contato/parceiro que trouxe o cliente). Ex.: "JEFFERSON".
  abriuCom                 String?
  /// Registro na junta: número + tipo (ex.: 33.6.0068899-0 / "JUNTA COMERCIAL").
  numeroRegistro           String?
  tipoRegistro             String?
  /// Inscrições com a data de cada uma (a coluna inscricaoMunicipal já existia acima).
  inscricaoMunicipalData   DateTime?
  inscricaoEstadual        String?
  inscricaoEstadualData    DateTime?
  /// Natureza jurídica (ex.: "230-5" = EIRELI). Vem da BrasilAPI no cadastro por CNPJ.
  naturezaJuridica         String?
  /// Nº do diário contábil.
  diarioNumero             String?
  /// Empresa com desoneração da folha ("C/DESONE" na ficha).
  desoneracao              Boolean?          @default(false)
  /// Última alteração contratual (ex.: "2" em 14/04/2026).
  alteracaoNumero          String?
  alteracaoData            DateTime?
  // Certificado A1 por empresa (PFX) para integrações (ADN/NFSe/etc.)
  certStorageKey           String?
  certPfxBytes             Bytes?
  certPasswordEnc          String?
  certExpiresAt            DateTime?
  certUploadedAt           DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  client                   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  partners                 Partner[]
  regimeHistorico          RegimeHistorico[]
  invoices                 Invoice[]
  serviceInvoices          ServiceInvoice[]
  guides                   Guide[]
  tomadoresEmitidos        TomadorEmitido[]
  lotesEmissaoNfse         LoteEmissaoNfse[]

  @@index([regimeTributario])
  @@index([cnaePrincipal])
}

/// Sócios. O model existia mas estava morto (nenhuma rota /firm lia ou gravava). Agora é a
/// fonte do bloco "RELAÇÃO DOS SÓCIOS" da ficha: nome, %, CPF (documento), RG, nascimento
/// e a data de saída — sócio que saiu continua no histórico, só marcado com dataSaida.
model Partner {
  id             String    @id @default(uuid())
  companyId      String
  name           String
  phone          String?
  email          String?
  participacao   Decimal?  @db.Decimal(5, 2)
  documento      String?
  representante  Boolean   @default(false)
  dataNascimento DateTime?
  rg             String?
  /// Órgão emissor do RG (ex.: "DIC/RJ").
  rgOrgaoEmissor String?
  /// Quando saiu da sociedade. Nulo = sócio atual.
  dataSaida      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Histórico de regime tributário com vigência — o bloco "TIPO:" da ficha
/// (ex.: SIMPLES 20/08/2018→31/12/2019, LUCRO PRESUMIDO 01/01/2020→31/12/2020).
///
/// ⚠ INFORMATIVO por ora, por decisão do dono: a apuração e a captura continuam usando
/// `Company.regimeTributario` (o regime atual). Nada aqui alimenta cálculo fiscal. Fazer o
/// regime ser resolvido por competência é um bloco de trabalho à parte.
model RegimeHistorico {
  id             String    @id @default(uuid())
  companyId      String
  /// SIMPLES | LUCRO_PRESUMIDO | LUCRO_REAL | MEI
  regime         String
  vigenciaInicio DateTime
  /// Nulo = vigente ("A PARTIR DE ...").
  vigenciaFim    DateTime?
  /// Impostos daquele período, como o escritório escreve: ["DAS"] ou ["ISS","PIS","COFINS","CSLL","IRPJ"].
  impostos       String[]  @default([])
  desoneracao    Boolean   @default(false)
  observacao     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, vigenciaInicio])
  @@map("regime_historico")
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  status       String   @default("pending")
  accountType  String   @default("CLIENT") // CLIENT | FIRM
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyClientUsers CompanyClientUser[]
  companyFirmAccess  CompanyFirmAccess[]
  clientSessions     ClientSession[]
  /// Contraparte de `contatos_whatsapp.userId`. NENHUMA coluna nova em `"User"` — a FK mora lá.
  contatosWhatsapp   ContatoWhatsapp[]
  /// Contraparte de `password_reset_tokens.userId`. NENHUMA coluna nova em `"User"` — a FK mora lá.
  passwordResetTokens PasswordResetToken[]
  /// Contraparte de `senhas_portal_trocas.userId`. NENHUMA coluna nova em `"User"` — a FK mora lá.
  /// ⚠ E nenhuma delas guarda a senha: `passwordHash` continua sendo o ÚNICO lugar onde a senha
  /// existe, em bcrypt, sem volta.
  senhasPortalTrocas  PortalPasswordChange[]
}

// Pedido de redefinição de senha ("esqueci minha senha").
//
// ⚠ MESMA FORMA DE `ClientSession`, e de propósito: o valor em claro NUNCA encosta no banco.
// `tokenHash` é o SHA-256 do token opaco (32 bytes de `crypto.randomBytes`); o claro existe só
// dentro da requisição que monta o e-mail. Quem vaza o dump do banco não ganha nenhum token.
//
// ⚠ `usedAt` é a coluna que `ClientSession` NÃO tem e que este modelo EXIGE — é ela que faz o
// token ser de USO ÚNICO. Foi exatamente a falta dela que impediu o reuso do token de onboarding
// (ver "Fase 2" no CLAUDE.md da raiz: *"o único token opaco do projeto não tem campo de consumo,
// então uso único exige modelo novo"*).
//
// ⚠ NADA AQUI DISTINGUE "expirado" de "já usado" PARA QUEM PERGUNTA. As duas colunas existem para
// o servidor decidir e para auditoria; a resposta HTTP é a MESMA recusa genérica nos dois casos.
// Dizer "este token já foi usado" conta ao atacante que ele existiu.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  /// SHA-256 hex do token opaco. `@unique` = a busca é feita pelo hash, nunca varrendo a tabela.
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Instante do consumo. NULO = ainda não usado. Preenchido = queimado, para sempre.
  usedAt    DateTime?
  /// IP de quem PEDIU (não de quem usou). Só auditoria; nunca entra em decisão de autorização.
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Sessão revogável do portal do cliente (app mobile). O refresh é opaco (aleatório),
// guardado só como hash; rotaciona a cada /auth/refresh. Logout revoga a sessão do
// dispositivo; troca de senha revoga TODAS as sessões do usuário. FIRM segue stateless.
/// Histórico de trocas de senha do usuário do portal — quem trocou, quando, e por qual caminho.
///
/// ⚠⚠ NADA DA SENHA ENTRA AQUI: nem o claro, nem o hash, nem o tamanho, nem um prefixo. A senha do
/// portal é `bcrypt` em `User.passwordHash` e NÃO TEM VOLTA. Não existe "mostrar a senha atual" em
/// lugar nenhum deste sistema, e nenhuma coluna futura pode passar a permitir isso — o cliente
/// EMITE NFS-e em nome da própria empresa com essa credencial, e uma cópia do banco viraria a senha
/// de todos eles.
///
/// ⚠ POR QUE UMA TABELA, e não duas colunas em `PortalClient` no molde de
/// `emissaoClienteLiberadaEm`/`Por`: aquelas são POR EMPRESA e esta senha é DE UM USUÁRIO. Hoje os
/// dois recortes coincidem (medido em 19/08/2026: 33 empresas, 33 usuários `OWNER` ativos, um por
/// empresa), mas a coincidência não é garantida por nada no schema — `CompanyClientUser` é
/// `@@unique([companyId, userId])`, o que permite N usuários por empresa. Com duas colunas, o
/// segundo usuário faria a linha responder "a senha de quem?" com o último que trocou.
///
/// ⚠ E é a tabela que faz o estado ser HONESTO NOS TRÊS CAMINHOS. São três, e é uma senha só:
///   ESCRITORIO          → `POST /firm/companies/:id/acesso-portal/:userId/senha` (o contador)
///   CLIENTE_PERFIL      → `POST /auth/change-password` (o cliente, sabendo a senha atual)
///   CLIENTE_RECUPERACAO → `POST /auth/reset-password` (o cliente, pelo link do e-mail)
/// Os dois últimos não passam por empresa nenhuma. Sem esta tabela, a tela do contador diria
/// "trocada por mim em tal dia" para uma senha que o cliente já trocou depois — o estado errado
/// justamente no caso em que ele importa.
///
/// Append-only, como `company_credential_acessos`, `estornos_baixa` e `atos_parcelamento`. Nada
/// aqui é editado nem apagado; `autorNome`/`autorEmail` são CÓPIA IMUTÁVEL do instante do ato,
/// porque o contador que agiu pode ser desligado e apagado depois, e um log que aponta para um id
/// que não existe mais não conta história nenhuma.
model PortalPasswordChange {
  id String @id @default(uuid())

  /// De QUEM é a senha trocada.
  userId String

  /// Em qual empresa o contador estava. NULO nos caminhos do cliente — e nulo aqui significa "não
  /// houve empresa", nunca "não sabemos".
  portalClientId String?

  /// ESCRITORIO | CLIENTE_PERFIL | CLIENTE_RECUPERACAO (CHECK no banco).
  origem String

  /// Quem AGIU: o contador, ou o próprio dono da senha nos dois caminhos do cliente.
  autorUserId String?
  /// Cópia imutável — ver o comentário acima.
  autorNome   String?
  autorEmail  String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SetNull: o histórico sobrevive ao encerramento da empresa — é depois que um cliente sai que
  /// se pergunta quem tinha o acesso dele.
  portalClient PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([portalClientId, createdAt])
  @@map("senhas_portal_trocas")
}

model ClientSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceLabel      String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  clientId      String?
  chave         String
  numero        String?
  serie         String?
  dhEmi         DateTime?
  emitCnpj      String?
  emitNome      String?
  destDoc       String?
  destNome      String?
  cfopPrincipal String?
  valorTotal    Decimal?      @db.Decimal(18, 2)
  valorProdutos Decimal?      @db.Decimal(18, 2)
  valorServicos Decimal?      @db.Decimal(18, 2)
  valorImpostos Decimal?      @db.Decimal(18, 2)
  valorIcms     Decimal?      @db.Decimal(18, 2)
  valorPis      Decimal?      @db.Decimal(18, 2)
  valorCofins   Decimal?      @db.Decimal(18, 2)
  valorIss      Decimal?      @db.Decimal(18, 2)
  status        String        @default("imported")
  fileKey       String?
  fileUrl       String?
  fileType      String        @default("xml")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@unique([companyId, chave])
  @@index([companyId])
  @@index([clientId])
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  codigo         String?
  descricao      String?
  ncm            String?
  cfop           String?
  unidade        String?
  quantidade     Decimal? @db.Decimal(14, 4)
  valorUnitario  Decimal? @db.Decimal(18, 4)
  valorTotal     Decimal? @db.Decimal(18, 2)
  cstIcms        String?
  csosn          String?
  cstPis         String?
  cstCofins      String?
  aliquotaIcms   Decimal? @db.Decimal(6, 3)
  aliquotaPis    Decimal? @db.Decimal(6, 3)
  aliquotaCofins Decimal? @db.Decimal(6, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model ServiceInvoice {
  id                String    @id @default(uuid())
  companyId         String
  clientId          String?
  tomadorDoc        String
  tomadorNome       String
  valorServicos     Decimal   @db.Decimal(18, 2)
  aliquota          Decimal?  @db.Decimal(6, 3)
  issRetido         Boolean   @default(false)
  competencia       DateTime?
  idDps             String?
  chaveAcesso       String?
  numeroNfse        String?
  codigoVerificacao String?
  rpsNumero         String?
  rpsSerie          String?
  /// pending | issued | rejected | falha_envio
  ///
  /// ⚠ `rejected` passou a significar SÓ **recusa fiscal do sistema nacional**. Erro nosso e
  /// queda de rede saem como `falha_envio` — antes os três eram o mesmo `rejected`, sem nada que
  /// os separasse. Vocabulário e regra em `application/nfse/desfechoEmissao.js`.
  status            String    @default("pending")
  xml               String?
  pdfUrl            String?
  // ── Desfecho da tentativa de emissão ────────────────────────────────────────────────────────
  // Antes, o motivo da falha existia SÓ no `log.error` (`NfseService.js:1148-1165`), que envelhece
  // e some: a tela dizia "rejeitada" e ninguém sabia se corrigia a nota ou tentava de novo.
  /// NOSSA | TRANSPORTE | RECEITA — em qual camada a emissão parou.
  /// ⚠ `TRANSPORTE` é a que justifica o campo existir: desfecho DESCONHECIDO (o pedido saiu, a
  /// resposta não voltou). Como **não existe inutilização na NFS-e**, número pulado é buraco
  /// permanente e reusar às cegas arrisca E0014 — então o número fica RETIDO até alguém consultar
  /// o Id da DPS. Nas outras duas camadas o número volta a valer.
  falhaCamada       String?
  /// Código do erro. `E####` quando a recusa é da Receita (E0014, E0718…); o código nomeado
  /// interno quando a camada é NOSSA; o erro de rede (ETIMEDOUT, HTTP_502…) quando é TRANSPORTE.
  falhaCodigo       String?
  falhaMensagem     String?
  /// O que fazer a respeito — é o que separa "deu erro" de "faça isto".
  falhaCorrecao     String?
  falhaEm           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// ⚠ O QUE IDENTIFICA A NOTA, e por que são ESTAS três colunas.
  ///
  /// **E0014** rejeita quando já existe o conjunto *Série + Número + Código do Município Emissor
  /// + CNPJ/CPF*. Aqui `companyId` responde pelos dois últimos: `Company.cnpj` é `@unique` (uma
  /// empresa, um CNPJ) e o município emissor é `Company.codigoMunicipioIbge` (uma empresa, um
  /// `cLocEmi`). Logo `(companyId, rpsSerie, rpsNumero)` é a MESMA tupla do E0014 — e nunca mais
  /// frouxa que ela, mesmo se a empresa mudar de município.
  ///
  /// ⚠ **Não é `idDps`**, embora ele codifique exatamente essa tupla. `idDps` é uma STRING
  /// DERIVADA, e é escrita também pelo caminho de CAPTURA (`upsertFromProvider`), a partir do que
  /// o provedor devolve. Um índice ali obrigaria dado de terceiro a obedecer à nossa regra de
  /// derivação. A tupla é o fato; `idDps` é só a codificação dele.
  ///
  /// ⚠ Linhas com `rpsSerie`/`rpsNumero` NULOS (as capturadas) não colidem entre si: no Postgres
  /// NULL nunca é igual a NULL num índice único. A restrição alcança exatamente a numeração que
  /// nós emitimos, que é a que precisa dela.
  @@unique([companyId, rpsSerie, rpsNumero])
  @@index([companyId])
  @@index([clientId])
  @@index([idDps])
  @@index([chaveAcesso])
  @@index([numeroNfse])
}

/// MEMÓRIA DO QUE JÁ FOI EMITIDO — o tomador para quem esta empresa já emitiu uma nota.
///
/// > Pedido do dono (19/08/2026): *"ao emitir a nota para um tomador vamos salvar as informações;
/// > na hora de emitir o cliente pode escolher o tomador ao qual ele já emitiu."*
///
/// ⚠⚠ **NÃO É CADASTRO, E NÃO É FONTE DE VERDADE SOBRE NINGUÉM.** É o registro do que a emissão
/// TEVE. Não existe tela de gestão, não existe rota de edição e não existe exclusão — e a ausência
/// das três é decisão, não pendência. Um "cadastro de clientes" de verdade abre perguntas que
/// ninguém fez (quem edita, quem apaga, o que acontece com as notas já emitidas quando o cadastro
/// muda) e cria uma segunda autoridade sobre o tomador ao lado do que foi efetivamente declarado
/// na DPS. Aqui a autoridade é a nota que saiu.
///
/// ⚠ **POR QUE ISTO NÃO EXISTIA E PRECISOU NASCER.** Medido em 19/08/2026: não havia nenhum model
/// de tomador/cliente/destinatário neste schema, e `ServiceInvoice` guarda do tomador **só
/// `tomadorDoc` e `tomadorNome`** (linhas 347-348) — sem e-mail e sem endereço. É por isso que o
/// reaproveitamento de nota não consegue trazer o endereço, e está escrito assim em
/// `apps/portal-cliente-web/src/features/emitir/lib/reaproveitarNota.js` ("a nota capturada não
/// traz e-mail do tomador em campo nenhum"). Guardar o endereço na `ServiceInvoice` responderia
/// "qual endereço ESTA nota levou"; esta tabela responde "qual é o endereço mais recente que este
/// tomador teve", que é a pergunta do dono. As duas perguntas são diferentes e as duas continuam
/// respondíveis.
///
/// ⚠ **ESCOPADA POR EMPRESA, e a chave é o DOCUMENTO dentro desse escopo.** Duas empresas do mesmo
/// escritório podem emitir para o mesmo CNPJ com endereços diferentes (filial, endereço de
/// cobrança), e nenhuma delas tem autoridade sobre o registro da outra. Sem o `companyId` na
/// chave, a emissão de uma empresa reescreveria a memória da outra — num portal multi-empresa isso
/// é o dado de um cliente vazando para outro.
///
/// ⚠ **NADA AQUI É COMPLETADO POR CONSULTA NEM DEDUZIDO.** Só entra o que a emissão de fato levou.
/// Nota que saiu sem e-mail produz registro sem e-mail; nota que saiu sem endereço completo produz
/// registro sem endereço (o validador só entrega o bloco quando os cinco campos estão lá — ver
/// `hasEnderecoTomador` em `application/validators/nfsePayload.js`). Um campo preenchido "para não
/// ficar vazio" seria uma afirmação sobre um terceiro que ninguém fez.
model TomadorEmitido {
  id        String  @id @default(uuid())
  companyId String
  /// CPF (11) ou CNPJ (14), **só dígitos** — é a forma que `onlyDigits` já entrega em
  /// `validateNfsePayload`. Guardar com máscara faria a busca pelo documento falhar em silêncio
  /// contra o que a emissão seguinte compara.
  documento String
  nome      String
  /// Nulo quando a nota saiu sem e-mail. `null` diz "a emissão não teve"; `""` diria "tem e é
  /// vazio" — a mesma disciplina do `?? ""` que o projeto usa nos campos de tela.
  email     String?

  // ── ENDEREÇO ────────────────────────────────────────────────────────────────────────────────
  //
  // ⚠ OS SEIS CAMPOS SÃO EXATAMENTE OS DA DPS, com os nomes do domínio (`cMun`, `xLgr`…) e não com
  // nomes "amigáveis": é o vocabulário do XML, do validador e do `buildDpsXml`. Traduzir aqui
  // criaria um de-para a mais para alguém errar.
  //
  // ⚠ TODOS NULLABLE E TUDO-OU-NADA NA PRÁTICA: o validador entrega `endereco: undefined` quando
  // qualquer um dos CINCO exigidos falta (`cMun`, `CEP`, `xLgr`, `nro`, `xBairro`), então ou os
  // cinco chegam juntos ou nenhum chega. Não há constraint disso no banco de propósito — o dado
  // nasce de uma emissão que JÁ foi autorizada, e uma constraint que recusasse gravação aqui
  // derrubaria a memória de uma nota que existe no sistema nacional.
  cMun    String?
  cep     String?
  xLgr    String?
  nro     String?
  /// O único opcional dos seis, aqui e na DPS.
  xCpl    String?
  xBairro String?

  // ── AS TRÊS DATAS, e por que são três perguntas diferentes ──────────────────────────────────
  //
  // ⚠ NÃO HÁ `updatedAt @updatedAt` AQUI, e a ausência é deliberada: ele sobe a cada `update`,
  // inclusive quando a emissão repetiu exatamente os mesmos dados. Ele responderia "quando o
  // registro foi tocado", e a pergunta do dono é "quando o dado MUDOU". Ter os dois lado a lado
  // convidaria a ler um pelo outro.
  /// Quando esta empresa emitiu para este documento pela PRIMEIRA vez.
  createdAt          DateTime  @default(now())
  /// Toda emissão bem-sucedida sobe esta data, mudando o dado ou não. É por ela que a tela ordena
  /// "para quem emiti mais recentemente".
  ultimaEmissaoEm    DateTime  @default(now())
  /// ⚠ SÓ SOBE QUANDO ALGUM CAMPO DE FATO MUDOU — é o "registra quando" do pedido. Nulo = o
  /// registro nunca mudou desde que nasceu. Endereço de cliente muda, e a nota seguinte tem de
  /// sair no endereço novo: é esta data que prova quando isso aconteceu.
  dadosAtualizadosEm DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// ⚠ A CHAVE. `documento` sozinho seria global e vazaria o dado de uma empresa para outra;
  /// `companyId` sozinho não identifica ninguém. Emitiu de novo para o mesmo documento na mesma
  /// empresa ⇒ é o MESMO registro, e ele se atualiza.
  ///
  /// ⚠ Não há `@@index([companyId])` à parte: `companyId` é a coluna LÍDER deste índice único, que
  /// o Postgres já usa para varrer "os tomadores desta empresa". Um índice a mais custaria escrita
  /// em toda emissão sem responder a nenhuma pergunta nova.
  @@unique([companyId, documento])
  @@map("tomadores_emitidos")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// EMISSÃO DE NFS-e EM LOTE — o TRABALHO PERSISTIDO, e por que ele não podia ser síncrono
// ═══════════════════════════════════════════════════════════════════════════════════════════════
//
// ⚠⚠ CADA LINHA DESTE LOTE VIRA UMA NOTA FISCAL IRREVERSÍVEL. Não é um relatório: é uma série de
// atos fiscais, cada um chamando o sistema nacional com certificado, assinatura e rede.
//
// ─── POR QUE PERSISTIDO, E NÃO SÍNCRONO (medido em 20/08/2026) ─────────────────────────────────
//
//   • piso local por nota: ~48 ms (janela de numeração 29 + assinatura 5,7 + gzip 0,1 + mTLS 13);
//   • TETO por nota: **15 000 ms** — o `timeout` do axios em `NfseService.js`. 313× o piso;
//   • `buildAxiosClient` cria um `https.Agent` NOVO por chamada ⇒ handshake mTLS completo por nota,
//     sem keep-alive entre as notas do lote;
//   • `server.requestTimeout` do Node 20 é **300 000 ms** e o `server.js` NÃO o sobrescreve.
//
// Logo: um lote de 50 no teto levaria 750 s e **o runtime mata a requisição aos 300 s**, no meio,
// com notas fiscais reais já emitidas e a resposta descartada. Não é "pode cair" — é determinístico
// para qualquer lote cuja média passe de 6 s/nota.
//
// ⚠ E A RAZÃO MAIS FORTE NEM DEPENDE DISSO. As `ServiceInvoice` já são duráveis (a reserva de
// numeração grava ANTES do envio), então as NOTAS não se perdem. O que não sobrevive a um POST é o
// **LOTE**: quais linhas são dele, qual virou qual nota, **qual é a linha indeterminada**, quais
// números foram queimados, e a identidade que faz a segunda subida da mesma planilha ser
// RECONHECIDA em vez de reprocessada. Idempotência é afirmação sobre estado que dura mais que uma
// requisição — não existe versão síncrona dela.

model LoteEmissaoNfse {
  id String @id @default(uuid())

  /// ⚠ O id da `Company` LEGADA — o mesmo que `ServiceInvoice.companyId` e `TomadorEmitido.companyId`.
  /// NÃO é o `PortalClient.id` que chega no path do portal do cliente: são entidades diferentes e o
  /// id de uma nunca encontra a outra. O escopo de ACESSO continua sendo o do path; este aqui é o
  /// escopo do DADO.
  companyId String

  /// ⚠⚠ A IDENTIDADE DO LOTE — é ela que faz "a mesma planilha não emite duas vezes".
  ///
  /// SHA-256 sobre as linhas `PRONTA` já classificadas, na ordem. **NÃO é o hash do arquivo**: o
  /// Excel reescreve metadados e o mesmo conteúdo sai com bytes diferentes, e os `ajustes` mudam o
  /// que vai ser emitido sem tocar no arquivo. A impressão digital é sobre **o que será emitido**,
  /// que é a definição de duplicidade.
  impressaoDigital String

  /// emitindo | concluido | parado_indeterminado | erro
  status String @default("emitindo")

  totalLinhas Int
  emitidas    Int @default(0)
  recusadas   Int @default(0)
  naoTentadas Int @default(0)

  /// ⚠⚠ O NÚMERO DA LINHA DO EXCEL CUJO DESFECHO NÃO SE SABE (falha de TRANSPORTE: o pedido saiu e
  /// a resposta não voltou — a nota pode existir do outro lado).
  ///
  /// ⚠ COLUNA PRÓPRIA, NÃO DERIVADA: depois de um reinício não existe mais nada que diga "nesta
  /// aqui você não encosta". É sobre ela que a retomada faz `numeroLinha > linhaIndeterminada` —
  /// uma QUERY, não um `if` que alguém possa inverter depois.
  linhaIndeterminada Int?

  paradoEm     DateTime?
  paradoMotivo String?

  criadoPor    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  linhas  LoteEmissaoNfseLinha[]
  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// ⚠ A TRAVA DA IDEMPOTÊNCIA. A segunda tentativa com a mesma planilha bate aqui e o serviço
  /// devolve o lote EXISTENTE — não reprocessa, e não responde 409: o que a tela precisa ver é o
  /// relatório da primeira vez. Duplicidade de nota fiscal não se desfaz, e contar com o E0014 do
  /// outro lado é contar com sorte.
  @@unique([companyId, impressaoDigital])
  @@index([companyId, criadoEm])
  @@map("lotes_emissao_nfse")
}

model LoteEmissaoNfseLinha {
  id     String @id @default(uuid())
  loteId String

  /// ⚠ O NÚMERO DA LINHA DO EXCEL, nunca índice de array — eles divergem no primeiro cabeçalho ou
  /// linha em branco, e o desfecho iria para a NOTA ERRADA. Mesma disciplina de `ajustesLote.js`.
  numeroLinha Int

  /// ⚠⚠ O PAYLOAD CONGELADO — o que a tela de conferência mostrou, na forma que `classificarLinhaLote`
  /// já devolve. É o que permite RETOMAR sem o arquivo: os `ajustes` NÃO persistem (a planilha no
  /// disco continua dizendo o antigo), então pedir o arquivo de novo na retomada emitiria conteúdo
  /// diferente do confirmado, ou devolveria as linhas a pendentes.
  dados Json

  /// Repetidos fora do `dados` para o relatório poder NOMEAR a linha sem desempacotar o Json.
  tomadorDoc    String
  tomadorNome   String
  valorServicos Decimal   @db.Decimal(18, 2)
  competencia   DateTime?

  /// nao_tentada | enviando | emitida | recusada_receita | recusada_nossa | indeterminada
  ///
  /// ⚠⚠ `enviando` NÃO É ENFEITE — é a janela entre a reserva de numeração COMMITAR e o POST
  /// voltar. Se o processo morrer ali, a linha diria `nao_tentada` enquanto um número está queimado
  /// e a nota pode existir, e a retomada a reprocessaria. Toda linha encontrada em `enviando` é
  /// tratada como `indeterminada`. Sem este estado o desenho tem um caminho SILENCIOSO de
  /// reemissão.
  desfecho String @default("nao_tentada")

  serviceInvoiceId String?

  /// ⚠ GRAVADOS NA RESERVA, ANTES DO ENVIO. Não existe inutilização na NFS-e: número reservado que
  /// não virou nota é BURACO PERMANENTE, e isso é informação fiscal, não detalhe técnico — tem de
  /// ser legível pelo lote mesmo quando a `ServiceInvoice` diz `falha_envio`.
  ///
  /// ⚠ Ficam NULOS na recusa da camada `NOSSA`: ela acontece no pré-voo de `issue`, ANTES da
  /// reserva. Nenhum número é queimado nesse caminho, e o relatório não pode dizer o contrário.
  rpsSerie  String?
  rpsNumero String?

  /// NOSSA | TRANSPORTE | RECEITA — o MESMO vocabulário de `desfechoEmissao.js`, nunca um segundo.
  camada    String?
  codigo    String?
  mensagem  String?
  correcao  String?

  tentadaEm DateTime?
  criadoEm  DateTime @default(now())

  lote LoteEmissaoNfse @relation(fields: [loteId], references: [id], onDelete: Cascade)

  /// Uma linha do Excel entra UMA vez em cada lote.
  @@unique([loteId, numeroLinha])
  @@index([loteId, desfecho])
  @@map("lotes_emissao_nfse_linhas")
}

model AdnSyncState {
  cnpj      String   @id
  ultimoNSU BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model AdnDocument {
  id              String    @id @default(uuid())
  nsu             BigInt    @unique
  chaveAcesso     String?
  tipoDocumento   String?
  tipoEvento      String?
  // Status normalizado da NFSe no nosso domínio: "authorized", "cancelled", "cancelled_substitution", "rejected", "unknown"
  status          String?
  dataHoraGeracao DateTime?
  xmlBase64Gzip   String?
  xmlPlain        String?
  dataEmissao     DateTime?
  competencia     DateTime?
  cnpjPrestador   String?
  prestadorNome   String?
  cnpjTomador     String?
  tomadorNome     String?
  numeroNfse      String?
  valorServicos   Decimal?  @db.Decimal(18, 2)
  valorIss        Decimal?  @db.Decimal(18, 2)
  situacao        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([chaveAcesso])
  @@index([competencia])
  @@index([status])
  @@index([competencia, status, updatedAt])
  @@index([status, updatedAt])
  @@index([dataEmissao, status])
  @@index([cnpjPrestador, dataEmissao])
  @@index([cnpjTomador, dataEmissao])
}

// ==========================
// Portal (modelo novo)
// ==========================

model PortalClient {
  id                     String    @id @default(uuid())
  // Referência opcional para a Company legada (certificado, cadastros, etc.)
  companyId              String?   @unique
  razao                  String
  cnpj                   String    @unique
  /// E-mail só para envio de guias (pode repetir entre empresas). Não é login do portal.
  guideNotificationEmail String?
  /// Indica se há pró-labore (exige guia INSS na competência de referência para alertas).
  hasProlabore           Boolean   @default(false)
  /// Empresa tem FOLHA DE PAGAMENTO (empregado registrado). Não é o mesmo que `hasProlabore`:
  /// sócio retirando pró-labore sem nenhum empregado não gera eSocial/FGTS de folha. Por isso são
  /// dois campos e não um — juntá-los criaria obrigação trabalhista em empresa que não tem.
  /// Serve de filtro nas regras de obrigação do escritório ("aplicar a todas as empresas com folha").
  temFolha               Boolean   @default(false)
  /// Empresa zerada / sem movimento: não gera impostos; só enviamos obrigações zeradas.
  /// No card, oculta as guias/obrigações e sinaliza que é zerada.
  empresaZerada          Boolean   @default(false)
  /// Por onde a guia sai por padrão. Default EMAIL de propósito: ninguém é migrado de canal à
  /// revelia — o WhatsApp entra empresa a empresa, conforme o cliente autoriza (ver optIn em
  /// ContatoWhatsapp). "PERGUNTAR" faz o confirm de envio pedir o canal toda vez.
  canalPadraoEnvio       String    @default("EMAIL") // EMAIL | WHATSAPP | PERGUNTAR
  inscricaoMunicipal     String?
  uf                     String?
  municipio              String?
  /// ⚠ PORTÃO DO ATO FISCAL — decisão do dono, 18/08/2026: *"o acesso a emissão deve ser liberado
  /// para o cliente pelo portal do contador"*. Enquanto isto for `false`, NENHUM usuário do lado do
  /// CLIENTE emite ou cancela NFS-e desta empresa, qualquer que seja o papel dele. O usuário do
  /// ESCRITÓRIO não passa por aqui (ver `emissaoNfseGate.js`): foi por esse caminho que a primeira
  /// nota real saiu, e travá-lo pararia o contador.
  ///
  /// ⚠ NASCE FECHADA, sem exceção. Ato fiscal não se libera por omissão — e o default é o que
  /// protege as empresas que já existem no dia em que a migration for aplicada.
  emissaoClienteLiberada Boolean   @default(false)
  /// Quando e por QUEM a liberação foi ligada (userId, mesmo padrão de `fechadoContabilPor`).
  /// ⚠ Desligar volta os dois a NULO — a coluna responde "quem autorizou este cliente a emitir?",
  /// e guardar nela o instante do DESLIGAMENTO seria dar dois significados a uma coluna só (o erro
  /// documentado em "TRÊS NÚMEROS DE DAS, TRÊS COLUNAS").
  emissaoClienteLiberadaEm  DateTime?
  emissaoClienteLiberadaPor String?
  // Q11.1: empresa pode ser SUSPENSA (workers SERPRO pulam, não captura nem processa).
  // Suspender é reversível; excluir é hard-delete via DELETE /companies/:id.
  status                 String    @default("ATIVA") // ATIVA | SUSPENSA
  suspendedAt            DateTime?
  suspendedReason        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  integrationSettings     PortalIntegrationSettings?
  syncState               PortalSyncState?
  invoices                PortalInvoice[]
  guides                  Guide[]
  invoiceEvents           PortalInvoiceEvent[]
  syncJobs                PortalInvoiceSyncJob[]
  manifestacoes           NfeManifestacaoQueue[]
  apuracoes               Apuracao[]
  deparasAnexo            DeparaAnexo[]
  companyClientUsers      CompanyClientUser[]
  companyFirmAccess       CompanyFirmAccess[]
  taxDocuments            TaxDocument[]
  chartOfAccounts         ChartOfAccount[]
  accountingEntries       AccountingEntry[]
  monthlyCirculars        CompanyMonthlyCircular[]
  accountingEntryRules    AccountingEntryRule[]
  fiscalExecutionLogs     FiscalExecutionLog[]
  accountingFunctions     AccountingFunction[]
  parcelamentos           Parcelamento[]
  procuracoes             Procuracao[]
  pendenciasPosFechamento PendenciaPosFechamento[]
  contatosWhatsapp        ContatoWhatsapp[]
  /// Fios de conversa ATRIBUÍDOS a esta empresa. Fio não atribuído (`DESCONHECIDO`/`AMBIGUO`)
  /// existe com `portalClientId` nulo e não pertence a tenant nenhum — que é o correto: nulo nunca
  /// casa com um `where` de escopo, então a fila de não vinculados não pode vazar para uma empresa.
  conversasWhatsapp       ConversaWhatsapp[]
  // Q14 — refundação da apuração (cadastro como autoridade)
  cadastroFiscal          CadastroFiscal?
  produtosServicos        ProdutoServico[]
  regrasClassificacao     RegraClassificacao[]
  filaPendencias          FilaPendencia[]
  apuracaoSnapshots       ApuracaoSnapshot[]
  logsDecisaoFatorR       LogDecisaoFatorR[]
  fiscalStatus            CompanyFiscalStatus?
  rotinas                 CompanyRotina[]
  documentos              CompanyDocument[]
  anotacoes               CompanyNote[]
  MarcoFiscal             MarcoFiscal[]
  obrigacoes              Obrigacao[]
  estornosBaixa           EstornoBaixa[]
  /// Contraparte de `atos_parcelamento`. NENHUMA coluna nova em `portal_clients` — a FK mora lá.
  atosParcelamento        AtoParcelamento[]
  /// Contraparte da relação do funil de onboarding. NENHUMA coluna nova é criada em
  /// `portal_clients`: a FK mora em `onboardings.portalClientId`.
  onboarding              Onboarding?
  /// Cofre de senhas da empresa. ⚠ Coluna cifrada PRÓPRIA (`company_credentials.senhaCifrada`) —
  /// senha não entra em Json de cadastro nem em campo de texto do `PortalClient`.
  credenciais             CompanyCredential[]
  /// "Outras informações" — texto livre por rótulo, NÃO cifrado (ver o model).
  informacoes             CompanyInfo[]
  /// Auditoria de leitura do cofre. FK aqui para a varredura por empresa não depender da
  /// credencial ainda existir.
  credenciaisAcessos      CompanyCredentialAcesso[]
  /// Relatórios de faturamento gerados por competência. NENHUMA coluna nova em `portal_clients`:
  /// a FK mora em `relatorios_faturamento.portalClientId`.
  relatoriosFaturamento   RelatorioFaturamento[]
  /// Trocas de senha do usuário do portal feitas PELO ESCRITÓRIO nesta empresa. NENHUMA coluna
  /// nova aqui — a FK mora em `senhas_portal_trocas.portalClientId`, e ela é NULA nos caminhos do
  /// cliente (perfil e recuperação), que não passam por empresa nenhuma.
  senhasPortalTrocas      PortalPasswordChange[]
  declarados              LancamentoDeclarado[]
  regrasContabilizacao    RegraContabilizacao[]
  ofxImports              OfxImport[]

  @@index([cnpj])
  @@index([updatedAt])
  @@index([status])
}

/// Quais rotinas de captura SERPRO cada empresa faz. Antes isso era implícito: o worker
/// derivava do regime (Simples→DAS+extrato, LP→Presumido) e o INSS era tentado em TODA
/// empresa. Agora é declarado — o contador vê e escolhe na página Rotinas.
///
/// A AGENDA (dia/hora) é global por rotina e vive em AppSetting["serpro_runtime_settings"],
/// não aqui: aqui é só QUEM faz o quê.
///
/// `rotina` usa o vocabulário real do SERPRO (o mesmo das "Funções em lote"):
///   das | inss | extrato | presumido | parcelamento | pagamento
/// PIS/COFINS/CSLL/IRPJ NÃO são rotinas: vêm juntos numa única consulta, a do `presumido`,
/// e são separados aqui por código de receita (ver parseDctfwebDeclaracao.js).
model CompanyRotina {
  id             String   @id @default(uuid())
  portalClientId String
  rotina         String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, rotina])
  @@index([rotina, enabled])
  @@map("company_rotinas")
}

/// Datas que o contador marca à mão no calendário fiscal — o que NÃO vem de dado nenhum.
/// O caso que motivou: a virada do IBS/CBS. O calendário já mostra sozinho o que vence (guias com
/// vencimento, competência não transmitida, mês não fechado); isto aqui é para o resto.
/// `portalClientId` nulo = marco do ESCRITÓRIO, vale para todas as empresas.
model MarcoFiscal {
  id             String   @id @default(uuid())
  portalClientId String?
  titulo         String
  data           DateTime
  descricao      String?
  /// ALTA | MEDIA | BAIXA — só destaque visual, não muda comportamento.
  importancia    String   @default("MEDIA")
  criadoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([data])
  @@index([portalClientId, data])
  @@map("marcos_fiscais")
}

/// Documentos societários/cadastrais da empresa (contrato social, cartão CNPJ, inscrições…).
/// Até aqui só existia lugar para guia e nota fiscal: contrato social e inscrições viviam fora do
/// sistema, e toda vez que o cliente pedia alguém garimpava em e-mail/pasta local.
/// O arquivo NÃO fica no banco — `fileKey` aponta pro GuideStorageService (LOCAL/S3/R2), o mesmo
/// que guarda as guias, justamente pra herdar a resolução de volume já corrigida.
model CompanyDocument {
  id             String    @id @default(uuid())
  portalClientId String
  /// CONTRATO_SOCIAL | CARTAO_CNPJ | INSCRICAO_ESTADUAL | INSCRICAO_MUNICIPAL | ALVARA | PROCURACAO | OUTRO
  tipo           String
  /// Nome de exibição (o do arquivo enviado, ou um rótulo dado pelo contador).
  nome           String
  fileKey        String
  mimeType       String
  bytes          Int
  /// Só para documento que vence (alvará, procuração). Null = não expira.
  validade       DateTime?
  uploadedById   String?
  createdAt      DateTime  @default(now())

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, tipo])
  @@map("company_documents")
}

/// Anotações do contador sobre a empresa — o que hoje mora na cabeça de quem atende.
/// `fixada` é EXCLUSIVA: fixar uma desafixa a anterior (ver CompanyNotesService). A fixada aparece
/// sempre no topo, independente da ordenação escolhida.
model CompanyNote {
  id             String   @id @default(uuid())
  portalClientId String
  texto          String
  /// ALTA | MEDIA | BAIXA
  importancia    String   @default("MEDIA")
  fixada         Boolean  @default(false)
  autorId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, fixada])
  @@map("company_notes")
}

// Q40 Fase C: relatório de situação fiscal (SITFIS) por empresa — última consulta.
// 1 linha por empresa (@unique). ADD-only; sob demanda (não em massa — custo por chamada).
model CompanyFiscalStatus {
  id                 String    @id @default(uuid())
  portalClientId     String    @unique
  tipo               Int       @default(2) // 1=CPF, 2=CNPJ
  situacao           String? // resumo textual/derivado (opcional)
  protocolo          String? // protocoloRelatorio do SOLICITARPROTOCOLO91
  relatorioPdfFileId String? // PDF do relatório (quando o SERPRO devolve PDF base64)
  texto              String? // relatório em texto (quando aplicável)
  rawPayload         Json?
  checkedAt          DateTime  @default(now()) // última TENTATIVA (sobe até quando volta "processando")
  // Última consulta que realmente TROUXE relatório. A trava de 4h é ancorada aqui, não em
  // checkedAt: senão uma tentativa que voltou "processando" (sem PDF) iniciava a trava e deixava
  // a empresa 4h sem conseguir buscar a situação fiscal.
  ultimoRelatorioEm  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@map("company_fiscal_status")
}

// ─── WHATSAPP ────────────────────────────────────────────────────────────────────────────────
// Contato de WhatsApp da empresa. É o equivalente do `PortalClient.guideNotificationEmail`, mas
// como TABELA porque uma empresa pode ter mais de um destinatário (sócio, financeiro) e porque o
// opt-in precisa de data e origem próprios.
model ContatoWhatsapp {
  id             String    @id @default(uuid())
  portalClientId String
  nome           String
  papel          String? // "financeiro", "sócio"… — texto livre, é rótulo de tela
  /// SEMPRE E.164 (`5521999998888`), normalizado no cadastro. Guardar com máscara faria a
  /// comparação com o `waId` que a Meta devolve falhar em silêncio no webhook.
  telefoneE164   String
  /// ID do usuário na Meta, descoberto no primeiro contato. É por ele que o webhook encontra o
  /// contato — o número que a Meta devolve nem sempre bate dígito a dígito com o cadastrado
  /// (no Brasil, o 9 do celular).
  waId           String?
  /// ⚠ OPT-IN É BLOQUEIO, NÃO AVISO. Sem data aqui, a empresa não recebe template: é exigência de
  /// política da Meta e é o que protege o número de denúncia por spam. Perder o número por
  /// denúncia derruba o canal com TODOS os clientes de uma vez.
  optInEm        DateTime?
  optInOrigem    String? // contrato | formulario | verbal_registrado | …
  ativo          Boolean   @default(true)
  /// QUEM é a pessoa por trás do número — e o único caminho até o papel dela.
  ///
  /// ⚠ `papel` (acima) é RÓTULO DE TELA, texto livre. O papel que decide o que a pessoa pode fazer é
  /// `CompanyClientUser.role` (FINANCEIRO < CLIENT_ADMIN < OWNER), e ele só é alcançável a partir de
  /// um `userId`. Sem este ponteiro o vínculo identifica a EMPRESA e diz, com todas as letras, que
  /// não identifica pessoa nenhuma — casar `nome` com o nome do usuário seria adivinhar quem fala.
  ///
  /// ⚠ NULLABLE de propósito: contato do financeiro terceirizado, do sócio sem login no portal, ou
  /// cadastrado antes de a pessoa ter conta é caso NORMAL. Obrigar o ponteiro tornaria o contato
  /// incadastrável nesses casos; deixá-lo nulo é a resposta honesta ("não sei quem é").
  ///
  /// ⚠ VÍNCULO NÃO É AUTORIZAÇÃO. Este campo dá o caminho até o papel; quem decide continua sendo
  /// `requireClientCompanyAccess(minRole)`. `onDelete: SetNull` porque apagar o usuário apaga a
  /// identificação da pessoa, nunca o contato da empresa.
  userId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([portalClientId, telefoneE164])
  @@index([waId])
  @@index([userId])
  @@map("contatos_whatsapp")
}

// O ESTADO DE ENVIO DE UMA GUIA, por canal.
//
// ⚠ Até aqui quem respondia "esta guia foi enviada?" era `Guide.emailStatus` — e é dele que o chip
// da listagem e o `guideCompliance` derivam o estado `enviada`. Isso funcionava enquanto havia UM
// canal. Com o WhatsApp, um campo só não consegue representar "enviada por WhatsApp, ainda não por
// e-mail", e o próprio plano oferece "Ambos".
//
// Esta tabela passa a ser a fonte da verdade do ENVIO; `emailStatus` continua existindo como
// detalhe de transporte do e-mail (o worker de e-mail segue escrevendo nele).
model EnvioGuia {
  id                  String    @id @default(uuid())
  guideId             String
  canal               String // EMAIL | WHATSAPP
  status              String    @default("pendente") // pendente|enviando|enviado|entregue|lido|falhou
  /// Para onde foi de fato: e-mail ou E.164. Guardado no envio (não lido do cadastro na hora de
  /// exibir) porque o contato pode mudar depois — o histórico tem que dizer para onde FOI.
  destino             String?
  /// `wamid` no WhatsApp. Chave de correlação dos eventos de status do webhook e de idempotência.
  providerMessageId   String?
  erroCodigo          String?
  /// Mensagem JÁ TRADUZIDA para o contador. Código cru da Meta não chega na tela — mesma lição do
  /// `validation_failed`, que mostrava o código e escondia o motivo.
  erroMensagemUsuario String?
  tentativas          Int       @default(0)
  proximaTentativaEm  DateTime?
  enviadoEm           DateTime?
  entregueEm          DateTime?
  lidoEm              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  /// Os balões do fio que carregaram esta guia. ⚠ O ESTADO do envio continua sendo desta linha —
  /// a mensagem só aponta para cá. Uma cópia do estado no fio seria a segunda resposta para
  /// "esta guia foi enviada?".
  mensagens MensagemWhatsapp[]

  /// ⚠ É esta constraint que torna reexecutar o lote inofensivo: a segunda passada encontra o
  /// registro e não redispara.
  @@unique([guideId, canal])
  @@index([status, proximaTentativaEm])
  @@index([providerMessageId])
  @@map("envios_guia")
}

// ─── WHATSAPP — A CONVERSA ───────────────────────────────────────────────────────────────────
//
// ⚠ A FRONTEIRA COM `envios_guia`, QUE É O QUE ESTAS DUAS TABELAS **NÃO** GUARDAM:
//
//   `envios_guia`        = o estado do ENVIO DE UMA GUIA (uma linha por guia × canal). É dele que
//                          saem o chip da listagem e o `guideCompliance`. Ele já tem a escada
//                          `pendente→enviando→enviado→entregue→lido|falhou`, o retry
//                          (`proximaTentativaEm`), o erro JÁ TRADUZIDO e o gancho do webhook
//                          (`aplicarStatusDoProvedor`, que nunca rebaixa).
//   `mensagens_whatsapp` = a CONVERSA — o que foi dito, por quem, quando.
//
// Por isso **a mensagem não tem coluna de status**: guardá-la aqui daria uma segunda resposta para
// "esta guia foi enviada?", pergunta que já tem dona. A ligação entre as duas é o ponteiro
// `envioGuiaId`, e é ele — não uma cópia do estado — que faz o balão do fio mostrar o ✓✓ do envio.

/// O FIO ENTRE UM NÚMERO E O ESCRITÓRIO.
///
/// ⚠ A CHAVE É O NÚMERO, NÃO O CONTATO — e essa é a diferença que permite representar o caso
/// AMBIGUO. Um mesmo número fala legitimamente por mais de um CNPJ (o sócio com três empresas), e
/// `contatos_whatsapp` permite o mesmo telefone em várias empresas de propósito. Se a conversa
/// fosse chaveada pelo contato, a MESMA mensagem recebida teria de ser gravada N vezes, uma no
/// histórico de cada empresa candidata — a mensagem do cliente aparecendo no fio do CNPJ errado é
/// exatamente o vazamento que a multi-tenancy existe para impedir. Um número, um fio, uma linha.
model ConversaWhatsapp {
  id                 String    @id @default(uuid())
  /// O número do cliente, E.164 sem `+`, como `contatos_whatsapp.telefoneE164`.
  telefoneE164       String    @unique
  /// ⚠ A EMPRESA A QUE ESTE FIO FOI ATRIBUÍDO — e NULO é resposta, não falta de dado.
  ///
  /// Nulo = "não vinculado": ou o número não está em cadastro nenhum (`DESCONHECIDO`), ou fala por
  /// mais de uma empresa (`AMBIGUO`). Nos dois casos o fio existe, a mensagem está guardada e nada
  /// some — o que não acontece é escolher uma empresa em silêncio. Quem responde de qual empresa se
  /// trata é `resolverVinculoPorTelefone`, na LEITURA; aqui só se grava a atribuição já decidida
  /// (automática quando o vínculo diz `VINCULADO`, humana quando ele diz `AMBIGUO`).
  ///
  /// ⚠ É AQUI QUE O TENANT MORA — não no contato. No esqueleto do dono a mensagem só alcançava a
  /// empresa através de `contato_whatsapp`, e um contato apagado ou movido levava junto o escopo de
  /// todo o histórico. `onDelete: SetNull` pelo mesmo motivo: apagar a empresa desatribui o fio (que
  /// volta para a fila de não vinculados), nunca apaga o que o cliente escreveu.
  portalClientId     String?
  /// O `profile.name` que a Meta manda junto do evento, REGISTRADO COMO OBSERVADO.
  /// ⚠ NUNCA usado para casar empresa — casar por nome é a adivinhação que `vinculoTelefone.js`
  /// existe para não fazer. Serve para a fila de não vinculados dizer quem escreveu.
  nomePerfilProvedor String?
  /// Até quando o escritório leu este fio.
  /// ⚠ INSTANTE, e não um contador `naoLidas`. Contador tem dois escritores (o webhook incrementa,
  /// a tela zera) e diverge no primeiro evento perdido ou reentregue — e nada no banco denuncia. As
  /// não lidas são as mensagens recebidas depois deste instante: derivadas, sempre certas.
  lidaAteEm          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  portalClient PortalClient?      @relation(fields: [portalClientId], references: [id], onDelete: SetNull)
  mensagens    MensagemWhatsapp[]

  /// A fila "não vinculados" é uma CONSULTA (`portalClientId IS NULL`), não uma tabela: guardar o
  /// motivo (`DESCONHECIDO`/`AMBIGUO`) numa linha o faria envelhecer — cadastrado o contato às 10h,
  /// a linha continuaria dizendo "desconhecido". O motivo se pergunta ao vínculo, na leitura.
  @@index([portalClientId])
  @@map("conversas_whatsapp")
}

/// UMA MENSAGEM DO FIO. Imutável: por isso não tem `updatedAt` — mensagem não se edita.
model MensagemWhatsapp {
  id                 String    @id @default(uuid())
  conversaId         String
  /// `in` (do cliente) | `out` (nossa). Vocabulário do plano do dono; travado por CHECK no banco.
  direcao            String
  /// O campo `id` do objeto de mensagem da Meta (`wamid.…`).
  ///
  /// ⚠ **É A GARANTIA DE BANCO DA IDEMPOTÊNCIA DO WEBHOOK.** A Meta reentrega evento; com este
  /// `@unique`, a segunda entrega do mesmo evento não CONSEGUE virar uma segunda mensagem — não
  /// depende de o código lembrar de conferir antes. Mesmo desenho de `uq_baixa_guia_linha` e da
  /// reserva atômica descrita no CLAUDE.md de `application/accounting/`.
  /// Nulável porque uma mensagem NOSSA existe antes de a Meta devolver o id; para `direcao = 'in'`
  /// o banco EXIGE o identificador (CHECK), senão a idempotência teria um buraco com forma de NULL.
  providerMessageId  String?   @unique
  /// O valor do campo `type` da Meta, COPIADO como veio (`text`, `document`, `image`, `template`…).
  /// ⚠ Não se traduz para um vocabulário nosso aqui: seria inventar um de-para sem nunca ter visto
  /// um payload real. O mesmo vocabulário serve aos dois sentidos — a API de envio usa `type` também.
  tipo               String
  /// O texto, quando há. Mídia não tem corpo: tem `midiaProvedorId`.
  corpo              String?
  /// O `id` do objeto de mídia na Meta.
  /// ⚠ Guarda-se o ID, NUNCA a URL: a URL que a Meta devolve EXPIRA, e uma coluna `midiaUrl` com
  /// ela dentro guardaria um link morto com cara de link. Baixar o arquivo para o storage próprio é
  /// da fase do webhook; sem o id registrado, a mídia fica irrecuperável.
  midiaProvedorId    String?
  /// ⚠ O PONTO DE ENCONTRO COM `envios_guia` — e o motivo de a mensagem não ter status próprio.
  /// Quando este balão carregou uma guia, o ESTADO daquele envio (enviado/entregue/lido/falhou,
  /// retry, erro traduzido) mora lá, com um escritor só. Aqui fica o ponteiro.
  envioGuiaId        String?
  /// O instante que a Meta reportou no evento (campo `timestamp`), já convertido.
  /// ⚠ Nulável: a ausência é dito, não presumido — ver `janela24h.js`.
  ocorridaEmProvedor DateTime?
  /// O instante em que NÓS gravamos. Sempre POSTERIOR ao fato (entrega do webhook + processamento).
  /// ⚠ São dois instantes de propósito, e a janela de 24h escolhe entre eles com critério declarado
  /// (`instanteQueAbreAJanela`): vence o mais ANTIGO, para a nossa janela nunca fechar depois da
  /// janela da Meta.
  registradaEm       DateTime  @default(now())

  conversa  ConversaWhatsapp @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  envioGuia EnvioGuia?       @relation(fields: [envioGuiaId], references: [id], onDelete: SetNull)

  /// ⚠ NENHUM `portalClientId` DENORMALIZADO AQUI, e a razão é a segurança, não a economia. A
  /// atribuição do fio MUDA (o ambíguo que o contador resolve; a empresa apagada que vira nulo) —
  /// uma cópia por mensagem teria um segundo escritor e, no dia em que discordasse, discordaria em
  /// silêncio e a favor do vazamento (histórico antigo respondendo pelo escopo da empresa errada).
  /// O tenant tem UM dono, `conversas_whatsapp.portalClientId`, e toda leitura passa por
  /// `ConversaWhatsappService`, que escopa por ele.
  @@index([conversaId, direcao, registradaEm])
  @@index([envioGuiaId])
  @@map("mensagens_whatsapp")
}

/// O TEMPLATE APROVADO NA META — o nome exato e o estado da aprovação.
///
/// ⚠ NASCE `DECLARADO`, E NENHUM DELES EXISTE NA META. `DECLARADO` significa "consta do nosso plano
/// e NUNCA foi conferido na Meta" — a mesma marca de `verificadoTrial: false` e
/// `verificadoNoLeiaute: false`. Semear `EM_ANALISE` (como fazia o esqueleto) afirmaria uma
/// submissão que ninguém fez: o cadastro na Meta está parado à espera do número.
/// ⚠ Por isso `nomeMeta` NASCE NULO: o nome exato só existe depois da aprovação. Copiar a chave
/// para lá seria transformar a nossa intenção em cadastro do provedor.
model TemplateWhatsapp {
  /// Chave interna (`guia_disponivel`, …) — é por ela que o código pede o template.
  chave             String    @id
  /// O nome EXATO aprovado na Meta. Nulo enquanto não houver aprovação.
  nomeMeta          String?
  idioma            String    @default("pt_BR")
  categoria         String    @default("UTILITY")
  /// Header de documento — é o que permite anexar o PDF da guia (manual do dono, Etapa 6).
  temDocumento      Boolean   @default(false)
  /// DECLARADO | EM_ANALISE | APROVADO | REJEITADO. Travado por CHECK no banco.
  /// ⚠ Só `APROVADO` autoriza envio; qualquer outro estado é recusa com motivo.
  statusAprovacao   String    @default("DECLARADO")
  motivoRejeicao    String?
  /// Quando o estado foi lido da Meta. Nulo = nunca foi — e é o que separa dado nosso de dado dela.
  conferidoNaMetaEm DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("templates_whatsapp")
}

model Guide {
  id                       String    @id @default(uuid())
  portalClientId           String?
  legacyCompanyId          String?
  competencia              String? // YYYY-MM
  tipo                     String // INSS|FGTS|PIS|COFINS|ISS|SIMPLES|OUTRA
  valor                    Decimal?  @db.Decimal(18, 2)
  valorOriginal            Decimal?  @db.Decimal(18, 2) // valor da PRIMEIRA captura (extrato); imutável em updates de recálculo
  vencimento               DateTime?
  cnpj                     String?
  paymentStatus            String?   @default("OPEN") // OPEN|PAID|OVERDUE
  paymentStatusSource      String? // SERPRO|MANUAL
  paymentConfirmedAt       DateTime?
  paymentConfirmedByUserId String?
  serproLastCheckedAt      DateTime?
  serproLastCheckResult    String?
  serproLastSeenAt         DateTime?
  serproService            String?
  // Q40: comprovante oficial de arrecadação (PAGTOWEB/COMPARRECADACAO) quando o pagamento é confirmado.
  comprovantePdfFileId     String?

  taxDocuments      TaxDocument[]
  accountingEntries AccountingEntry[] @relation("GuideToEntries")

  source       String  @default("DRIVE") // DRIVE|LOCAL
  sourceFileId String? @unique
  sourcePath   String?

  driveInboxFolderId String?
  driveFinalFolderId String?
  driveFinalFileId   String?

  storageProvider String? // DATABASE|S3|R2|LOCAL (legado)
  storageKey      String?
  storageUrl      String?
  /// PDF armazenado no PostgreSQL (BYTEA). Preferencial em relação a storage externo.
  pdfBytes        Bytes?
  hash            String? @unique

  /// Linha digitável de arrecadação (48 dígitos, sem máscara), LIDA do documento oficial.
  /// Só entra número que passou nos cinco dígitos verificadores (FEBRABAN §07–§10) E cuja
  /// importância bate com o total da guia. Nulo = não foi possível ler — nunca um palpite.
  linhaDigitavel       String?
  linhaDigitavelLidaEm DateTime?
  /// Motivo da RECUSA, quando não foi possível entregar uma linha pagável. Texto livre no banco
  /// (o catálogo cresce), lista FECHADA na tela. Nunca coexiste com `linhaDigitavel` (CHECK).
  linhaDigitavelMotivo String?
  /// Valor, EM CENTAVOS, codificado na linha recusada. Preenchido EXCLUSIVAMENTE quando o motivo é
  /// `valor_divergente_do_documento` — ali os 5 DVs fecharam e o número é confiável. Em recusa de
  /// DV/tamanho/produto fica nulo: imprimir valor lido de sequência corrompida seria inventar.
  linhaDigitavelValorLidoCentavos Int?

  status           String    @default("PENDING") // PENDING|PROCESSING|PROCESSED|NEEDS_REVIEW|ERROR
  errors           Json?
  extracted        Json?
  // Controle de envio por e-mail para guias já processadas
  emailStatus      String? // PENDING|SENDING|SENT|ERROR
  emailAttempts    Int       @default(0)
  emailLastError   String?
  emailSentAt      DateTime?
  emailNextRetryAt DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?

  // Portal Cliente (#3.1): guia só aparece no app do cliente quando o contador a "libera".
  liberadaCliente Boolean   @default(false)
  liberadaEm      DateTime?
  liberadaPor     String? // userId do contador que liberou (auditoria)

  /// Auditoria da marcação "sem movimento" (`status = "VAZIO"`).
  ///
  /// Marcar uma guia como vazia é DECLARAÇÃO FISCAL — o contador afirma que aquele tributo não
  /// tem guia naquele mês —, não uma preferência de tela. Por isso quem e quando ficam gravados e
  /// aparecem no popover do chip, com opção de desfazer.
  ///
  /// ⚠ Antes isto reusava `reviewedByUserId`/`reviewedAt`, que o registro MANUAL de guia também
  /// escreve: não dava para distinguir "marquei vazio" de "registrei uma guia à mão", e nem
  /// `toGuideResponse` os expunha. Campos próprios, no mesmo molde de `liberadaEm`/`liberadaPor`.
  vazioEm         DateTime?
  vazioPor        String? // userId do contador que afirmou a ausência
  vazioMotivo     String? // opcional, texto livre do contador

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Q9: link opcional pra um Parcelamento (quando guia é parcela de parcelamento).
  parcelamentoId     String?
  numeroParcela      Int?
  // Q21 (spec v2): metadados da parcela + estado de baixa.
  quantidadeParcelas Int?
  anoMesParcela      String? // YYYYMM (competência da parcela, chave da API)
  lancamentoId       String? // lançamento gerado (provisão ou pagamento)
  baixada            Boolean   @default(false)
  dataBaixa          DateTime?
  // Q28 Fase 3: estado explícito da PARCELA (só guias de parcelamento usam).
  // PREVISTA | EM_ATRASO | PAGA_A_CONFERIR | DIVERGENTE | CONFIRMADA | CANCELADA
  parcelaEstado      String?

  portalClient    PortalClient?    @relation(fields: [portalClientId], references: [id], onDelete: SetNull)
  legacyCompany   Company?         @relation(fields: [legacyCompanyId], references: [id], onDelete: SetNull)
  parcelamento    Parcelamento?    @relation("GuideParcelamento", fields: [parcelamentoId], references: [id], onDelete: SetNull)
  tributosParcela TributoParcela[]
  envios          EnvioGuia[]
  /// F2.1: a PARCELA que esta guia materializa (quando é guia de parcelamento). Lado inverso —
  /// a FK mora em `parcelas.guiaId`. A guia continua sendo a autoridade sobre o PAGAMENTO.
  parcela         Parcela?         @relation("GuideParcela")

  // Q21: ingestão idempotente da mesma parcela (parcial WHERE parcelamentoId NOT NULL via SQL).
  @@unique([parcelamentoId, numeroParcela])
  @@index([portalClientId, competencia, tipo])
  @@index([status])
  @@index([emailStatus, emailNextRetryAt])
  @@index([cnpj, competencia])
  @@index([paymentStatus, vencimento])
  @@index([parcelamentoId])
  @@index([baixada])
  @@index([portalClientId, parcelaEstado])
  // Portal Cliente (#3.1): filtro do /client por guias liberadas.
  @@index([portalClientId, liberadaCliente, competencia])
}

// Q8.B: model GuideIngestionJob removido — sem consumidores no código (varredura confirmou).
