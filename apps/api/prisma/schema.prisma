  updatedAt     DateTime @updatedAt

  client PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model PortalSyncState {
  clientId        String    @id
  lastCursor      BigInt    @default(0) // NSU/sequence (ADN/NFS-e)
  lastSyncAt      DateTime?
  state           String    @default("OK") // OK|RUNNING|ERROR
  lastError       String?
  lockUntil       DateTime?
  backoffUntil    DateTime?
  // Q12.B: cursor separado para DFe/SEFAZ (NF-e) — ADN e DFe rodam independentes.
  dfeNsuCursor    BigInt    @default(0)
  dfeLastSyncAt   DateTime?
  dfeLastError    String?
  dfeBackoffUntil DateTime?
  // Q12.B+: cursor separado para ADN/NFS-e do módulo Notas (não confundir com lastCursor,
  // que é usado pelo AdnSyncService legado e grava em AdnDocument). Esse aqui é exclusivo
  // do AdnNotasService que grava em PortalInvoice.
  adnNsuCursor    BigInt    @default(0)
  adnLastSyncAt   DateTime?
  adnLastError    String?
  adnBackoffUntil DateTime?
  // ⚠ "OLHEI" É DIFERENTE DE "RECEBI", e confundir os dois custou 29 dias.
  //
  // `adnLastSyncAt`/`dfeLastSyncAt` só são gravados quando vem documento — são "última vez que
  // recebemos algo". Enquanto o cursor estava travado, a ARAUJO BARRETO era varrida todo dia com
  // sucesso e o campo continuava em 06/07: no diagnóstico ela parecia abandonada, e uma empresa
  // legitimamente quieta parecia idêntica a uma com a captura quebrada.
  //
  // Estes dois registram a TENTATIVA, sempre — deu documento ou não. É a diferença entre
  // "ninguém olhou" e "olhamos e não veio nada", que é onde o defeito se escondia.
  adnLastAttemptAt DateTime?
  dfeLastAttemptAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([lockUntil])
  @@index([backoffUntil])
}

model PortalInvoice {
  id          String  @id @default(uuid())
  clientId    String
  type        String // NFSE, NFE, ...
  numero      String?
  serie       String?
  chaveAcesso String?
  idNfse      String? // opcional (dependendo do provedor)
  idDps       String? // opcional (NFSe Nacional)

  competencia DateTime?
  issueDate   DateTime?
  status      String    @default("PENDENTE") // EMITIDA|CANCELADA|SUBSTITUIDA|REJEITADA|PENDENTE|...
  total       Decimal?  @db.Decimal(18, 2)

  emitenteNome String?
  emitenteDoc  String?
  tomadorNome  String?
  tomadorDoc   String?

  // Storage (por enquanto no DB)
  xmlRaw  String?
  pdfUrl  String?
  xmlHash String?

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Q12.A: papel da empresa nesta nota (DFe traz emissor E destinatário na mesma fonte)
  papel                    String? // EMIT | DEST
  // statusEfetivo: derivado dos eventos (cancelamento/substituição). Análise só usa autorizada.
  //
  // ⚠ NA PRÁTICA SÓ DOIS VALORES SÃO ESCRITOS: `autorizada` e `cancelada`. `substituida` está
  // aqui desde o início e NUNCA foi gravado (0 linhas em produção, medido em 10/08/2026) — e
  // gravá-lo agora seria uma mudança de DINHEIRO disfarçada de rótulo: todo filtro de receita
  // testa `=== "autorizada"` (FechamentoService.js:63, RbtExtratoService.js:48, CalculoFiscal.js:81,
  // MotorApuracaoService.js:114) e todo filtro de exclusão testa `=== "cancelada"`
  // (routes/firm/notas.js:421 esconde da aba, :515 tira dos totais do resumo). Um terceiro valor
  // não casa com nenhum dos dois: a nota reapareceria na aba, entraria no total do resumo e
  // continuaria FORA do faturamento — duas telas discordando em silêncio sobre a mesma nota.
  //
  // A distinção cancelada × substituída NÃO mora aqui. Mora em `PortalInvoiceEvent.type` (o fato,
  // com data e motivo) e em `chaveSubstituida` (o vínculo). Ver `application/notas/cicloNota.js`,
  // que junta os três e é o que a tela deve ler.
  statusEfetivo            String? // autorizada | cancelada  (ver aviso acima)

  // ⚠ O VÍNCULO DA SUBSTITUIÇÃO — "esta nota substitui a de chave X".
  //
  // Vem do XML da própria nota (`<subst><chSubstda>`, ANEXO_I v1.01), não do evento. É por isso que
  // ele é recuperável retroativamente e o evento não: o XML da nota nós guardamos inteiro
  // (`xmlRaw`), o do evento era descartado. `scripts/backfill-substituicao-nfse.mjs` extrai os
  // pares que já estão na base sem chamar o ADN.
  //
  // Guarda a CHAVE, não o id da outra nota, e isso é deliberado: a substituída pode não estar (e em
  // 4 casos medidos NÃO está) no nosso banco. Um id exigiria que ela existisse; a chave registra o
  // vínculo mesmo quando a outra ponta falta — e "aponta para uma nota que não temos" é uma
  // resposta legítima, diferente de "não aponta para ninguém".
  chaveSubstituida         String?
  motivoSubstituicao       String?
  // Q12.A: marca quando a nota chegou em competência já fechada (vai pra fila de pendências)
  competenciaPosFechamento Boolean @default(false)

  // ═══════════════════════════════════════════════════════════════════════════════════════════
  // CAMPOS FISCAIS EXTRAÍDOS DO XML — a auditoria pré-apuração precisa deles em COLUNA
  // ═══════════════════════════════════════════════════════════════════════════════════════════
  //
  // Pedido do dono (17/08/2026): "nos ajuda em uma auditoria pré-apuração para entender se a nota
  // está correta ou não, baseado na atividade e baseado na data de emissão".
  //
  // ⚠ NÃO HOUVE NADA A "TRAZER": o XML já está inteiro em `xmlRaw` (medido em produção,
  // `scripts/diag-cobertura-xml-notas.mjs`: EMIT 14.946 = 100% com XML; DEST 1.846 = 98%). Estas
  // colunas só materializam o que já estava dentro do texto.
  //
  // ⚠ O EXTRATOR É O ÚNICO ESCRITOR — `application/nfse/camposFiscaisNfse.js`, lido por caminho
  // (NT 008 §2.4.5, transcrita em `nfse/danfse/danfseLeiaute.js`), NUNCA por nome de tag. Ninguém
  // corrige estas colunas por fora: a projeção é recalculável, nunca editável. Backfill idempotente
  // em `scripts/backfill-campos-fiscais-nota.mjs` (dry-run por padrão, zero chamada externa).
  //
  // ⚠ NULO É RESPOSTA. Onde a extração falhar, a coluna fica NULA e o motivo vai em
  // `camposFiscaisMotivo` — nunca um valor "provável", nunca zero no lugar de ausente.
  //
  // ⚠ SÓ NFS-e. O XML da NF-e é outro documento (`nfeProc/NFe/infNFe`) e não tem nenhum destes
  // campos; nas linhas `type = "NFE"` tudo isto fica nulo, inclusive `camposFiscaisExtraidosEm`.
  //
  // O CÓDIGO DE SERVIÇO — o campo central da pergunta "a nota foi emitida na atividade certa?".
  // ⚠ NÃO é o item da LC 116: é item(2)+subitem(2)+desdobro nacional(2). Ver a seção "N CÓDIGOS DE
  // SERVIÇO" em `apps/api/CLAUDE.md`. Caminho: `.../DPS/infDPS/serv/cServ/cTribNac`.
  //
  // ⚠ ISTO NÃO SUBSTITUI `NotaItem.codigoServico`, que a captura já grava a partir de
  // `AdnXmlMetadata.parseXmlMetadata` — e que é lido por `getTextByLocalNames` (varredura por nome).
  // Aquele caminho continua intocado; o backfill COMPARA os dois e relata a divergência.
  cTribNac                 String?
  cTribMun                 String?
  // As descrições que a própria NFS-e devolve prontas (`infNFSe/xTribNac`, `infNFSe/xTribMun`) —
  // por isso o DANFSe pode imprimi-las sem tabela nenhuma (NT §2.4.5, campo `xTrib`).
  xTribNac                 String?
  xTribMun                 String?
  // `.../serv/cServ/xDescServ` — a descrição do serviço escrita pelo emitente.
  xDescServ                String?
  // Município da PRESTAÇÃO (código IBGE, `.../serv/locPrest/cLocPrestacao`). Decide para qual
  // prefeitura o ISSQN é devido (LC 116/2003, art. 3º) — local errado é ISS na cidade errada.
  cLocPrestacao            String?
  // ⚠ ISSQN, e os três nomes são explícitos DE PROPÓSITO. A tag da base de cálculo é `vBC`, e `vBC`
  // existe em DOIS grupos do XML (`infNFSe/valores` = ISSQN; `IBSCBS/valores` = base após exclusões
  // do IBS/CBS). Chamar a coluna de `vBC` deixaria a ambiguidade dentro do nome dela.
  issqnBaseCalculo         Decimal? @db.Decimal(18, 2) // infNFSe/valores/vBC
  issqnAliquota            Decimal? @db.Decimal(7, 4) // infNFSe/valores/pAliqAplic
  issqnValor               Decimal? @db.Decimal(18, 2) // infNFSe/valores/vISSQN
  // ⚠ COLUNAS NOVAS, E NÃO A COLUNA `serie` ACIMA. `serie` já existe e é escrita **só** por
  // `notas/dfe/DfeSyncService.js`, para NF-e; a série da DPS é outro contador, de outro documento.
  // Gravar as duas na mesma célula é a classe de defeito já paga em "TRÊS NÚMEROS DE DAS, TRÊS
  // COLUNAS" (`apps/api/CLAUDE.md`): a coluna passaria a guardar ora um, ora outro, sem nada na
  // linha que os distinguisse. Lidas por `nfse/nfseUltimaNota.lerSerieENumeroDaDps` — a MESMA
  // função da numeração automática, não uma segunda leitura.
  // ⚠ E `dpsNumero` não é `numero`: `numero` guarda o `nNFSe` (contador do município/SEFIN).
  dpsSerie                 String? // .../DPS/infDPS/serie (5 dígitos, normalizada)
  dpsNumero                String? // .../DPS/infDPS/nDPS
  // ⚠ SEM ISTO, "coluna nula" seria ambíguo entre "o XML não traz o campo" e "o extrator nunca
  // passou por esta linha" — que é o quarto estado perigoso já nomeado na migration do ciclo de
  // vida da NFS-e ("não temos o evento" se parece com "não houve evento" e significa o oposto).
  camposFiscaisExtraidosEm DateTime?
  camposFiscaisMotivo      String? // vocabulário fechado em `camposFiscaisNfse.MOTIVO`

  client     PortalClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  events     PortalInvoiceEvent[]
  itens      NotaItem[]
  pendencias PendenciaPosFechamento[]
  declarados LancamentoDeclarado[]

  @@unique([clientId, chaveAcesso])
  @@unique([clientId, idDps])
  @@unique([clientId, idNfse])
  @@index([clientId])
  @@index([clientId, updatedAt])
  @@index([clientId, competencia, status, updatedAt])
  @@index([clientId, issueDate])
  @@index([status, updatedAt])
  @@index([papel])
  @@index([statusEfetivo])
  // A pergunta inversa ("quem substituiu ESTA nota?") é uma varredura por chave dentro da empresa.
  @@index([clientId, chaveSubstituida])
  // A pergunta da auditoria: "quais notas DESTA empresa saíram no código de serviço X?" — sempre
  // por empresa primeiro, porque multi-tenancy não é opcional nem no índice.
  @@index([clientId, cTribNac])
}

// O FATO que aconteceu com a nota — cancelamento, substituição, manifestação.
//
// ⚠ ESTA TABELA EXISTIA E ESTAVA VAZIA: 0 linhas em produção para 556 NFS-e canceladas
// (medido em 10/08/2026). O caminho ADN aplicava o evento — virava `statusEfetivo="cancelada"` —
// e descartava tudo o mais no mesmo instante: data do fato, motivo, sequência, e a chave da nota
// substituta. Sobrava um retrato sem história, e a distinção entre "cancelada" e "substituída"
// não tinha onde existir.
//
// O que se perdeu não volta: o XML do evento nunca foi gravado, então aqueles 556 cancelamentos
// só se recuperam relendo o ADN por NSU. Daqui para frente, o evento fica.
model PortalInvoiceEvent {
  id       String @id @default(uuid())
  clientId String
  // ⚠ FK OBRIGATÓRIA — evento cuja nota ainda não chegou NÃO CABE AQUI. Na prática o ADN entrega a
  // nota antes do evento dela (o NSU da emissão é menor que o do cancelamento), e não observamos
  // nenhum caso; mas quando acontecer, o evento é contado e perdido. Quem resolve isso é o ledger
  // da Fase 1 (`eventos`, sem FK, chaveado por `chaveAcesso`) — ligar aquilo é decisão do dono.
  invoiceId String
  // cancelamento | canc_por_substituicao (ADN/NFS-e) · CANCELAMENTO | MANIFESTACAO (SEFAZ/NF-e).
  // O vocabulário do lado NFS-e é o mesmo de `Evento.tipoEvento` (ledger), de propósito.
  type       String
  date       DateTime?
  protocol   String?
  reason     String?
  payloadRaw Json?
  createdAt  DateTime  @default(now())

  // Código oficial do evento (101101 cancelamento · 105102 cancelamento por substituição).
  // ⚠ Vem do atributo `Id` (`EVT`+chave+tpEvento+nSeq), NÃO de um elemento `<tpEvento>` — ele não
  // existe em nenhum dos 62 eventos reais capturados.
  tpEvento   String?
  nSeqEvento Int?
  // "esta nota foi substituída POR aquela" — o lado espelhado de `PortalInvoice.chaveSubstituida`.
  // Guardado como chave porque a substituta pode não estar no nosso banco.
  chaveSubstituta String?

  client  PortalClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice PortalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Idempotência: o mesmo evento reprocessado (recaptura, cursor recuado) não vira linha nova.
  // ⚠ No PostgreSQL NULLs são distintos num índice único, então isto NÃO restringe o caminho
  // NF-e/SEFAZ, que grava sem `nSeqEvento` — de propósito: mudar aquele caminho não é o escopo.
  @@unique([invoiceId, type, nSeqEvento])
  @@index([clientId])
  @@index([invoiceId, date])
}

model PortalInvoiceSyncJob {
  id          String   @id @default(uuid())
  clientId    String
  state       String   @default("RUNNING") // RUNNING|DONE|ERROR
  processed   Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  duplicates  Int      @default(0)
  errors      Int      @default(0)
  lastCursor  BigInt?
  lastMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([state])
}

// Q12.B+++.8: fila de eventos de manifestação do destinatário pra NF-e
// (NT 2012.002 — evento 210210 Ciência libera XML completo no próximo DFe).
// Idempotência: 1 chaveAcesso só pode ter 1 evento de cada tpEvento.
model NfeManifestacaoQueue {
  id             String    @id @default(uuid())
  clientId       String
  chaveAcesso    String // chave 44 dígitos da NF-e a manifestar
  tpEvento       String // "210210" (Ciência), "210200" (Confirmação),
  // "210220" (Desconhecimento), "210240" (Não Realizada)
  nSeqEvento     Int       @default(1)
  status         String    @default("PENDING") // PENDING | SENT | ERROR | DUPLICATE
  attempts       Int       @default(0)
  lastError      String?
  lastResponse   String? // últimos 1KB da resposta SEFAZ pra debug
  protocoloSefaz String? // nProt do retorno (cStat 135)
  cStat          String? // código retorno SEFAZ
  xMotivo        String? // texto retorno SEFAZ
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client PortalClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, chaveAcesso, tpEvento]) // idempotência rígida
  @@index([status, createdAt])
  @@index([clientId, status])
}

model TaxDocument {
  id             String   @id @default(uuid())
  requestId      String?
  portalClientId String?
  guideId        String?
  contentHash    String
  sourceFileName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient?              @relation(fields: [portalClientId], references: [id], onDelete: SetNull)
  guide        Guide?                     @relation(fields: [guideId], references: [id], onDelete: SetNull)
  extractions  TaxDocumentExtraction[]
  logs         TaxDocumentProcessingLog[]

  @@index([contentHash])
  @@index([guideId])
  @@index([requestId])
  @@index([portalClientId])
  @@map("documents")
}

model TaxDocumentExtraction {
  id           String   @id @default(uuid())
  documentId   String
  success      Boolean
  parserSource String?
  documentType String?
  payload      Json?
  confidence   Float?
  warnings     Json?
  rawText      String?  @db.Text
  createdAt    DateTime @default(now())

  document TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_extractions")
}

// ==========================
// Lançamentos Contábeis
// ==========================

model ChartOfAccount {
  id             String @id @default(uuid())
  portalClientId String? // null = conta global (compartilhada por todas as empresas)
  codigo         String // código reduzido, ex: "5", "464"
  nome           String
  /// A "CONTA MÃE" — o código COMPLETO do ERP, ex: "111010001" para o reduzido "5" (CAIXA - MATRIZ).
  ///
  /// ⚠ NÃO é identidade. Quem identifica a conta é `codigo` (o reduzido): `AccountingEntryLine.conta`
  /// o guarda como TEXTO, sem FK, então trocar o reduzido orfanaria todo lançamento existente sem
  /// erro nenhum na tela. Este campo existe para ANÁLISE — é dele que sai `analitica`.
  ///
  /// ⚠ Só aparece para o usuário no CADASTRO do plano de contas. Na tela de digitar lançamento o
  /// contador continua vendo apenas o reduzido (decisão do dono).
  ///
  /// ⚠ Nullable e SEM default: conta que ainda não foi reimportada não tem código completo, e
  /// inventar um seria fabricar hierarquia.
  codigoCompleto String?
  /// Derivado de `codigoCompleto` por `lib/derivacaoAnalitica.js`: `false` = SINTÉTICA (existe outro
  /// código completo, mais longo, começando com o dela — é conta de agregação).
  ///
  /// ⚠ TRI-ESTADO, e o `null` é o ponto: conta sem `codigoCompleto` não tem resposta, e `false`
  /// afirmaria que ela é sintética. **Ausência nunca é resposta.**
  analitica      Boolean?
  tipo           String // ATIVO | PASSIVO | RECEITA | DESPESA | PATRIMONIO
  natureza       String   @default("DEVEDORA") // DEVEDORA | CREDORA
  status         String   @default("CONFIRMADA") // CONFIRMADA | PENDENTE_ERP
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, codigo])
  @@index([portalClientId])
  @@index([portalClientId, status])
  @@map("chart_of_accounts")
}

model AccountingEntry {
  id                    String    @id @default(uuid())
  portalClientId        String
  circularId            String?
  ruleId                String?
  sourceGuideId         String? // Guide que originou esta provisão (DARFs, INSS, etc.) — null para entries manuais
  eventType             String?
  data                  DateTime
  competencia           String
  historico             String
  /// TEXTO CRU DO ARQUIVO IMPORTADO (descrição da planilha Excel), preservado ao lado do histórico.
  ///
  /// ⚠ Existe porque o import de Excel gravava `historico: descricao` — o texto do arquivo entrava
  /// no razão COMO SE FOSSE o histórico contábil, e a descrição original deixava de existir. São
  /// dois fatos diferentes: um é o que o banco/planilha escreveu, o outro é o que o contador
  /// lança. O OFX já os separa na tela desde sempre; aqui a separação não tinha onde morar.
  ///
  /// ⚠ NULLABLE E SEM BACKFILL: lançamento anterior à coluna fica `null`, que é a verdade —
  /// ninguém sabe qual era a descrição do arquivo dele. Preencher com o `historico` atual
  /// inventaria uma procedência.
  descricaoImportacao   String?
  tipo                  String    @default("DESPESA") // DESPESA | RECEITA | FOLHA | PROVISAO | BAIXA | OUTRO
  subtipo               String? // SIMPLES | IRRF | ISS | PIS | COFINS | FGTS | null
  origem                String    @default("MANUAL") // MANUAL | OFX | PDF | SERPRO
  loteImportacao        String?
  status                String    @default("RASCUNHO") // RASCUNHO | CONFIRMADO | EXPORTADO
  statusPagamento       String    @default("NA") // NA | ABERTO | PAGO
  openEntryId           String?
  recalculatedAt        DateTime?
  recalculatedFromValor Decimal?  @db.Decimal(18, 2)
  recalculatedToValor   Decimal?  @db.Decimal(18, 2)
  recalculatedNotes     String?
  // Q9: vínculo opcional pra entries que são parcelas de um Parcelamento.
  // numeroParcela=null para a entry de ABERTURA e para entries de RESCISÃO.
  parcelamentoId        String?
  numeroParcela         Int?
  // Papel da linha DENORMALIZADO do `AccountingEntryLine` (que já os tem, Q21). Existem para dar ao
  // banco uma chave que SEPARA os N lançamentos legítimos de uma mesma baixa e REPETE na duplicada
  // — ver migration `20260808120000_add_baixa_tipo_linha`.
  // PRINCIPAL | PARC | JUROS | MULTA | CAIXA | CONTRAPARTIDA | TOTAL (TOTAL = lançamento inteiro,
  // sem decomposição por papel: baixa digitada à mão, importada ou vinda de função).
  tipoLinha             String?
  codigoTributo         String?
  /// CONTRA-LANÇAMENTO DE ESTORNO: a baixa (em mês FECHADO) que este lançamento espelha invertida.
  ///
  /// ⚠ Preenchido SÓ em lançamentos `tipo:"ESTORNO"`, e é ele que faz `computeSaldoProvisao`
  /// SUBTRAIR em vez de somar. Sem FK de propósito — ver a migration `20260808150000_add_estorno_baixa`.
  estornoDeEntryId      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  lines                AccountingEntryLine[]
  portalClient         PortalClient            @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  circular             CompanyMonthlyCircular? @relation(fields: [circularId], references: [id], onDelete: SetNull)
  rule                 AccountingEntryRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  sourceGuide          Guide?                  @relation("GuideToEntries", fields: [sourceGuideId], references: [id], onDelete: SetNull)
  openEntry            AccountingEntry?        @relation("BaixaToOpen", fields: [openEntryId], references: [id], onDelete: SetNull)
  baixas               AccountingEntry[]       @relation("BaixaToOpen")
  parcelamento         Parcelamento?           @relation("ParcelamentoParcelas", fields: [parcelamentoId], references: [id], onDelete: SetNull)
  parcelamentoAbertura Parcelamento?           @relation("ParcAberturaEntry")
  estornosQueEspelha   EstornoBaixa[]          @relation("EstornoContraLancamento")

  // ⚠ O UNIQUE DE COMPETÊNCIA SAIU DAQUI E VIROU ÍNDICE PARCIAL EM SQL — ele NÃO desapareceu.
  // Vive na migration `20260818160000_unique_competencia_nao_morde_baixa`, com o mesmo nome:
  //   UNIQUE accounting_entries_portalClientId_competencia_eventType_ori_key
  //        : ("portalClientId","competencia","eventType","origem")  WHERE "tipo" <> 'BAIXA'
  //
  // O Prisma não modela unique PARCIAL, e o predicado é a correção: declarado aqui, ele voltaria a
  // ser TOTAL e a morder as baixas de novo.
  //
  // ⚠ ELE CONTINUA SENDO A ÚNICA TRAVA CONTRA PROVISÃO DUPLICADA VINDA DO EXTRATO.
  // `AccountingEntryGeneratorService.generateEntriesFromCircular` faz check-then-act sobre esta
  // tupla exata (`findFirst({portalClientId, competencia, eventType, origem:"SERPRO"})` → `create`)
  // e este índice é o backstop atômico daquela janela. O `uniq_entry_per_guide_event` abaixo NÃO
  // cobre esse caminho: a provisão do DAS/Simples nasce do extrato, **sem `sourceGuideId`**, e no
  // Postgres NULLs são distintos em UNIQUE. Por isso ele virou parcial em vez de ser removido.
  //
  // ⚠ POR QUE AS BAIXAS SAÍRAM: `POST /entries/:id/baixa` grava o principal com a competência da
  // DATA DO PAGAMENTO + `eventType` + `origem:"MANUAL"` — e nada nessa tupla diz QUAL provisão está
  // sendo quitada. Baixa sem comprovante usa HOJE, então toda provisão em atraso mirava a
  // competência corrente: a 1ª passava, a 2ª estourava P2002 → 500 `internal_error`. Medido em
  // produção (18/08/2026): 16 empresas nesse estado. Ele também recusava a 2ª QUOTA de uma baixa
  // parcial no mesmo mês, que é fluxo legítimo da mesma rota.
  //
  // ⚠ Nenhum código usa a chave composta gerada pelo Prisma
  // (`portalClientId_competencia_eventType_origem`) — zero ocorrências em `apps/`. Não havia
  // `upsert` a reescrever; removê-la da declaração não quebra chamador nenhum.
  //
  // ⚠ MANTIDO DE PROPÓSITO mesmo não mordendo as BAIXAS. Ele vale para as PROVISÕES, que é para
  // quem foi feito: `GuideToProvisionService` grava uma por tributo, cada uma com `eventType`
  // próprio, e faz a idempotência por ele (`where: { uniq_entry_per_guide_event: ... }`). Removê-lo
  // tiraria a única trava contra provisão duplicada por guia e quebraria aquele upsert.
  @@unique([sourceGuideId, eventType], name: "uniq_entry_per_guide_event")
  // ⚠ NÃO DECLARÁVEIS AQUI (o Prisma não modela CHECK nem índice por EXPRESSÃO) — vivem só no SQL
  // da migration `20260808120000_add_baixa_tipo_linha`:
  //   CHECK  chk_baixa_tipo_linha : tipo <> 'BAIXA' OR "tipoLinha" IS NOT NULL
  //   UNIQUE uq_baixa_guia_linha  : ("sourceGuideId","tipoLinha",COALESCE("codigoTributo",''))
  //                                 WHERE tipo='BAIXA' AND "sourceGuideId" IS NOT NULL
  //                                                    AND "tipoLinha" IS NOT NULL
  // NÃO transformar o unique em `@@unique([sourceGuideId, tipoLinha, codigoTributo])`: sem o
  // COALESCE os NULLs voltam a ser distintos e a duplicata passa — é a armadilha que ele fecha.
  //
  // E a OUTRA METADE da mesma regra, na migration `20260809170000_add_uq_baixa_parcela_linha`:
  //   UNIQUE uq_baixa_parcela_linha : ("parcelamentoId","numeroParcela","tipoLinha",
  //                                    COALESCE("codigoTributo",''))
  //                                   WHERE tipo='BAIXA' AND "sourceGuideId" IS NULL
  //                                     AND "parcelamentoId"/"numeroParcela"/"tipoLinha" NOT NULL
  // ⚠ São DUAS metades porque a âncora da baixa é DUAS: guia (quem tem documento) e prestação
  // (débito automático, que não emite nenhum). O de cima é parcial em `sourceGuideId IS NOT NULL` e
  // por isso NÃO alcança a baixa sem guia — foi essa lacuna que este segundo fecha. Quem criar uma
  // terceira via de baixa precisa de um terceiro, ou nasce sem cinto de banco.
  @@index([portalClientId])
  @@index([portalClientId, competencia])
  @@index([portalClientId, tipo])
  @@index([portalClientId, status])
  @@index([portalClientId, statusPagamento])
  @@index([portalClientId, subtipo])
  @@index([portalClientId, eventType])
  @@index([circularId])
  @@index([ruleId])
  @@index([sourceGuideId])
  @@index([parcelamentoId])
  @@index([estornoDeEntryId])
  @@map("accounting_entries")
}

/// AUDITORIA DO ESTORNO DE BAIXA — quem desfez, quando e POR QUÊ.
///
/// ⚠ POR QUE NÃO SÃO COLUNAS NO LANÇAMENTO. No mês ABERTO o estorno APAGA os lançamentos de baixa.
/// Auditoria gravada na linha apagada some junto com o fato que deveria explicar, e "quem desfez
/// esta baixa?" é justamente a pergunta que se faz meses depois, quando o lançamento já não existe.
///
/// ⚠ `motivo` é NOT NULL **e** tem CHECK de tamanho mínimo no banco. A rota recusa antes, com
/// mensagem legível; o CHECK é o que garante que nenhum caminho de escrita futuro grave um estorno
/// mudo — a mesma disciplina do `chk_baixa_tipo_linha`.
///
/// Os campos `*Original` são CÓPIA, não referência: o registro tem de continuar legível depois de a
/// linha original desaparecer. Por isso `entryIdOriginal` é texto sem FK.
model EstornoBaixa {
  id                  String   @id @default(uuid())
  portalClientId      String

  // O que foi desfeito (cópia imutável)
  entryIdOriginal     String
  competenciaOriginal String
  historicoOriginal   String
  valorOriginal       Decimal  @db.Decimal(18, 2)
  tipoLinha           String?
  codigoTributo       String?
  guideId             String?
  parcelamentoId      String?
  openEntryId         String?

  /// DELECAO (mês aberto: o lançamento foi apagado) | CONTRA_LANCAMENTO (mês fechado: o lançamento
  /// FICA e nasce um espelho invertido `tipo:"ESTORNO"` na competência aberta).
  modo                String
  contraLancamentoId  String?
  competenciaContra   String?

  motivo              String
  estornadoPorUserId  String?
  estornadoEm         DateTime @default(now())

  /// Rastro da transição administrativa (parcelaStateMachine.js): ... → ESTORNADA.
  parcelaEstadoAnterior String?
  parcelaEstadoNovo     String?
  /// Recálculo disparado logo após o estorno (riscoRescisao.js) — o número que justificava a
  /// urgência, ou a falta dela, no momento da decisão.
  riscoNivel            String?
  riscoEmAtraso         Int?

  createdAt DateTime @default(now())

  portalClient     PortalClient     @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  contraLancamento AccountingEntry? @relation("EstornoContraLancamento", fields: [contraLancamentoId], references: [id], onDelete: SetNull)

  // ⚠ NÃO DECLARÁVEIS AQUI (o Prisma não modela CHECK) — vivem só no SQL da migration
  // `20260808150000_add_estorno_baixa`:
  //   CHECK chk_estorno_motivo : length(btrim("motivo")) >= 5
  //   CHECK chk_estorno_modo   : "modo" IN ('DELECAO','CONTRA_LANCAMENTO')
  @@index([portalClientId])
  @@index([guideId])
  @@index([entryIdOriginal])
  @@map("estornos_baixa")
}

/// AUDITORIA DOS ATOS ADMINISTRATIVOS DO CONTRATO — excluir o parcelamento, desfazer a rescisão.
///
/// ⚠ MESMO DESENHO DE `estornos_baixa`, E PELO MESMO MOTIVO: no modo DELECAO as linhas que este
/// registro explica DEIXAM DE EXISTIR (inclusive a própria linha de `parcelamentos`), então a
/// auditoria não pode morar nelas. Todo campo `*Original` é CÓPIA, não referência — é o que mantém o
/// registro legível sozinho seis meses depois, quando alguém perguntar "cadê o parcelamento nº 3?".
///
/// ⚠ `parcelamentoId` é TEXTO SEM FK, de propósito. O contrato que ele identifica normalmente não
/// existe mais; uma FK com SET NULL zeraria justamente o dado que dá sentido ao registro, e uma com
/// RESTRICT impediria a exclusão de acontecer. Mesma decisão de `EstornoBaixa.entryIdOriginal`.
///
/// ⚠ `motivo` é NOT NULL **e** tem CHECK de tamanho no banco: é ele que transforma "apagou" em
/// "decidiu e assinou", e o CHECK garante que nenhum caminho de escrita futuro grave um ato mudo.
model AtoParcelamento {
  id             String @id @default(uuid())
  portalClientId String
  /// Sem FK — ver o comentário acima.
  parcelamentoId String

  /// EXCLUSAO | RESCISAO_DESFEITA (CHECK no banco).
  ato String

  // ── O CONTRATO, COMO ELE ERA (cópia imutável) ─────────────────────────────────────────────
  labelOriginal              String
  tipoOriginal               String?
  numeroParcelamentoOriginal String?
  statusOriginal             String
  competenciaInicial         String?
  totalValueOriginal         Decimal? @db.Decimal(18, 2)

  // ── O QUE FOI DESFEITO, EM NÚMEROS ────────────────────────────────────────────────────────
  /// Os mesmos números que a confirmação mostrou ao contador. Guardá-los é o que permite conferir
  /// depois se o que ele viu foi o que aconteceu.
  prestacoesRemovidas      Int      @default(0)
  prestacoesQuitadas       Int      @default(0)
  guiasDesvinculadas       Int      @default(0)
  lancamentosApagados      Int      @default(0)
  lancamentosPreservados   Int      @default(0)
  contraLancamentosCriados Int      @default(0)
  valorTotalDesfeito       Decimal  @default(0) @db.Decimal(18, 2)
  /// Lista separada por vírgula — as competências que estavam FECHADAS e por isso ganharam espelho.
  competenciasFechadas     String?

  /// DELECAO (nada em competência fechada: as linhas saíram) | CONTRA_LANCAMENTO (sobrou linha em
  /// mês fechado: ela FICA e nasce o espelho invertido na competência de hoje).
  modo              String
  competenciaContra String?
  /// ⚠ `false` quer dizer que a linha de `parcelamentos` SOBREVIVEU, com `status="EXCLUIDO"`. Ela é
  /// a âncora do grupo que `computeFechamentoBlockers` usa para somar D/C dos lançamentos de uma
  /// perna só; apagá-la travaria o fechamento do mês. Ver `AtosParcelamentoService.js`.
  cabecalhoRemovido Boolean @default(false)

  motivo             String
  executadoPorUserId String?
  executadoEm        DateTime @default(now())

  /// Risco de rescisão logo APÓS o ato (só faz sentido no `RESCISAO_DESFEITA`: é o contrato que
  /// volta a existir, e ele pode voltar já rescindível).
  riscoNivel    String?
  riscoEmAtraso Int?

  /// A cópia item a item do que saiu (lançamentos e guias). No modo DELECAO é a única coisa que
  /// resta deles.
  detalhe Json?

  createdAt DateTime @default(now())

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  // ⚠ NÃO DECLARÁVEIS AQUI (o Prisma não modela CHECK) — vivem só no SQL da migration
  // `20260810160000_add_atos_parcelamento`:
  //   CHECK chk_ato_parc_motivo : length(btrim("motivo")) >= 5
  //   CHECK chk_ato_parc_modo   : "modo" IN ('DELECAO','CONTRA_LANCAMENTO')
  //   CHECK chk_ato_parc_ato    : "ato"  IN ('EXCLUSAO','RESCISAO_DESFEITA')
  @@index([portalClientId])
  @@index([parcelamentoId])
  @@index([ato])
  @@map("atos_parcelamento")
}

model CompanyMonthlyCircular {
  id                          String    @id @default(uuid())
  portalClientId              String
  competencia                 String
  receitaBruta                Decimal?  @db.Decimal(18, 2)
  receitaServicos             Decimal   @default(0) @db.Decimal(18, 2)
  receitaVendas               Decimal   @default(0) @db.Decimal(18, 2) // total (= semST + comST)
  receitaVendasSemST          Decimal   @default(0) @db.Decimal(18, 2) // Vendas sem substituição tributária
  receitaVendasComST          Decimal   @default(0) @db.Decimal(18, 2) // Vendas com substituição tributária (ICMS-ST)
  dasTotal                    Decimal?  @db.Decimal(18, 2)
  dasNumeroDocumento          String?
  dasPago                     Boolean?
  dasDataEmissao              DateTime?
  inssTotal                   Decimal?  @db.Decimal(18, 2)
  inssVencimento              DateTime?
  inssPdfFileId               String?
  inssPdfUrl                  String?
  inssStatus                  String?
  pgdasNumeroDeclaracao       String?
  pgdasDeclaracaoFileId       String?
  pgdasDeclaracaoFileUrl      String?
  pgdasReciboFileId           String?
  pgdasReciboFileUrl          String?
  receitaStatus               String?
  dasStatus                   String?
  serproSyncStatus            String?
  serproLastSyncAt            DateTime?
  serproLastError             String?
  metadata                    Json?
  // Módulo Fiscal (Frente B): valor ORIGINAL × ACRÉSCIMO (juros/multa) por tributo.
  // { <tributo>: { principal, juros, multa } } — tributo ∈ {DAS, INSS, PIS, COFINS, IRPJ, CSLL, ISS}.
  // total = principal+juros+multa (derivado). Preenchido no recálculo; editável pelo contador.
  acrescimos                  Json?
  hasAccountingDivergence     Boolean   @default(false)
  accountingDivergenceMessage String?
  // Q12.A: máquina de estados por (empresa, competência) do módulo Notas
  estado                      String    @default("aberto")
  // aberto | em_conferencia | fechado | calculado | revisado | transmitido | confirmado | erro
  lockedAt                    DateTime? // quando virou "fechado"
  lockedByUserId              String?
  reopenedAt                  DateTime?
  reopenedByUserId            String?
  reopenedReason              String?
  fs12Manual                  Decimal?  @db.Decimal(18, 2) // Q12.C: FS12 digitado pelo contador
  fs12Origem                  String? // MANUAL | ESOCIAL (futuro)
  fatorR                      Decimal?  @db.Decimal(6, 4) // 0.28 = 28%
  rb12                        Decimal?  @db.Decimal(18, 2) // soma móvel 12m
  // Q17: fechamento CONTÁBIL do mês (distinto do `estado` da apuração/notas).
  // Setado quando o contador fecha a empresa após lançar tudo; null = aberta.
  fechadoContabilEm           DateTime?
  fechadoContabilPor          String?
  // Q47: contador confirma que a folha/pró-labore do mês foi lançada. Trava o fechamento contábil
  // enquanto não marcada (null/false). Por competência.
  folhaProlaboreOk            Boolean?
  // Checklist de conferência do mês (mesma regra da folha: trava o fechamento até marcar).
  // Cada uma é uma confirmação MANUAL do contador — o sistema não tem como saber se "todas as
  // despesas do mês entraram", só quem lançou sabe.
  despesasOk                  Boolean?
  receitasOk                  Boolean?
  provisoesOk                 Boolean?
  pagamentosOk                Boolean?
  /// O mês NÃO TEVE FATURAMENTO. Afirma só isso: folha, despesas e parcelas seguem normais e
  /// continuam a ser lançadas e conferidas. Tri-estado como o checklist acima — `null` significa
  /// "ninguém disse nada", que é diferente de "disseram que teve".
  ///
  /// É uma afirmação FISCAL, não uma preferência de tela: por isso quem e quando ficam gravados.
  /// O sistema RECUSA marcar quando existe nota EMIT autorizada na competência — vira confirmação
  /// do que ele já enxerga, nunca uma declaração cega contra a evidência.
  semFaturamento              Boolean?
  semFaturamentoEm            DateTime?
  semFaturamentoPor           String?
  /// COMO a afirmação foi verificada contra o ADN no momento em que foi feita:
  /// `"ok"` (conferimos e bateu) · `"nao_conferivel"` (município fora do ADN, sem certificado)
  /// · `"sem_conferencia"` (nunca conferida).
  ///
  /// Existe porque "faturamento zero" e "não conseguimos ver o faturamento" se parecem no banco e
  /// significam coisas opostas. Município fora do ADN, A1 vencido ou cursor NSU travado devolvem
  /// zero sem que ninguém tenha provado ausência de receita — bloquear aí inutilizaria o campo
  /// justamente nessas empresas, então o sistema aceita e REGISTRA que aceitou sem conferir.
  /// Conferência `"divergente"` (o ADN tem nota que nós não temos) é o único caso que RECUSA.
  semFaturamentoConferencia   String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  portalClient      PortalClient      @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  accountingEntries AccountingEntry[]

  @@unique([portalClientId, competencia])
  @@index([portalClientId, competencia])
  @@index([portalClientId, estado])
  @@map("company_monthly_circulars")
}

model AccountingEntryRule {
  id                  String   @id @default(uuid())
  portalClientId      String?
  scope               String   @default("GLOBAL") // GLOBAL | COMPANY
  eventType           String
  descriptionTemplate String
  debitAccountCode    String
  creditAccountCode   String
  amountSource        String
  entryDateStrategy   String   @default("LAST_DAY_OF_MONTH")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  portalClient      PortalClient?     @relation(fields: [portalClientId], references: [id], onDelete: SetNull)
  accountingEntries AccountingEntry[]

  @@index([portalClientId, eventType])
  @@index([scope, eventType, isActive])
  @@index([eventType, isActive])
  @@map("accounting_entry_rules")
}

model AccountingEntryLine {
  id            String  @id @default(uuid())
  entryId       String
  conta         String
  tipo          String // D | C
  valor         Decimal @db.Decimal(18, 2)
  ordem         Int     @default(0)
  historico     String? // Histórico opcional por linha (ex: pró-labore tem histórico distinto por D/C)
  // Q21: papel da linha em lançamentos de parcelamento + tributo (aprendizado por tributo)
  tipoLinha     String? // PARC_DAS | JUROS | MULTA | TOTAL
  codigoTributo String?

  entry AccountingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("accounting_entry_lines")
}

model AccountingHistorico {
  id                    String   @id @default(uuid())
  createdByUserId       String
  companyPortalClientId String? // null = global para este usuário; preenchido = específico da empresa
  text                  String // chave de match: descrição original (memo OFX ou descrição da planilha)
  historicoSugerido     String? // histórico digitado pelo contador (OFX); separa "descrição do banco" de "histórico contábil"
  contaDebito           String?
  contaCredito          String?
  eventType             String? // RECEITA_SERVICO|RECEITA_VENDA_SEM_ST|RECEITA_VENDA_COM_ST|DAS_SIMPLES|... — memória do par D/C para entries automáticos
  usageCount            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([createdByUserId, companyPortalClientId])
  @@index([createdByUserId, contaDebito])
  @@index([createdByUserId, contaCredito])
  @@index([companyPortalClientId, eventType])
  @@map("accounting_historicos")
}

// Função de Lançamento: template reutilizável para múltiplos entries.
// Contador define nome, lista de entries com contas D/C e histórico (placeholders).
// Ao "Aplicar função", contador preenche apenas valores; sistema cria os N entries.
model AccountingFunction {
  id              String   @id @default(uuid())
  portalClientId  String? // null = GLOBAL (vale pra qualquer empresa); preenchido = só esta
  name            String
  description     String?
  isSystem        Boolean  @default(false) // true = template de sistema (não editável/deletável)
  // Q9: tipo de função — STANDARD (templates normais Q6) ou variantes de parcelamento.
  kind            String   @default("STANDARD") // STANDARD | PARCELAMENTO_OPENING | PARCELAMENTO_PAYMENT | PARCELAMENTO_RESCISION
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries                  AccountingFunctionEntry[]
  portalClient             PortalClient?             @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  parcelamentosAsOpening   Parcelamento[]            @relation("ParcOpeningTemplate")
  parcelamentosAsPayment   Parcelamento[]            @relation("ParcPaymentTemplate")
  parcelamentosAsRescision Parcelamento[]            @relation("ParcRescisionTemplate")

  @@index([portalClientId])
  @@index([isSystem])
  @@index([kind])
  @@map("accounting_functions")
}

model AccountingFunctionEntry {
  id         String  @id @default(uuid())
  functionId String
  ordem      Int     @default(0)
  historico  String // template (tokens {{competencia}}, {{companyName}}, {{cnpj}})
  tipo       String // DESPESA | PROVISAO | RECEITA | etc.
  subtipo    String?

  lines    AccountingFunctionLine[]
  function AccountingFunction       @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@index([functionId])
  @@map("accounting_function_entries")
}

model AccountingFunctionLine {
  id              String @id @default(uuid())
  functionEntryId String
  conta           String // código da conta (D ou C)
  tipo            String // D | C
  ordem           Int    @default(0)

  functionEntry AccountingFunctionEntry @relation(fields: [functionEntryId], references: [id], onDelete: Cascade)

  @@index([functionEntryId])
  @@map("accounting_function_lines")
}

// Q9: cabeçalho de Parcelamento (Simples Nacional, INSS, DARF, etc).
// Cada Parcelamento tem 1 entry de ABERTURA + N entries de provisão (1 por parcela)
// + 1 entry opcional de RESCISÃO (quando rescindido).
// Guides são linkadas opcionalmente quando contador sobe DARF mensal do parcelamento.
model Parcelamento {
  id             String @id @default(uuid())
  portalClientId String
  label          String // ex: "RE-PARCELAMENTO SIMPLES NACIONAL DE SET/OUT/2024..."
  kind           String // SIMPLES | INSS | DARF | OUTRO

  // Q21 (spec v2): modalidade oficial + número do parcelamento (RFB/SERPRO)
  tipo                   String? // PARCSN|PARCSN_ESPECIAL|PERT_SN|RELP_SN|PARCMEI|PARCMEI_ESPECIAL|PERT_MEI|RELP_MEI|OUTRO
  numeroParcelamento     String? // número oficial
  valorMulta             Decimal?  @db.Decimal(18, 2) // multa consolidada
  valorParcelaReferencia Decimal?  @db.Decimal(18, 2) // valor nominal/contratado da parcela
  parcelaInicial         Int? // nº da 1ª parcela conhecida no sistema (suporta começar no meio)
  dataAdesao             DateTime?
  origem                 String    @default("MANUAL") // MANUAL | SERPRO
  // Q28 Fase 4: grupo do parcelamento. sn_mei = Simples/MEI (integra SERPRO); outros = PGFN/estadual/
  // municipal (100% manual, nunca chama SERPRO). Derivado do `tipo` quando não informado.
  grupo                  String? // sn_mei | outros

  // Templates (3 kinds em AccountingFunction): abertura, pagamento da parcela, rescisão
  templateOpeningFunctionId   String?

  /// ⚠ MORTO — NÃO ESCREVER, NÃO LER. Aguardando DROP em migration própria.
  ///
  /// O único LEITOR era `ParcelamentoService.confirmParcelaPayment`, a segunda porta de "dar baixa
  /// numa parcela" (pelo template, em vez do comprovante), removida na F2.3 junto com a rota órfã
  /// `POST /parcelamentos/:parcId/parcelas/:num/pagar`. A partir daí o campo era WRITE-ONLY:
  /// `createParcelamento` gravava um ponteiro que ninguém seguia. A ESCRITA saiu agora — a coluna
  /// não recebe valor novo desde então, e `listParcelamentos` deixou de carregar a relação.
  ///
  /// ⚠ A COLUNA E A FK CONTINUAM AQUI DE PROPÓSITO. Decisão do dono: o drop é uma migration
  /// SEPARADA, depois de o deploy desta limpeza estabilizar — uma migration pendente a mais na
  /// mesma janela já é risco suficiente. Quem for dropar: remover ESTE campo, a relação
  /// `templatePayment` abaixo e o lado `ParcPaymentTemplate` em `AccountingFunction`.
  ///
  /// ⚠ Isto NÃO condena os seeds `AccountingFunction kind="PARCELAMENTO_PAYMENT"`
  /// (`ParcelamentoSeeds.js`): eles seguem servidos na lista de funções de lançamento e podem ser
  /// aplicados à mão pelo contador (`applyAccountingFunction`). O que morreu foi o PONTEIRO daqui
  /// para eles, não os templates.
  templatePaymentFunctionId   String?
  templateRescisionFunctionId String?

  // Estrutura financeira
  numEntradas         Int      @default(0) // quantas das primeiras parcelas são "entrada"
  numParcelas         Int // total inclui entradas (ex: 52 = 1 entrada + 51)
  principalPerParcela Decimal  @db.Decimal(18, 2)
  principalTotal      Decimal? @db.Decimal(18, 2)
  jurosTotal          Decimal? @db.Decimal(18, 2)
  totalValue          Decimal  @db.Decimal(18, 2)

  // Calendário
  dataAbertura          DateTime?
  competenciaInicial    String // YYYY-MM da 1ª parcela
  diaPagamento          Int       @default(1)
  periodosReferenciados String?

  /// F2.3 — COMO O CONTRIBUINTE PAGA ESTE CONTRATO: `DEBITO_AUTOMATICO` | `GUIA_MENSAL`.
  ///
  /// ⚠ NULO É O TERCEIRO ESTADO, E É O DEFAULT DE PROPÓSITO: "ninguém declarou ainda". Não há
  /// default não-nulo porque carimbar um dos dois valores nos contratos que já existem seria
  /// AFIRMAR um fato do mundo real que ninguém informou (regra 1) — e é justamente a forma de
  /// pagamento que decide se a ausência de guia é normal ou é documento faltando. Mesma disciplina
  /// de `CompanyMonthlyCircular.semFaturamento` (tri-estado) e de `verificadoTrial`.
  ///
  /// ⚠ ELE NÃO ALIMENTA O RISCO DE RESCISÃO, e isso é decisão, não pendência. Hoje o sistema
  /// INFERE débito automático pela ausência de guia (`temEvidenciaDePagamento`), e prestação sem
  /// evidência fica FORA do cálculo — nem quitada, nem inadimplida. Fazer `GUIA_MENSAL` transformar
  /// "sem guia" em "em atraso" derivaria inadimplência de ausência de dado, exatamente o que
  /// `recalculoParcelamento.js` se recusa a fazer. Este campo troca INFERÊNCIA por DECLARAÇÃO
  /// (exibida, conferível); quem decide atraso continua sendo evidência de pagamento.
  formaPagamento String? // DEBITO_AUTOMATICO | GUIA_MENSAL | null (não declarado)

  /// F2.3 — SALDO DEVEDOR CONSOLIDADO DECLARADO (informativo, na data em que foi informado).
  ///
  /// ⚠ ELE **NÃO** ALIMENTA LANÇAMENTO NENHUM. NUNCA. Não vira provisão, não vira baixa, não entra
  /// em `linhasProvisao`. A provisão da adesão reconhece **só o principal** (`principalTotal`) —
  /// decisão do dono, e o motivo está escrito em `ParcelamentoV2Service.linhasProvisao`: creditar o
  /// consolidado reconhecia o encargo DUAS VEZES (uma na adesão, outra a cada parcela paga) e
  /// deixava resíduo permanente em "Parcelamento a Pagar", com o contrato já quitado.
  /// Este campo existe para EXIBIR e para CONFERIR contra o extrato do SERPRO. Quem o ligar a um
  /// lançamento reabre aquele defeito.
  saldoConsolidado Decimal? @db.Decimal(18, 2)

  // Q28 Fase 1: configuração de lançamento POR PARCELAMENTO (papéis/contas), independente entre
  // PROVISÃO e PAGAMENTO. Cada uma = lista de linhas { papel, tipo (D|C), conta }. Quando nula, o
  // sistema usa os papéis padrão + MapaContaTributo (memória). Editável pela Circular/aba Guias (Fase 2).
  configProvisao  Json?
  configPagamento Json?

  status          String   @default("ATIVO") // ATIVO | QUITADO | RESCINDIDO
  observacoes     String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // FK 1:1 pra entry de abertura
  aberturaEntryId String?          @unique
  aberturaEntry   AccountingEntry? @relation("ParcAberturaEntry", fields: [aberturaEntryId], references: [id], onDelete: SetNull)

  portalClient      PortalClient        @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  templateOpening   AccountingFunction? @relation("ParcOpeningTemplate", fields: [templateOpeningFunctionId], references: [id], onDelete: SetNull)
  /// ⚠ Relação do campo MORTO `templatePaymentFunctionId` (ver o comentário lá em cima). Sem
  /// leitor: sai junto no DROP.
  templatePayment   AccountingFunction? @relation("ParcPaymentTemplate", fields: [templatePaymentFunctionId], references: [id], onDelete: SetNull)
  templateRescision AccountingFunction? @relation("ParcRescisionTemplate", fields: [templateRescisionFunctionId], references: [id], onDelete: SetNull)
  parcelas          AccountingEntry[]   @relation("ParcelamentoParcelas")
  guides            Guide[]             @relation("GuideParcelamento")

  /// F2.1: as PARCELAS do contrato, como linhas próprias. Ver `model Parcela`.
  /// ⚠ Nome diferente de `parcelas` de propósito — aquele campo é `AccountingEntry[]` (as linhas
  /// leves `tipo="PARCELA"` do V1) e é lido pela tela. Renomeá-lo trocaria o significado de um
  /// campo já servido pela API.
  parcelasContratadas Parcela[] @relation("ParcelamentoParcelasContratadas")

  // Q21: vínculo determinístico — impede cabeçalho duplicado (parcial WHERE numeroParcelamento NOT NULL via SQL).
  @@unique([portalClientId, tipo, numeroParcelamento])
  @@index([portalClientId, status])
  @@index([portalClientId, kind])
  @@map("parcelamentos")
}

// F2.1 — A PARCELA COMO ENTIDADE. Até aqui uma parcela ERA uma `Guide` com `parcelamentoId`, e o
// módulo inteiro derivava estado disso: contadores, risco de rescisão, fila de pendentes, fila de
// conferência e recálculo de atraso varriam `guides`.
//
// ⚠ O DEFEITO QUE ISSO FECHA: parcela sem guia não existia. Um parcelamento em DÉBITO AUTOMÁTICO —
// onde não há guia nenhuma, por definição — aparecia como "0 de 0", e o alerta de rescisão saía
// como não avaliável. O contador via um acordo de 52 prestações reportado como vazio.
//
// ⚠ E O QUE ELA **NÃO** FAZ: não duplica o estado de PAGAMENTO. Enquanto o caminho de baixa for
// por guia (`gerarPagamentoParcelaFromGuide` exige `guideId` na assinatura, na guarda de
// idempotência e no efeito colateral), quem responde "esta prestação foi quitada?" continua sendo
// a GUIA. Copiar `baixada`/`paymentStatus` para cá criaria duas respostas para a mesma pergunta e
// elas divergiriam no primeiro estorno. Aqui mora o CONTRATO (quais prestações existem, quando
// vencem); lá mora o FATO (foi paga).
model Parcela {
  id             String @id @default(uuid())
  parcelamentoId String
  /// Denormalizado do parcelamento: as varreduras da carteira filtram por empresa sem join.
  portalClientId String

  /// ⚠ NULO É CASO REAL, não descuido: `normalizeParcelaDTO` aceita `numeroParcela: null`, e existe
  /// guia vinculada a parcelamento sem número. Ela ganha linha própria (chaveada por `guiaId`) em
  /// vez de ficar de fora — guia é evidência, e evidência não se descarta por falta de rótulo.
  numeroParcela Int?

  /// Calendário CONTRATADO (derivado de `competenciaInicial` + `diaPagamento`, a mesma conta que
  /// `createParcelamento` já faz para as linhas leves do V1). É PLANO, não fato: quando há guia, o
  /// vencimento real é o dela, e quem lê resolve `guia.vencimento ?? parcela.vencimento`.
  competencia   String? // YYYY-MM
  anoMesParcela String? // YYYYMM
  vencimento    DateTime?
  valorPrevisto Decimal?  @db.Decimal(18, 2)

  /// A guia que materializou esta parcela — OPCIONAL, e é esse "opcional" a razão da tabela existir.
  guiaId String? @unique

  /// F2.2 — a baixa SEM GUIA (débito automático). É o ponto onde se grava a evidência de quitação
  /// de uma parcela que nunca teve guia. `parcelaRowQuitada` já a lê, então gravar aqui muda UMA
  /// escrita, não as derivações.
  /// Enquanto for nulo e não houver guia, a parcela é "sem evidência" — nem quitada, nem inadimplida.
  ///
  /// F2.3 — `HISTORICO` entrou no VOCABULÁRIO (não é coluna nova, não precisou de migration):
  /// prestação quitada ANTES de o contrato entrar no sistema (parcelamento migrado de outra
  /// contabilidade). Ela é quitada para efeito de contagem e de risco, e **não gera
  /// `AccountingEntry`** — não houve pagamento NOSSO para lançar; a provisão da adesão também não
  /// existe para o período dela.
  /// ⚠ F2.5 — ESTE VOCABULÁRIO DEIXOU DE SER PROSA: ele vive em
  /// `application/accounting/ancoraBaixa.js` (`ORIGENS_BAIXA_PARCELA`), com a ÂNCORA de cada via, e
  /// é de lá que os escritores tiram o valor e que o teste de contrato do estorno itera. Origem
  /// acrescentada aqui e não lá é origem cujo estorno ninguém escreveu.
  origemBaixa String? // GUIA | DEBITO_AUTOMATICO | MANUAL | HISTORICO
  /// ⚠ QUANDO É `HISTORICO`, ISTO É A DATA DA DECLARAÇÃO, NÃO A DO PAGAMENTO. A data em que o
  /// contribuinte pagou uma parcela anterior à nossa entrada não é conhecida, e preenchê-la com o
  /// vencimento contratado (ou com "hoje" fingindo ser o pagamento) seria inventar dado.
  baixadaEm   DateTime?

  /// Como a linha nasceu: CONTRATO (materializada do cabeçalho) | GUIA (existe guia para ela).
  origem String @default("CONTRATO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcelamento Parcelamento @relation("ParcelamentoParcelasContratadas", fields: [parcelamentoId], references: [id], onDelete: Cascade)
  guia         Guide?       @relation("GuideParcela", fields: [guiaId], references: [id], onDelete: SetNull)

  /// Idempotência da materialização. ⚠ No Postgres NULLs são distintos em UNIQUE, então as linhas
  /// sem número não colidem entre si — o que as separa é o `guiaId` unique acima.
  @@unique([parcelamentoId, numeroParcela])
  @@index([parcelamentoId])
  @@index([portalClientId, parcelamentoId])
  @@map("parcelas")
}

// Q21 (spec v2): composição por tributo de uma guia de parcela.
// VEM ITEMIZADA (PDF/SERPRO) — juros LIDO, nunca derivado.
model TributoParcela {
  id              String   @id @default(uuid())
  guideId         String
  codigoTributo   String // ex: 1001 (IRPJ-SN), 1002 (CSLL)...
  nomeTributo     String?
  principal       Decimal  @db.Decimal(18, 2)
  multa           Decimal  @db.Decimal(18, 2)
  juros           Decimal  @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  verificadoTrial Boolean  @default(false) // false até confirmar payload SERPRO no sandbox
  rawPayload      Json?
  createdAt       DateTime @default(now())

  guide Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([guideId, codigoTributo])
  @@index([guideId])
  @@map("tributos_parcela")
}

// Q21 (spec v2): memória de conta por tributo (GLOBAL com override por cliente).
model MapaContaTributo {
  id               String   @id @default(uuid())
  portalClientId   String? // null = global; preenchido = override por cliente
  tipoParcelamento String // PARCSN | PARCMEI | ... (modalidade)
  tipoLinha        String // PARC_DAS | JUROS | MULTA | TOTAL
  codigoTributo    String? // tributo, quando a conta é por tributo
  contaId          String // código/conta aprendida
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([portalClientId, tipoParcelamento, tipoLinha, codigoTributo])
  @@index([portalClientId, tipoParcelamento])
  @@map("mapa_conta_tributo")
}

model TaxDocumentProcessingLog {
  id         String   @id @default(uuid())
  documentId String
  step       String
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())

  document TaxDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_processing_logs")
}

model FiscalExecutionLog {
  id             String    @id @default(cuid())
  portalClientId String
  competencia    String
  action         String // search_guides | check_payments | sync_inss
  status         String // running | completed | failed | skipped
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  durationMs     Int?

  guidesFound      Int?
  guidesCaptured   Int?
  guidesUpdated    Int?
  guidesChecked    Int?
  guidesPaid       Int?
  guidesOverdue    Int?
  guidesOpen       Int?
  circularUpdated  Boolean?
  entriesGenerated Int?

  errorCode    String?
  errorMessage String?
  skipReason   String?
  triggeredBy  String?

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, startedAt(sort: Desc)])
  @@index([portalClientId, competencia, action])
  @@map("fiscal_execution_logs")
}

/// TODA chamada ao SERPRO, registrada no ponto único por onde elas passam (`SerproHttpClient`).
///
/// As chamadas do Integra Contador são PAGAS e, até aqui, não havia como responder "quanto esta
/// empresa consumiu neste mês" nem impedir um laço defeituoso de queimar dezenas delas — foi o que
/// aconteceu com o ajuste de períodos da folha, que gastava até 14 consultas por clique sem
/// entregar resultado.
///
/// `cnpj` é o do CONTRIBUINTE (a empresa), extraído do próprio envelope `pedidoDados`, não passado
/// pelo chamador: assim nenhuma chamada nova escapa do registro por esquecimento.
/// `assinatura` é o hash do payload — é o que distingue "clicou de novo na mesma coisa" de "mudou
/// algo e recalculou", e sustenta o cooldown sem atrapalhar quem corrigiu um valor.
model SerproChamada {
  id             String   @id @default(cuid())
  cnpj           String // contribuinte, só dígitos; "" quando a chamada não tem contribuinte
  portalClientId String? // resolvido pelo CNPJ quando existe empresa cadastrada
  idSistema      String?
  idServico      String? // GERARDAS12, TRANSDECLARACAO11, CONSDECCOMPLETA33, …
  rota           String // /Emitir, /Declarar, /Consultar, /Apoiar
  assinatura     String // hash do payload
  status         String // ok | erro | recusada_cooldown | recusada_teto
  httpStatus     Int?
  erroCodigo     String?
  // ⚠ O código do SERPRO é GENÉRICO: 75 chamadas de um mês inteiro entraram como
  // `SERPRO_BUSINESS_ERROR` — 35% do orçamento pago, sem uma palavra sobre o motivo. Era a
  // rejeição de "período desnecessário" do laço de convergência, e descobrir isso exigiu cruzar
  // contagem por serviço com agrupamento por minuto. A mensagem responde a mesma pergunta com um
  // `groupBy`. Truncada em 300 caracteres: é diagnóstico, não arquivo.
  erroMensagem   String?
  duracaoMs      Int?
  origem         String? // rota/worker que disparou
  userId         String?
  forcado        Boolean  @default(false) // passou por cima de um teto, com quem e quando no log
  createdAt      DateTime @default(now())

  @@index([cnpj, createdAt(sort: Desc)])
  @@index([portalClientId, createdAt(sort: Desc)])
  @@index([idServico, createdAt(sort: Desc)])
  @@index([assinatura, createdAt(sort: Desc)])
  @@map("serpro_chamadas")
}

// Q12.A: itens de uma nota (NF-e ou NFS-e). Classificação por anexo SN vem em Q12.C.
model NotaItem {
  id             String       @id @default(uuid())
  notaId         String
  codigoServico  String? // LC116 (NFS-e)
  ncm            String? // NF-e
  cfop           String? // NF-e
  descricao      String?
  valor          Decimal      @db.Decimal(18, 2)
  // Q12.C [LEGADO]: classificação direta pra anexo via DeparaAnexo (semântica antiga)
  anexoResolvido String? // III | IV | V (Simples Nacional)
  sujeitoFatorR  Boolean      @default(false)
  // Q14.2: classificação nova baseada em RegraClassificacao (cadastro = autoridade)
  // Anexo passa a ser DERIVADO pelo motor mensal (Fator R muda III↔V).
  tipoReceita    TipoReceita? // null = ainda não classificado pela v2
  classificadoEm DateTime? // quando o ClassificadorService v2 processou
  flagST         Boolean      @default(false)
  flagMonofasico Boolean      @default(false)
  flagExportacao Boolean      @default(false)

  nota PortalInvoice @relation(fields: [notaId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@index([anexoResolvido])
  @@index([tipoReceita])
  // Q20: filtro de notas por atividade (CFOP / código de serviço LC116)
  @@index([cfop])
  @@index([codigoServico])
  @@map("nota_itens")
}

// Q12.A: notas que chegam em competência já fechada — não atualizam a base; viram pendência.
// Contador resolve reabrindo a competência (volta pra em_conferencia) OU marcando como ignorada.
model PendenciaPosFechamento {
  id                String    @id @default(uuid())
  portalClientId    String
  competencia       String // YYYY-MM
  notaId            String?
  motivo            String // "nota_retroativa" | "evento_retroativo" | ...
  observacoes       String?
  resolvida         Boolean   @default(false)
  resolvidaAt       DateTime?
  resolvidaByUserId String?
  createdAt         DateTime  @default(now())

  portalClient PortalClient   @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  nota         PortalInvoice? @relation(fields: [notaId], references: [id], onDelete: SetNull)

  @@index([portalClientId, competencia, resolvida])
  @@map("pendencias_pos_fechamento")
}

// Q12.A: procuração e-CAC do escritório pra atuar em nome da empresa em serviços externos
// (NFS-e, DFe, eSocial, Integra-SN). Permite resolver "qual cert usar" via CertResolver.
model Procuracao {
  id              String    @id @default(uuid())
  portalClientId  String
  servico         String // NFSE | DFE | ESOCIAL | SN
  validade        DateTime?
  status          String    @default("ATIVA") // ATIVA | EXPIRADA | REVOGADA
  observacoes     String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, servico])
  @@index([status])
  @@map("procuracoes")
}

// Q12.C.1: registro oficial da apuração PGDAS-D de uma competência.
// Distinto de CompanyMonthlyCircular (que é mais amplo, com guias DAS/INSS).
// Apuracao é o "envelope de transmissão": idempotencyKey + protocolo SEFAZ.
model Apuracao {
  id               String    @id @default(uuid())
  portalClientId   String
  competencia      String // YYYY-MM
  estado           String    @default("pendente") // pendente | calculada | revisada | transmitida | confirmada | erro
  // Hash da base fiscal calculada (recalculo idempotente — mesma base = mesma key,
  // não retransmite). Inclui RB12, FS12, anexos resolvidos por item.
  idempotencyKey   String    @unique
  // Base fiscal (snapshot pra auditoria — mesmo se notas mudarem depois, mantém)
  rb12             Decimal   @db.Decimal(18, 2)
  fs12             Decimal?  @db.Decimal(18, 2)
  fatorR           Decimal?  @db.Decimal(6, 4)
  receitaMes       Decimal   @db.Decimal(18, 2)
  // Receita segregada por anexo (JSON: { III: 1234.56, IV: 0, V: 5678.90, ... })
  receitaPorAnexo  Json
  // Resultado da transmissão SEFAZ
  dasValor         Decimal?  @db.Decimal(18, 2)
  numeroDeclaracao String?
  reciboNumero     String?
  transmitidoEm    DateTime?
  erroMensagem     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  portalClient PortalClient          @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  divergencias ApuracaoDivergencia[]

  @@unique([portalClientId, competencia]) // 1 apuração por competência por empresa
  @@index([estado])
  @@index([portalClientId, estado])
  @@map("apuracoes")
}

// Q12.C.1: divergências encontradas no cálculo (notas vs base, fator R limite, etc).
// Permite contador revisar antes de transmitir.
model ApuracaoDivergencia {
  id         String   @id @default(uuid())
  apuracaoId String
  tipo       String // VALOR_DAS | BASE_ANEXO | FATOR_R | NOTA_SEM_ANEXO | etc
  severidade String   @default("WARN") // INFO | WARN | ERROR
  descricao  String
  esperado   String? // valor/texto esperado (informativo)
  obtido     String? // valor/texto obtido
  tolerado   Boolean  @default(false) // contador marcou como OK
  resolvida  Boolean  @default(false)
  createdAt  DateTime @default(now())

  apuracao Apuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  @@index([apuracaoId])
  @@index([tipo, severidade])
  @@map("apuracao_divergencias")
}

// Q12.C.1: tabela De/Para de classificação de itens em anexos do Simples Nacional.
// Escopo GLOBAL = base nacional (seed); EMPRESA = override específico (raro).
// Lookup ordem: EMPRESA primeiro, depois GLOBAL.
model DeparaAnexo {
  id             String   @id @default(uuid())
  escopo         String // GLOBAL | EMPRESA
  portalClientId String? // null = global
  tipoCodigo     String // LC116 | NCM | CFOP
  codigo         String // ex: "1.01" (LC116), "22021000" (NCM), "5102" (CFOP)
  anexoResolvido String // III | IV | V
  sujeitoFatorR  Boolean  @default(false)
  descricao      String? // opcional, pra UI
  aprendidoEm    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portalClient PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([escopo, portalClientId, tipoCodigo, codigo])
  @@index([tipoCodigo, codigo])
  @@map("deparas_anexo")
}

// ─────────────────────────────────────────────────────────────────────────────
// Q14 — Refundação da apuração (cadastro = autoridade, nota = sinal, motor calcula)
// Plano em ~/.claude/plans/logical-tickling-nygaard.md
// Convivência com modelos antigos (Apuracao, DeparaAnexo) durante migração;
// drop só após Fase 6 (homologação contra PGDAS-D promovida).
// ─────────────────────────────────────────────────────────────────────────────

// Enum estável de tipo de receita pro Simples Nacional.
// Anexo é DERIVADO disso + Fator R mensal — nunca é o input direto.
enum TipoReceita {
  REVENDA_MERCADORIA // → Anexo I
  INDUSTRIALIZACAO // → Anexo II
  SERVICO_ANEXO_III // serviço fixo Anexo III
  SERVICO_ANEXO_IV // construção/advocacia/vigilância — sem Fator R
  SERVICO_ANEXO_V // exceções V puro (raro)
  SERVICO_FATOR_R // III ou V — decidido mensalmente pelo motor
  RECEITA_NAO_CLASSIFICADA // fila de pendência — NUNCA chuta
}

// Cadastro fiscal da empresa — autoridade pra classificação.
// Contador preenche uma vez; alterações geram log.
model CadastroFiscal {
  id                       String    @id @default(uuid())
  portalClientId           String    @unique
  regime                   String // SIMPLES_NACIONAL | LUCRO_PRESUMIDO | LUCRO_REAL | MEI
  dataOpcaoSN              DateTime?
  cnaePrincipal            String
  cnaesSecundarios         String[]  @default([])
  sublimiteICMSISS         Boolean   @default(false) // R$ 3,6 mi separado p/ ICMS/ISS
  usaFatorR                Boolean   @default(false) // contador confirma se tem serviços Fator R
  // Q14.4.d: quando true, o ClassificadorService IGNORA o código LC116/cTribNac
  // da nota e usa o tipoReceitaSugerido do CnaeAnexo[cnaePrincipal] pra TUDO.
  // Usar com cautela — viola "nota é sinal". Útil pra empresas mono-atividade
  // onde notas vêm com códigos errados/genéricos do emissor.
  forcarTipoReceitaPorCnae Boolean   @default(false)
  // Q15: regime de apuração do PGDAS-D (anual, irreversível). Define se o payload
  // usa receitaPaCompetencia* (COMPETENCIA) ou receitaPaCaixa* (CAIXA).
  regimeApuracao           String    @default("COMPETENCIA") // COMPETENCIA | CAIXA
  observacoes              String?
  // Módulo Fiscal (Aba Fiscal / Bloco A): config por CNAE do perfil de atividades.
  // Array: [{ cnae, ativo, padrao, aliquotaIss?, codigoServicoMunicipal?, retencaoFonte?, domicilioFiscal?, obs? }]
  // Entrada do motor de sugestão de anexo (restringe candidatos ao conjunto da empresa).
  perfilAtividades         Json?
  createdByUserId          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@map("cadastros_fiscais")
}

// Catálogo de produtos/serviços da empresa amarrado a TipoReceita.
// Itens podem ser cadastrados manualmente OU aprendidos (1ª vez que código X
// aparece em nota, gera pendência → contador classifica → vira ProdutoServico).
model ProdutoServico {
  id              String      @id @default(uuid())
  portalClientId  String
  nome            String // descrição interna
  tipoReceita     TipoReceita
  codigoServico   String? // LC116/cTribNac (NFS-e)
  ncm             String? // NF-e produto
  cfop            String? // NF-e operação
  codigoInterno   String? // SKU/ID próprio da empresa
  ativo           Boolean     @default(true)
  origem          String // MANUAL | APRENDIDO_DA_NOTA | IMPORTADO
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, codigoServico])
  @@index([portalClientId, ncm])
  @@index([portalClientId, ativo])
  @@map("produtos_servicos")
}

// Regra de classificação (substitui DeparaAnexo atual com nova semântica).
// codigo → TipoReceita (não → anexo direto!).
// EMPRESA sobrescreve GLOBAL. Versionada por vigência pra mudanças legais.
model RegraClassificacao {
  id              String      @id @default(uuid())
  escopo          String // GLOBAL | EMPRESA
  portalClientId  String? // null = global
  tipoCodigo      String // LC116 | CTRIBNAC | NCM | CFOP | CNAE
  codigo          String // valor exato (ou capítulo "17" como fallback)
  tipoReceita     TipoReceita
  prioridade      Int         @default(0) // EMPRESA > GLOBAL > capítulo
  vigenciaInicio  DateTime?
  vigenciaFim     DateTime?
  fonte           String // RFB_REFERENCIA | SEED_APP | CADASTRO_EMPRESA | APRENDIZADO
  descricao       String?
  createdByUserId String?
  createdAt       DateTime    @default(now())

  portalClient PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([escopo, tipoCodigo, codigo, vigenciaInicio])
  @@index([portalClientId, escopo])
  @@map("regras_classificacao")
}

// Tabela de referência CNAE → TipoReceita sugerido. Apoio, não decisão.
// Pré-carregada da RFB. CNAEs ambíguos exigem decisão humana no cadastro.
model CnaeAnexo {
  cnae                String      @id // 7 dígitos sem hífen (ex: "6201500")
  descricao           String
  tipoReceitaSugerido TipoReceita
  ambiguo             Boolean     @default(false) // múltiplos anexos possíveis
  vigenciaInicio      DateTime
  vigenciaFim         DateTime?

  @@index([tipoReceitaSugerido])
  @@map("cnae_anexo")
}

// Tabela versionada de alíquotas SN (LC 123/06, atualizada por LC 155/16
// e o que vier da Reforma Tributária). 5 anexos × 6 faixas = 30 linhas/vigência.
model AliquotaSimplesNacional {
  id              String    @id @default(uuid())
  anexo           String // I, II, III, IV, V
  faixa           Int // 1..6
  rbt12Min        Decimal   @db.Decimal(18, 2)
  rbt12Max        Decimal   @db.Decimal(18, 2)
  aliquotaNominal Decimal   @db.Decimal(6, 4) // ex: 0.0400 = 4%
  parcelaDeduzir  Decimal   @db.Decimal(18, 2)
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?

  @@unique([anexo, faixa, vigenciaInicio])
  @@index([anexo, vigenciaInicio])
  @@map("aliquotas_sn")
}

// Fila de pendências fiscais. Bloqueia fechamento até resolução humana.
// Resolução pode criar RegraClassificacao ou ProdutoServico novos (aprendizado).
model FilaPendencia {
  id             String    @id @default(uuid())
  portalClientId String
  tipo           String // ITEM_SEM_REGRA | DIVERGENCIA_CADASTRO | FATOR_R_AMBIGUO | CADASTRO_INCOMPLETO
  notaId         String? // referência à PortalInvoice
  itemId         String? // referência ao NotaItem
  competencia    String? // YYYY-MM (null se for pendência geral da empresa)
  resumo         String // texto curto pra UI
  detalhes       Json // payload pra UI montar form de resolução
  resolvida      Boolean   @default(false)
  resolvidaPor   String?
  resolvidaEm    DateTime?
  acaoResolucao  String? // CRIOU_REGRA | CRIOU_PRODUTO | IGNOROU | REENQUADROU
  createdAt      DateTime  @default(now())

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, resolvida, tipo])
  @@index([portalClientId, competencia, resolvida])
  @@map("fila_pendencias")
}

// Snapshot reproduzível da apuração. Substitui Apuracao após Fase 6.
// Por enquanto convive — apuração nova grava aqui, antiga continua em Apuracao.
model ApuracaoSnapshot {
  id                      String    @id @default(uuid())
  portalClientId          String
  competencia             String // YYYY-MM
  // Insumos auditáveis
  rbt12                   Decimal   @db.Decimal(18, 2)
  folha12m                Decimal?  @db.Decimal(18, 2)
  fatorR                  Decimal?  @db.Decimal(6, 4)
  receitaPorTipo          Json // { REVENDA_MERCADORIA: x, SERVICO_FATOR_R: y, ... } — segregação do mês, dos DOIS caminhos
  /// Derivado do NOSSO motor, com Fator R aplicado.
  ///
  /// ⚠ NULO = "o motor local não calculou esta competência" — NÃO é o mesmo que `{}`, que seria
  /// "calculou e não achou anexo nenhum". Quem apura pela simulação oficial do PGDAS-D não decide
  /// anexo (quem decide é a RFB, a partir das `atividadesEscolhidas`), então esse caminho deixa a
  /// coluna nula em vez de gravar `{}`. Antes ele gravava `{}` e APAGAVA o que o motor tinha posto.
  receitaPorAnexo         Json?
  // ─── Motor próprio (cálculo LOCAL) ──────────────────────────────────────────────────────────
  /// ⚠ SÓ O MOTOR LOCAL ESCREVE AQUI (`MotorApuracaoService.calcularApuracaoLocal`).
  /// Até 2026-08 `FechamentoService.calcularFechamento` gravava aqui o valor da SIMULAÇÃO OFICIAL
  /// da RFB — a coluna ora guardava o nosso número, ora o da Receita, sem nada na linha que os
  /// distinguisse. Hoje a simulação vai em `dasSimuladoSerpro`. Ver `dasCalculadoLocalProcedencia`.
  dasCalculadoLocal       Decimal?  @db.Decimal(18, 2)
  /// De quem é o número de `dasCalculadoLocal`: `MOTOR_LOCAL` | `AMBIGUO`. Nulo quando a coluna é
  /// nula. `AMBIGUO` existe para os snapshots gravados ANTES da separação, cuja procedência não
  /// pôde ser provada por nenhum outro campo da linha — inventá-la é exatamente o que a separação
  /// veio impedir. Vocabulário em `apuracao/v2/procedenciaDas.js`.
  dasCalculadoLocalProcedencia String?
  aliquotaEfetivaPorAnexo Json?
  vigenciaAliquota        DateTime? // qual versão de AliquotaSimplesNacional usada
  // ─── SERPRO: a SIMULAÇÃO e a TRANSMISSÃO são dois atos, e são duas colunas ───────────────────
  /// DAS devolvido pela simulação oficial do PGDAS-D (`indicadorTransmissao:false`) — o que o
  /// contador vê no [Calcular]. Nada foi declarado à RFB.
  dasSimuladoSerpro       Decimal?  @db.Decimal(18, 2)
  /// DAS devolvido pela TRANSMISSÃO (`indicadorTransmissao:true`) — a declaração existe na Receita.
  /// ⚠ Nulo em PA `jaDeclarado` que não retransmitimos: ali não há valor NOSSO transmitido.
  dasRetornadoSerpro      Decimal?  @db.Decimal(18, 2)
  divergenciaValor        Decimal?  @db.Decimal(18, 2)
  // Reconciliação extrato (Fase 5)
  rbt12Extrato            Decimal?  @db.Decimal(18, 2)
  divergenciaRbt12        Decimal?  @db.Decimal(18, 2)
  // Q15 — fechamento (contador escolhe atividades; RFB calcula anexo/DAS)
  atividadesEscolhidas    Json? // [{ idAtividade, valorInterno, valorExterno, flags }]
  receitaInterna          Decimal?  @db.Decimal(18, 2)
  receitaExterna          Decimal?  @db.Decimal(18, 2)
  folhaMensal12           Json? // série de 12 meses { pa: valor } pro Fator-R
  simulacaoSerpro         Json? // retorno oficial PGDAS-D (indicadorTransmissao:false) — verdade do preview
  tributosPorTributo      Json? // { IRPJ, CSLL, COFINS, PIS, CPP, ICMS, ISS, IPI }
  disparidades            Json? // avisos atividade↔CNAE (não bloqueia)
  // Camada 2 (Robustez): conferência de contagem por chave contra o ADN antes do fechamento.
  conferenciaStatus       String? // ok | divergente | nao_conferivel
  conferenciaResultado    Json? // { nossoTotal, adnTotal, faltantes[], extras[], via, env, alcancouFim }
  conferidaEm             DateTime?
  fechadaEm               DateTime?
  fechadaPor              String?
  // Identificadores SERPRO pós-transmissão
  numeroDeclaracao        String?
  reciboNumero            String?
  transmitidoEm           DateTime?
  // Estado: aberta | configurando | calculada | fechada | transmitida | confirmada
  //         | bloqueada_pendencias | erro_calculo | erro_transmissao | erro
  estado                  String    @default("pendente")
  idempotencyKey          String    @unique
  erroMensagem            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, competencia])
  @@index([estado])
  @@index([portalClientId, estado])
  @@map("apuracao_snapshots")
}

/// Relatório "Faturamento no Período — Consolidado" GERADO para uma competência.
///
/// Uma linha por (empresa, competência). O relatório inteiro vive em `dados` (Json) — ele é um
/// DOCUMENTO, não um conjunto de métricas: blocos por tipo de operação, linhas nota a nota,
/// totais, quadro-resumo e o pré-apurado. Espalhá-lo em colunas obrigaria a migrar o banco a cada
/// coluna nova do impresso.
///
/// ⚠ POR QUE UM MODEL PRÓPRIO E NÃO UMA COLUNA EM `ApuracaoSnapshot`.
/// As competências ZERADAS não têm snapshot — foram medidas 190 células empresa×competência com
/// faturamento EMIT = 0 e ZERO `ApuracaoSnapshot`. Criar um snapshot só para guardar o relatório
/// exigiria preencher `rbt12` e `receitaPorTipo` (NOT NULL): dado fiscal FABRICADO dentro de um
/// registro auditável, que é exatamente a armadilha descrita na seção "Empresa zerada" do
/// `CLAUDE.md`. E a empresa sem faturamento é justamente uma das que mais precisam do relatório —
/// é ele que mostra, preto no branco, que o mês não teve nota.
///
/// ⚠ É UMA FOTO, NÃO UMA FONTE. Nada aqui é autoridade sobre nada: se uma nota chegar depois
/// (retroativa, ou cancelamento capturado tarde), este Json fica velho. É por isso que a rota de
/// gerar REGERA por cima, e que `geradoEm` é obrigatório na leitura — a tela precisa poder dizer
/// de quando é a foto.
model RelatorioFaturamento {
  id             String @id @default(uuid())
  portalClientId String
  competencia    String /// YYYY-MM

  /// O relatório inteiro, na forma que a rota devolve. Ver `RelatorioFaturamentoService.js` —
  /// inclusive o porquê de `ipi`/`st`/`outros`/`liquido` serem `null` e nunca `0`.
  dados Json

  geradoEm  DateTime @default(now())
  /// `User.id` de quem mandou gerar. Nulo para geração feita fora de uma sessão.
  geradoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, competencia])
  @@index([portalClientId, competencia])
  @@map("relatorios_faturamento")
}

// Log auditável da decisão mensal do Fator R (III vs V).
// 1 linha por (empresa, competência) quando há receita SERVICO_FATOR_R.
model LogDecisaoFatorR {
  id             String   @id @default(uuid())
  portalClientId String
  competencia    String // YYYY-MM
  folha12m       Decimal  @db.Decimal(18, 2)
  rbt12          Decimal  @db.Decimal(18, 2)
  fatorR         Decimal  @db.Decimal(6, 4)
  threshold      Decimal  @default(0.28) @db.Decimal(6, 4)
  anexoDecidido  String // "III" se fatorR >= threshold, "V" caso contrário
  fonteFolha     String   @default("MANUAL") // MANUAL | ESOCIAL | IMPORTADO
  createdAt      DateTime @default(now())

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@unique([portalClientId, competencia])
  @@index([portalClientId])
  @@map("log_decisoes_fator_r")
}

// Job de operação em lote (fechar/apurar/transmitir N empresas de uma vez).
// Cada job tem N filhos (1 por empresa) processados em paralelo cap 5.
// Falha em 1 empresa não trava as demais.
model ApuracaoBatchJob {
  id            String    @id @default(uuid())
  acao          String // VALIDAR | FECHAR | APURAR | TRANSMITIR
  competencia   String // YYYY-MM
  totalEmpresas Int
  processadas   Int       @default(0)
  okCount       Int       @default(0)
  errorCount    Int       @default(0)
  pendenteCount Int       @default(0)
  status        String    @default("running") // running | completed | failed
  triggeredBy   String? // userId
  iniciadoEm    DateTime  @default(now())
  concluidoEm   DateTime?
  resumo        Json? // { porEmpresa: [{ portalClientId, status, msg }] }

  @@index([status, iniciadoEm])
  @@map("apuracao_batch_jobs")
}

// Q15 — item de fila por empresa dentro de um ApuracaoBatchJob.
// Falha em 1 item não derruba o lote; worker processa FIFO com backoff.
model ApuracaoBatchItem {
  id               String    @id @default(uuid())
  jobId            String
  portalClientId   String
  competencia      String
  status           String    @default("pendente") // pendente | processando | ok | erro
  dasValor         Decimal?  @db.Decimal(18, 2)
  numeroDeclaracao String?
  erroMensagem     String?
  tentativas       Int       @default(0)
  backoffUntil     DateTime?
  processadoEm     DateTime?
  createdAt        DateTime  @default(now())

  @@index([jobId])
  @@index([status, backoffUntil])
  @@map("apuracao_batch_items")
}

// Q15 — cache do RBT12 (custo SERPRO por requisição: cache é requisito).
// detalhePorMes guarda interno/externo separados (vira receitasBrutasAnteriores).
model RbtExtratoCache {
  id             String   @id @default(uuid())
  portalClientId String
  competencia    String // YYYY-MM (PA de referência do RBT12)
  rbt12          Decimal  @db.Decimal(18, 2)
  detalhePorMes  Json // [{ pa, valorInterno, valorExterno }] (12 meses anteriores)
  origem         String // SIMULACAO | EXTRATO | PARCIAL_LOCAL
  // Os PAs que a RFB ACEITOU na última simulação — `{ receitas: ["2025-06", …], folhas: [...] }`.
  //
  // ⚠ Por que fica separado do `detalhePorMes` e não mexe em `origem`: a RFB **não devolve RBT12**
  // (`PgdasSimulacaoService` retorna `rbt12: null` sempre). O número continua sendo NOSSO, e
  // gravá-lo como `origem: "SIMULACAO"` promoveria a confiabilidade de um dado que nós mesmos
  // calculamos — mentira de procedência. Já QUAIS PERÍODOS ela aceita é conhecimento legítimo
  // vindo dela: ela rejeita apontando o mês.
  //
  // Sem isto, cada [Calcular] redescobria a lista por tentativa e erro: 18 rejeições cobradas para
  // 1 sucesso, e o mesmo custo de novo no dia seguinte, na mesma empresa.
  periodosAceitos Json?
  periodosAceitosEm DateTime?
  capturadoEm    DateTime @default(now())

  @@unique([portalClientId, competencia])
  @@index([portalClientId])
  @@map("rbt_extrato_cache")
}

// Q15 — memória da última configuração de apuração por empresa (defaults).
// Reaparece pré-preenchida na próxima competência.
model ApuracaoConfigMemory {
  id                   String   @id @default(uuid())
  portalClientId       String   @unique
  atividadesEscolhidas Json // [{ idAtividade, ... }]
  folhaMensal12        Json? // série de 12 meses
  regimeApuracao       String?
  flags                Json?
  atualizadoEm         DateTime @default(now())
  atualizadoPor        String?

  @@map("apuracao_config_memory")
}

// Q15 — tabela de-para versionada: atividade do PGDAS-D → anexo/mercado implícitos.
// idAtividade é o que vai no payload TRANSDECLARACAO11 (estabelecimentos[].atividades[]).
// Levantar lista completa no ambiente trial; versionar (muda quando RFB altera programa).
model AtividadePgdasd {
  id              String    @id @default(uuid())
  idAtividade     Int // ID na tabela de atividades do PGDAS-D
  descricao       String
  anexoImplicito  String // I | II | III | IV | V (informativo — RFB decide o final)
  mercado         String    @default("INTERNO") // INTERNO | EXTERNO
  sujeitoFatorR   Boolean   @default(false)
  // mapeamento pro nosso classificador (tipoReceita → idAtividade)
  tipoReceita     String? // TipoReceita correspondente (pra default automático)
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?
  verificadoTrial Boolean   @default(false) // true após confirmar o ID no ambiente trial

  @@unique([idAtividade, vigenciaInicio])
  @@index([tipoReceita, mercado])
  @@map("atividades_pgdasd")
}

// Q48 — Download de notas em lote (módulo top-level). O job roda em segundo plano no processo da API
// (fire-and-forget) e gera um ZIP em disco (storage/downloads) com pasta por empresa. O frontend
// acompanha por polling e baixa o arquivo pronto. expiresAt: zip é apagado após 7 dias.
model NotasDownloadJob {
  id             String    @id @default(uuid())
  status         String    @default("processando") // processando | concluido | erro | expirado
  competenciaDe  String // YYYY-MM
  competenciaAte String // YYYY-MM
  tipo           String? // NFE | NFSE | null = todas
  papel          String? // EMIT | DEST | null = todas
  companyIds     Json // string[] de portalClientId
  totalEmpresas  Int
  processadas    Int       @default(0)
  totalNotas     Int       @default(0)
  arquivoPath    String? // caminho do zip em disco
  arquivoNome    String?
  arquivoBytes   Int?
  erroMensagem   String?
  triggeredBy    String? // userId
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("notas_download_jobs")
}

// Q62 — Download em lote das SITFIS (situação fiscal): ZIP com os PDFs já armazenados por empresa.
model SitfisDownloadJob {
  id            String    @id @default(uuid())
  status        String    @default("processando") // processando | concluido | erro | expirado
  companyIds    Json // string[] de portalClientId
  totalEmpresas Int
  processadas   Int       @default(0)
  comPdf        Int       @default(0)
  arquivoPath   String?
  arquivoNome   String?
  arquivoBytes  Int?
  erroMensagem  String?
  triggeredBy   String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("sitfis_download_jobs")
}

// Consulta de NOTAS em lote — captura de verdade (ADN/SEFAZ), não empacotamento.
//
// ⚠ NÃO CONFUNDIR COM `NotasDownloadJob`. Aquele lê `PortalInvoice.xmlRaw` que JÁ está no banco e
// zipa; se a captura nunca rodou, ele conclui com sucesso e zero notas — foi exatamente o que
// escondeu a rotina automática quebrada. Este aqui CHAMA o ADN/SEFAZ e traz nota nova.
//
// O item por empresa é a razão de existir do modelo. O worker automático descarta empresa sem
// certificado dentro de um `filter`, sem deixar rastro: quem olha o resultado vê "10 empresas
// processadas" e não sabe que 6 nem foram tentadas. Aqui TODA empresa selecionada vira uma linha,
// inclusive — principalmente — a que foi pulada, com o motivo escrito.
model NotasCapturaJob {
  id            String   @id @default(uuid())
  status        String   @default("processando") // processando | concluido | erro
  // manual (aba Consultas) | automatico (worker). O worker registrar as varreduras é o que responde
  // "rodou hoje?" sem abrir log de container — a pergunta que ficou 29 dias sem resposta.
  origem        String   @default("manual")
  alvos         Json // ["NFSE"] | ["NFE"] | ["NFSE","NFE"]
  companyIds    Json // string[] de portalClientId
  totalEmpresas Int
  processadas   Int      @default(0) // empresas concluídas (capturadas OU puladas)
  totalNotas    Int      @default(0) // documentos novos gravados
  erroMensagem  String?
  triggeredBy   String? // userId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens NotasCapturaItem[]

  @@index([status, createdAt])
  @@map("notas_captura_jobs")
}

model NotasCapturaItem {
  id             String   @id @default(uuid())
  jobId          String
  portalClientId String
  razao          String?
  cnpj           String?
  alvo           String // NFSE | NFE
  // capturou (trouxe documento) | nada_novo | pulada (pré-condição) | aguardando (janela/backoff) | erro
  status         String
  motivo         String? // texto pronto para a tela: "sem certificado A1", "faltam 42 min"…
  totalDocs      Int      @default(0)
  novos          Int      @default(0)
  // Documentos que o ADN devolveu e a guarda de CNPJ recusou. Precisa de coluna PRÓPRIA: é a única
  // forma de uma empresa "ficar sem notas mesmo tendo emitido" em silêncio — o documento chega,
  // entra em `totalDocs` e é descartado. Sem este número, recusa indevida (CNPJ de filial, CPF,
  // cadastro errado) fica idêntica a "não havia nota".
  recusadas      Int      @default(0)
  cursorAntes    String?
  cursorDepois   String?
  createdAt      DateTime @default(now())

  job NotasCapturaJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("notas_captura_items")
}

// ── Ledger append-only de documentos fiscais (Robustez NFS-e/ADN — Fase 1) ──────────────
// Fundação do modelo por FLUXO DE EVENTOS (não snapshot por data). Documentos e eventos são
// IMUTÁVEIS (append-only): correção = novo registro, nunca UPDATE. O status é PROJEÇÃO
// recalculável (ver LedgerProjectionService), nunca coluna gravada. Ainda NÃO ligado à captura
// atual (PortalInvoice segue intacto) — ver docs/robustez-nfse-adn.md.
// Convenção: portalClientId é coluna simples (sem FK/cascade de propósito — ledger é dado de
// auditoria e não deve sumir se o cliente for removido).

model Documento {
  id              String    @id @default(uuid())
  portalClientId  String
  chaveAcesso     String
  cnpjPrestador   String?
  cnpjTomador     String?
  municipioIbge   String?
  numeroNfse      String?
  dataEmissao     DateTime?
  dataRecepcaoAdn DateTime?
  competencia     String? // YYYY-MM (derivada da emissão)
  valorServico    Decimal?  @db.Decimal(18, 2)
  xmlOriginal     String? // XML cru (gzip/base64)
  nsuOrigem       BigInt?
  fonte           String // ADN | RPA | WS_MUNICIPAL | MANUAL
  capturadoEm     DateTime  @default(now())

  @@unique([portalClientId, chaveAcesso])
  @@index([portalClientId, competencia])
  @@index([chaveAcesso])
  @@map("documentos")
}

model Evento {
  id              String    @id @default(uuid())
  portalClientId  String
  chaveAcesso     String
  tipoEvento      String // cancelamento | canc_por_substituicao | confirmacao | confirmacao_tacita | anulacao_rejeicao | canc_por_oficio | bloqueio_oficio | desbloqueio_oficio
  nSeqEvento      Int       @default(1)
  dataEvento      DateTime?
  justificativa   String?
  chaveSubstituta String? // preenchido no cancelamento por substituição
  xmlEvento       String?
  nsuOrigem       BigInt?
  fonte           String // ADN | RPA | WS_MUNICIPAL | MANUAL
  capturadoEm     DateTime  @default(now())

  @@unique([chaveAcesso, tipoEvento, nSeqEvento]) // idempotência do evento
  @@index([portalClientId, chaveAcesso])
  @@map("eventos")
}

model NsuWatermark {
  id                    String   @id @default(uuid())
  portalClientId        String
  fonte                 String // ADN | RPA | WS_MUNICIPAL
  ultimoNsuProcessado   BigInt   @default(0)
  primeiroNsuDisponivel BigInt?
  atualizadoEm          DateTime @updatedAt

  @@unique([portalClientId, fonte])
  @@map("nsu_watermark")
}

model NsuGap {
  id             String   @id @default(uuid())
  portalClientId String
  fonte          String
  nsuFaltante    BigInt
  tentativas     Int      @default(0)
  status         String   @default("aberto") // aberto | resolvido | inexistente
  detectadoEm    DateTime @default(now())

  @@unique([portalClientId, fonte, nsuFaltante])
  @@index([portalClientId, status])
  @@map("nsu_gaps")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// Controle de Obrigações
//
// OBRIGAÇÃO É O SERVIÇO QUE O ESCRITÓRIO PRECISA FAZER até uma data — transmitir a apuração,
// entregar a ECD, fechar o mês. NÃO é o vencimento da guia: aquele é do CLIENTE e continua vindo
// de `Guide.vencimento`. São dois eixos diferentes, com públicos e datas diferentes, e por isso
// convivem no calendário sem nenhuma deduplicação entre si.
//
// NÃO EXISTE CATÁLOGO PRÉ-CARREGADO. Nome, periodicidade e dia são digitados pelo contador. Data
// de obrigação é dado fiscal que muda por ato normativo; semear uma lista embutida colocaria prazo
// desatualizado na tela de todas as empresas de uma vez. Repetição entre empresas se resolve pela
// `RegraObrigacao`, que é cadastrar uma vez e aplicar a muitas.
// ─────────────────────────────────────────────────────────────────────────────────────────────

model Obrigacao {
  id             String  @id @default(uuid())
  portalClientId String
  nome           String
  /// Campo LIVRE (fiscal, trabalhista, própria da empresa…). A UI sugere o que o escritório já
  /// usou; não é vocabulário fechado que precise ser mantido por nós. Só alimenta cor e filtro.
  categoria      String?
  /// MENSAL | TRIMESTRAL | ANUAL
  periodicidade  String
  /// 1–31. Dia maior que o mês comporta é fixado no ÚLTIMO dia do mês (31 em fevereiro = 28/29),
  /// nunca transbordando para o mês seguinte — ver `gerarOcorrencias`.
  diaVencimento  Int
  /// TRIMESTRAL: primeiro mês do ciclo (1–12), e daí de 3 em 3. ANUAL: o mês. MENSAL: ignorado.
  mesReferencia  Int?
  /// Quantos meses ATRÁS do vencimento está a competência a que o serviço se refere.
  /// "Transmitir a apuração de julho" vence em agosto: defasagem 1. Fechar o mês corrente: 0.
  /// Não é chutado — o contador declara no formulário, porque varia por obrigação. É o que
  /// permite o `verificador` olhar a competência CERTA ao concluir sozinho.
  defasagemMeses Int  @default(1)

  antecedenciaLembreteDias Int    @default(5)
  /// ANTECIPAR | POSTERGAR | MANTER — o que fazer quando o vencimento cai em dia não útil.
  ajusteDiaUtil            String @default("ANTECIPAR")
  cor                      String?
  ativa                    Boolean @default(true)

  /// Chave de um conjunto FECHADO (APURACAO_TRANSMITIDA | MES_FECHADO). Quando preenchida, a
  /// ocorrência se conclui sozinha ao observar o estado do sistema, sem clique. Nulo = manual.
  /// Escolhido pelo contador no formulário, em linguagem comum — não imposto pelo sistema.
  verificador String?

  /// Preenchido = obrigação gerenciada por uma regra do escritório.
  regraId         String?
  /// Empresa editou localmente uma obrigação que veio de regra: a regra não sobrescreve mais.
  sobrescritaLocal Boolean @default(false)

  criadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portalClient PortalClient          @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  regra        RegraObrigacao?       @relation(fields: [regraId], references: [id], onDelete: SetNull)
  ocorrencias  OcorrenciaObrigacao[]

  /// Uma regra produz NO MÁXIMO uma obrigação por empresa. Sem isso, uma propagação que rodasse
  /// duas vezes criaria duas linhas iguais e o contador veria a mesma entrega em dobro no
  /// calendário. `regraId` nulo (obrigação avulsa) não é afetado: o Postgres não compara NULLs.
  @@unique([regraId, portalClientId])
  @@index([portalClientId, ativa])
  @@index([regraId])
  @@map("obrigacoes")
}

model OcorrenciaObrigacao {
  id             String   @id @default(uuid())
  obrigacaoId    String
  dataVencimento DateTime @db.Date
  /// "YYYY-MM" — a competência a que o SERVIÇO se refere, já com a defasagem aplicada. Guardada
  /// e não recalculada na leitura porque mudar a defasagem depois não pode reescrever o passado.
  competenciaRef String?
  /// Guarda só PENDENTE | CONCLUIDA. **VENCIDA é derivada na leitura** (pendente + data passada),
  /// nunca gravada: status calculado a partir do relógio envelhece no banco, e aí a tela mostra
  /// "pendente" no que já venceu até alguém rodar um job. Derivando, nunca está errado.
  status         String   @default("PENDENTE")
  concluidaEm    DateTime?
  concluidaPorId String?
  /// MANUAL | AUTOMATICA — de onde veio a conclusão. A tela não oferece "concluir" na automática:
  /// ela diz o que o sistema observou.
  fonteConclusao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obrigacao Obrigacao @relation(fields: [obrigacaoId], references: [id], onDelete: Cascade)

  /// É esta constraint que torna a geração da janela de 12 meses segura para rodar de novo:
  /// reexecutar não duplica, e o worker mensal pode ser chamado quantas vezes for.
  @@unique([obrigacaoId, dataVencimento])
  @@index([dataVencimento, status])
  @@map("ocorrencias_obrigacao")
}

model RegraObrigacao {
  id       String  @id @default(uuid())
  nome     String
  categoria String?

  periodicidade            String
  diaVencimento            Int
  mesReferencia            Int?
  defasagemMeses           Int     @default(1)
  antecedenciaLembreteDias Int     @default(5)
  ajusteDiaUtil            String  @default("ANTECIPAR")
  cor                      String?
  verificador              String?
  ativa                    Boolean @default(true)

  /// TODAS | POR_FILTRO | SELECAO_MANUAL
  escopo  String
  /// POR_FILTRO: { regimes: [...], temFolha: true|null }. SELECAO_MANUAL: { empresasIds: [...] }.
  filtros Json?
  /// Empresa nova que se encaixe no filtro recebe a obrigação sozinha.
  aplicarANovas Boolean @default(true)

  criadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  obrigacoes Obrigacao[]
  excecoes   RegraObrigacaoExcecao[]

  @@index([ativa])
  @@map("regras_obrigacao")
}

/// Empresa tirada da regra à mão. É linha própria, e não ausência de `Obrigacao`, porque inferir
/// exceção pela ausência é frágil: uma falha na propagação viraria "exceção" silenciosa.
model RegraObrigacaoExcecao {
  id             String   @id @default(uuid())
  regraId        String
  portalClientId String
  motivo         String?
  createdAt      DateTime @default(now())

  regra RegraObrigacao @relation(fields: [regraId], references: [id], onDelete: Cascade)

  @@unique([regraId, portalClientId])
  @@map("regras_obrigacao_excecoes")
}

/// Feriados, para o ajuste de dia útil.
///
/// ⚠ A tabela é INCOMPLETA por natureza e isso é seguro: fim de semana é sempre conhecido (é a
/// maioria dos casos e não é juízo jurídico), e feriado que não está aqui simplesmente não move a
/// data. O que NÃO se pode é inventar: feriado municipal varia por município, e Carnaval e Corpus
/// Christi são ponto facultativo federal — não feriado —, ainda que banco não opere. Enquanto o
/// dono não confirmar, ficam de fora.
model Feriado {
  id String @id @default(uuid())
  /// Data exata do ano (feriado móvel entra ano a ano, já calculado).
  data DateTime @db.Date
  /// NACIONAL | MUNICIPAL
  abrangencia String
  /// Só para MUNICIPAL. Nome do município como está em `PortalClient.municipio`.
  municipio   String?
  nome        String
  createdAt   DateTime @default(now())

  @@unique([data, abrangencia, municipio])
  @@index([data])
  @@map("feriados")
}

/// ESPELHO DA DEFIS — a folha de transcrição de um ano-calendário.
///
/// ⚠ ISTO NÃO TRANSMITE NADA. A DEFIS é transmitida NO PORTAL do Simples Nacional; o espelho
/// existe para o contador transcrever de cima para baixo sem procurar campo, com o que o sistema
/// já sabe pré-preenchido. Por isso `transmitidaEm` é uma MARCA manual (o contador diz que
/// transmitiu) acompanhada do recibo — não é prova de transmissão nossa.
///
/// ⚠ O payload é JSON de propósito. São ~40 campos numerados, mais listas repetíveis (sócios,
/// exportadoras, UFs, municípios) e uma ficha por estabelecimento. Modelar isso em colunas
/// congelaria a estrutura da DEFIS no schema — e ela muda por ato normativo, fora do nosso
/// controle. A forma canônica vive em `features/obrigacoes/defis/lib/defisSpec.js`, com a citação
/// do manual oficial.
model DefisEspelho {
  id             String @id @default(uuid())
  portalClientId String
  /// Ano-calendário a que a declaração se refere (a DEFIS de 2025 é entregue em 2026).
  anoCalendario  Int

  /// O espelho inteiro, na forma de `defisSpec.espelhoVazio()`.
  dados Json

  /// Marca manual: o contador confirma que transmitiu no portal. Nunca escrita por automação.
  transmitidaEm   DateTime?
  transmitidaPorId String?
  /// Recibo de entrega guardado pelo `GuideStorageService` (mesmo caminho dos PDFs de guia).
  reciboFileId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Um espelho por empresa por ano — reabrir a tela continua o mesmo, não cria outro.
  @@unique([portalClientId, anoCalendario])
  @@index([portalClientId])
  @@map("defis_espelhos")
}

/// ENTREGA DE OBRIGAÇÃO POR ARQUIVO — o rastro de "gerar → transmitir no programa oficial → recibo".
///
/// ⚠ POR QUE ESTE MODELO É GENÉRICO, E NÃO "EfdContribuicoes"
/// EFD-Contribuições, ECD, ECF e EFD-Fiscal seguem exatamente o mesmo ciclo: um arquivo de leiaute
/// fixo é gerado, validado e assinado NO PROGRAMA OFICIAL da Receita (PVA), transmitido por lá, e
/// o que volta é um recibo. Uma tabela por obrigação seria a mesma estrutura copiada quatro vezes,
/// e a quarta divergiria. `tipo` é string livre pelo mesmo motivo que `Obrigacao.categoria` é: o
/// vocabulário é do escritório, não nosso.
///
/// ⚠ ISTO NÃO TRANSMITE NADA, e não gera o arquivo tampouco. `transmitidaEm` é MARCA MANUAL: o
/// contador confirma que transmitiu no PVA. O que o sistema guarda é o rastro — sem ele, "a EFD de
/// março foi entregue?" só se responde abrindo o programa oficial.
model EntregaObrigacaoArquivo {
  id             String @id @default(uuid())
  portalClientId String
  /// EFD_CONTRIBUICOES | ECD | ECF | … — o escritório nomeia.
  tipo           String
  /// "YYYY-MM" para as mensais; "YYYY" para as anuais (ECD/ECF).
  competencia    String

  /// O arquivo entregue ao PVA. Hoje SEMPRE vem de upload: o app não gera o leiaute (ver o
  /// comentário da tela). Guardado pelo `GuideStorageService`, como os PDFs de guia.
  arquivoFileId String?
  arquivoNome   String?

  /// O recibo devolvido pelo programa oficial — é ele que fecha a obrigação.
  reciboFileId String?
  reciboNome   String?

  /// Marca manual do contador. Nunca escrita por automação.
  transmitidaEm    DateTime?
  transmitidaPorId String?

  observacao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Uma entrega por empresa, por tipo, por competência.
  @@unique([portalClientId, tipo, competencia])
  @@index([portalClientId, tipo])
  @@map("entregas_obrigacao_arquivo")
}

/// ONBOARDING — o funil PRÉ-CADASTRO de cliente novo.
///
/// ⚠ POR QUE UMA TABELA PRÓPRIA, E NÃO UM `PortalClient` INCOMPLETO
/// `PortalClient.cnpj` é `@unique` NOT NULL e a criação de empresa é tudo-ou-nada (CNPJ válido,
/// razão social, regime, CNAE, endereço completo, e-mail e senha do dono numa só requisição). Isso
/// serve para quem já tem tudo em mãos — e não serve para o que acontece ANTES: a empresa que ainda
/// vai abrir (não tem CNPJ), a que está trocando de contador (a papelada chega em partes), a que
/// está parada. Não existe empresa provisória no modelo atual; forçar uma criaria CNPJ falso na
/// carteira. Aqui o preenchimento é PARCIAL por definição, e a conversão chama o mesmo
/// `provisionarEmpresa` do botão "Nova empresa".
///
/// ⚠ HÍBRIDO COLUNA/JSON, de propósito: vira COLUNA só o que aparece em `where`, `orderBy` ou no
/// card da lista; todo o resto mora em `dados`, na forma de `rascunhoVazio(origem)` do
/// `onboardingSpec.js`. Mesmo precedente do `dados` de `DefisEspelho`. Promover cada campo do
/// formulário a coluna significaria uma migração por pergunta nova.
///
/// ⚠ `status` e `origem` são String, não enum do Prisma — é a convenção deste schema
/// (`PortalClient.status`, `Obrigacao.periodicidade`). Enum transforma cada valor novo em migração.
model Onboarding {
  id String @id @default(uuid())

  /// ABERTURA | TRANSFERENCIA | INATIVA — a única variável que muda a trilha do funil.
  origem String
  /// RASCUNHO | RECEBIDO | EM_TRILHA | CONVERTIDO | DESISTIU
  status String @default("RASCUNHO")
  /// ESCRITORIO | CLIENTE — quem digitou a ficha. É o que decide o TEXTO do selo de dado
  /// declarado: "declarado pelo cliente" só quando CLIENTE; no preenchimento interno o selo lê
  /// "declarado no atendimento", senão ele mentiria sobre um dado que o próprio contador digitou.
  /// Na Fase 1 só existe ESCRITORIO (o link público é Fase 2).
  origemPreenchimento String @default("ESCRITORIO")

  /// ⚠ NULLABLE e NÃO-UNIQUE de propósito: abertura de empresa não tem CNPJ, e duas fichas podem
  /// citar o mesmo CNPJ (cliente que desistiu e voltou). O unique de verdade é o de
  /// `PortalClient.cnpj`, cobrado só na conversão.
  cnpj String?
  /// Na abertura guarda o NOME PRETENDIDO, que ainda não é razão social de ninguém.
  razaoSocial String?

  /// Promovidos a coluna porque a busca da lista procura por eles.
  responsavelNome     String?
  responsavelEmail    String?
  responsavelTelefone String?

  /// Checagem BRANDA: o e-mail do responsável já tem conta no portal. Serve de aviso na tela para
  /// o contador não criar um segundo login para a mesma pessoa. NUNCA bloqueia — uma pessoa com
  /// duas empresas é caso normal, e o provisionamento já sabe reusar `User` existente.
  emailJaCadastrado Boolean @default(false)

  /// Tudo o mais, na forma de `rascunhoVazio(origem)`. A forma canônica vive na spec do front.
  dados Json @default("{}")

  /// Último passo do wizard alcançado — só para reabrir a ficha onde o preenchimento parou.
  ultimoPasso String?
  /// Quando a ficha foi FINALIZADA (deixou de ser rascunho). É o instante em que a checklist é
  /// materializada a partir do template da origem.
  enviadoEm   DateTime?
  criadoPorId String?

  /// ⚠ Id do PORTAL CLIENT, nunca da Company legada — os dois existem e são diferentes, e o
  /// certificado A1 mora na legada. Chamar isto de `companyId` é o erro que a armadilha nº 3 do
  /// plano descreve.
  portalClientId String? @unique
  portalClient   PortalClient? @relation(fields: [portalClientId], references: [id], onDelete: SetNull)

  convertidoEm     DateTime?
  convertidoPorId  String?
  desistiuEm       DateTime?
  motivoDesistencia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  etapas OnboardingEtapa[]

  @@index([status, origem])
  @@index([cnpj])
  @@index([responsavelEmail])
  @@map("onboardings")
}

/// A CHECKLIST do escritório para aquele onboarding, materializada no "finalizar".
///
/// ⚠ `titulo` e `descricao` são CÓPIA do template (`etapasTemplate.js`), não leitura viva. Editar o
/// catálogo depois não pode reescrever a checklist de quem já está em trilha — mesma disciplina do
/// `OcorrenciaObrigacao.competenciaRef`.
model OnboardingEtapa {
  id           String     @id @default(uuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  /// Chave estável da etapa dentro da origem (ex: "certificado_a1").
  chave     String
  titulo    String
  descricao String?
  ordem     Int

  /// SITFIS | CERTIFICADO_A1 | DOCUMENTOS | CONVERSAO | null — o efeito colateral que o card
  /// oferece. ⚠ Os três primeiros exigem `PortalClient`, logo só existem PÓS-conversão.
  acao        String?
  obrigatoria Boolean @default(true)

  concluidaEm    DateTime?
  concluidaPorId String?
  observacao     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// É o que torna o "finalizar" reexecutável: repetir com `skipDuplicates` não duplica a lista.
  @@unique([onboardingId, chave])
  @@index([onboardingId, ordem])
  @@map("onboarding_etapas")
}

// ==========================================================================================
// Cofre de credenciais da empresa (gov.br, e-CAC, prefeitura, portal do banco, INSS…)
//
// ⚠ A SENHA NUNCA É GRAVADA EM CLARO. `senhaCifrada` guarda o retorno de `utils/crypto.js`
// `encryptSecret` — o MESMO caminho do certificado A1: AES-256-GCM com envelope encryption via
// AWS KMS quando `isKmsEnabled()` (prefixo `kms-v1:`), caindo para chave derivada de
// `CERT_SECRET_KEY` quando não (prefixo `v1:`). A leitura detecta o formato pelo prefixo, então a
// migração é LAZY. NÃO existe um segundo caminho de cifra neste projeto, e não deve existir:
// seria a segunda cópia da regra mais perigosa do sistema.
//
// ⚠ A senha NÃO volta na listagem. `listar()` faz `select` explícito SEM `senhaCifrada` — nem o
// texto claro nem o blob cifrado saem por ali. Ver o valor é ação separada, deliberada e AUDITADA
// (`CompanyCredentialAcesso`).
// ==========================================================================================
model CompanyCredential {
  id             String @id @default(uuid())
  portalClientId String

  /// Rótulo livre do acesso: "gov.br", "Prefeitura SP", "Portal do banco", "e-CAC".
  /// Livre de propósito: cada município e cada banco tem um portal, e uma lista fechada
  /// envelheceria na primeira prefeitura nova.
  rotulo String
  /// Usuário/login do portal. NÃO é cifrado — sozinho ele não abre nada, e cifrá-lo esconderia da
  /// listagem justamente o dado que identifica de qual acesso se está falando.
  login  String?
  /// ⚠ CIFRADO por `encryptSecret`. NUNCA sai em listagem, log ou mensagem de erro.
  /// Null = credencial cadastrada sem senha (só login/observação) — é caso legítimo.
  senhaCifrada String?
  /// Anotação sobre o acesso (pergunta secreta, qual sócio é o titular, onde renovar).
  /// ⚠ NÃO é cifrada. A tela diz isso — quem escrever senha aqui está escrevendo em claro.
  observacao String?

  criadoPorId    String?
  atualizadoPorId String?
  /// Quando a SENHA foi trocada pela última vez (≠ updatedAt, que muda ao editar rótulo/observação).
  senhaAtualizadaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portalClient PortalClient                @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  acessos      CompanyCredentialAcesso[]

  @@index([portalClientId])
  @@map("company_credentials")
}

/// "Outras informações" da empresa: texto livre por rótulo (contato do contador do cliente, código
/// de acesso não-secreto, número de protocolo, senha do wi-fi do escritório do cliente…).
///
/// ⚠ NÃO É CIFRADO, e a tela DIZ que não é. Campo que parece cofre e não é vale menos que campo
/// nenhum: quem confia nele guarda segredo em claro achando que está protegido. Por isso são DUAS
/// tabelas e duas seções na tela, e não um campo `secreto: boolean` numa só — a natureza do dado
/// tem de estar visível antes de digitar, não depois.
model CompanyInfo {
  id             String @id @default(uuid())
  portalClientId String

  rotulo String
  valor  String

  criadoPorId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId])
  @@map("company_infos")
}

/// Auditoria de acesso ao cofre — quem viu qual senha e quando.
///
/// ⚠ Sem isto, credencial vazada é IRRASTREÁVEL: não há como saber quem teve o valor em mãos, e
/// portanto não há como responder a pergunta que se faz depois de um incidente. É o mesmo desenho
/// de `estornos_baixa` e `atos_parcelamento` — tabela própria, append-only, com cópia imutável do
/// que era o registro no momento do ato (o rótulo é copiado porque a credencial pode ser apagada
/// depois, e um log apontando para um id que não existe mais não conta história nenhuma).
///
/// ⚠ NADA DA SENHA ENTRA AQUI — nem o texto claro, nem o blob cifrado, nem hash, nem tamanho.
model CompanyCredentialAcesso {
  id             String  @id @default(uuid())
  portalClientId String
  /// Sem FK obrigatória de leitura: o registro sobrevive à exclusão da credencial (SetNull).
  credentialId   String?

  /// REVELADA | CRIADA | ATUALIZADA | SENHA_ALTERADA | REMOVIDA (CHECK no banco).
  /// `REVELADA` é a que dá sentido à tabela; as outras existem para que o histórico de uma
  /// credencial não tenha buracos entre uma leitura e outra.
  acao String

  /// Cópia imutável — ver o comentário acima.
  rotuloNoMomento String

  usuarioId    String?
  usuarioEmail String?
  /// Motivo declarado pelo usuário ao revelar. Opcional: exigir texto a cada leitura treinaria a
  /// digitar "." e transformaria a exigência em ruído.
  motivo       String?
  ip           String?
  userAgent    String?

  createdAt DateTime @default(now())

  credential   CompanyCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  portalClient PortalClient       @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, createdAt])
  @@index([credentialId, createdAt])
  @@map("company_credential_acessos")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// CONFERÊNCIA DE LANÇAMENTOS — a nota vira despesa, o extrato vira o pagamento dela
// ═══════════════════════════════════════════════════════════════════════════════════════════════

/// UM FATO DE DESPESA QUE AINDA NÃO É LANÇAMENTO CONTÁBIL.
///
/// ⚠⚠ UM REGISTRO POR DESPESA. A nota e o pagamento são duas FACES desta linha, nunca duas linhas.
/// A nota diz QUE despesa é e DE QUEM; o pagamento diz QUANDO o dinheiro saiu. É isso que torna a
/// contagem dupla impossível por construção, em vez de ser regra que alguém pode furar.
///
/// ⚠⚠ POR QUE `dataPagamento` PODE SER NULA, E POR QUE ISSO É O CORAÇÃO DO MODELO.
/// Medido em produção (`scripts/diag-forma-despesa.mjs`, 24/08/2026): 155 de 155 lançamentos
/// `tipo:"DESPESA"` desta casa são 1D/1C creditando CAIXA — ou seja, o lançamento de despesa aqui
/// AFIRMA A SAÍDA DO DINHEIRO. A nota recebida não sabe quando o dinheiro saiu; lançá-la na data de
/// emissão mentiria sobre o caixa em toda despesa a prazo, e em silêncio. Enquanto a data não for
/// conhecida o registro fica em `AGUARDANDO_PAGAMENTO`, que é a resposta honesta.
///
/// ⚠ `AGUARDANDO_PAGAMENTO` NÃO É PRISÃO (dono, 24/08/2026): o contador lança quando decidir, mesmo
/// sem comprovante — informando a data, que fica gravada como DECLARAÇÃO, não como prova.
///
/// A regra de transição mora em `application/declarados/lib/estadosDeclarado.js` (pura, 70 testes).
model LancamentoDeclarado {
  id             String @id @default(uuid())
  portalClientId String

  /// NOTA_RECEBIDA | CLIENTE_MANUAL | OFX_CLIENTE
  origem String
  /// AGUARDANDO_PAGAMENTO | A_CONFERIR | CONTABILIZADO | RECUSADO | FUNDIDO
  estado String
  /// ENTRADA | SAIDA
  tipo   String

  valor       Decimal @db.Decimal(18, 2)
  /// "AAAA-MM". ⚠ NULA quando a nota veio sem competência — atribuí-la a um mês seria decidir em
  /// qual apuração a despesa entra, e isso não se inventa.
  competencia String?

  // ── O DOCUMENTO ────────────────────────────────────────────────────────────────────────────
  notaRecebidaId String?
  dataDocumento  DateTime?
  /// ⚠ Só a nota o preenche (`PortalInvoice.emitenteDoc`). NUNCA inferido de descrição ou de valor.
  cnpjFornecedor String?
  /// O texto CRU da origem, intocado. ⚠ Para a nota é o `emitenteNome` — é o formato que os 130
  /// lançamentos vindos do Excel já usam no histórico; trocá-lo mudaria o que o razão mostra.
  descricaoOriginal    String
  /// Índice do matching. ⚠ NUNCA substitui o original.
  descricaoNormalizada String
  /// `xDescServ` da NFS-e. Detalhe para a tela — ⚠ NÃO vira histórico do lançamento.
  detalheServico       String?

  // ── O PAGAMENTO ────────────────────────────────────────────────────────────────────────────
  /// ⚠⚠ NULO = "ainda não sabemos". É o que separa AGUARDANDO_PAGAMENTO de A_CONFERIR.
  dataPagamento    DateTime?
  /// OFX (prova) | DECLARADO_PELO_CONTADOR (declaração) | CLIENTE (declaração).
  /// ⚠ Prova e declaração não podem virar a mesma coisa: quando o débito do extrato chegar sobre
  /// uma despesa já lançada, o contador precisa saber qual das duas está olhando.
  origemPagamento  String?
  ofxImportId      String?
  fitId            String?
  contaBancariaRef String?

  /// Impressão digital da origem — `NOTA:<portalInvoiceId>` etc. ⚠ A idempotência mora no BANCO
  /// (o `@@unique` abaixo), não só no código: recaptura da mesma nota não pode gerar segunda linha.
  hashDedupe String

  guiaId         String?
  parDeclaradoId String?
  /// ⚠ SEM FK, de propósito — mesmo desenho de `AccountingEntry.estornoDeEntryId`. Com `SetNull` um
  /// lançamento apagado por fora deixaria a linha em CONTABILIZADO apontando para nada, e o
  /// apagamento da evidência seria silencioso. Sem FK o id fica, e a varredura o denuncia.
  accountingEntryId String?
  regraId           String?
  /// ⚠⚠ SEMPRE `codigoCompleto`. O reduzido é mutável; o completo é a âncora desta casa.
  contaSugerida     String?
  contaAplicada     String?
  valorAjustado     Decimal? @db.Decimal(18, 2)
  motivoRecusa      String?

  criadoPor    String
  decididoPor  String?
  decididoEm   DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  portalClient PortalClient     @relation(fields: [portalClientId], references: [id], onDelete: Cascade)
  notaRecebida PortalInvoice?   @relation(fields: [notaRecebidaId], references: [id], onDelete: SetNull)
  anexos       AnexoDeclarado[]

  @@unique([portalClientId, hashDedupe])
  @@index([portalClientId, estado])
  @@index([portalClientId, competencia])
  @@index([portalClientId, cnpjFornecedor])
  @@index([notaRecebidaId])
  @@map("lancamentos_declarados")
}

/// Comprovante anexado a um declarado.
model AnexoDeclarado {
  id           String   @id @default(uuid())
  lancamentoId String
  url          String
  mimeType     String?
  nomeArquivo  String?
  criadoPor    String
  criadoEm     DateTime @default(now())

  lancamento LancamentoDeclarado @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)

  @@index([lancamentoId])
  @@map("anexos_declarados")
}

/// O QUE O CONTADOR JÁ ENSINOU — "despesa deste fornecedor vai nesta conta".
///
/// ⚠ Regra precisa de PELO MENOS UMA âncora (CNPJ ou descrição): sem nenhuma ela casaria com tudo.
/// O CHECK vive no SQL da migration — o Prisma não modela CHECK.
///
/// ⚠ CNPJ vence descrição quando as duas casam: ele IDENTIFICA, ela se PARECE.
model RegraContabilizacao {
  id             String @id @default(uuid())
  portalClientId String

  /// Âncora FORTE. ⚠ Só o caminho da nota a escreve — `AccountingEntry` não tem fornecedor, então o
  /// backfill do histórico não pode preenchê-la sem inventar.
  cnpjFornecedor  String?
  /// Âncora FRACA — é o que o histórico existente oferece.
  padraoDescricao String?

  valorMin     Decimal @db.Decimal(18, 2)
  valorMax     Decimal @db.Decimal(18, 2)
  /// ⚠⚠ SEMPRE `codigoCompleto`, nunca o reduzido.
  contaDestino String
  tipo         String

  /// MANUAL | APRENDIDA
  origemRegra String
  ativa       Boolean @default(true)
  /// ⚠ Regra APRENDIDA se suspende sozinha quando a unanimidade que a gerou se quebra.
  /// Regra MANUAL nunca — foi decisão explícita de quem a escreveu.
  suspensaEm      DateTime?
  motivoSuspensao String?

  criadaPor String
  /// Os declarados que geraram a regra APRENDIDA. ⚠ Navegável na tela: aprendizado invisível é o
  /// que impede o contador de desligar a regra no dia em que algo entrar errado.
  confirmacoesBase Json?
  criadaEm         DateTime  @default(now())
  revogadaEm       DateTime?
  aplicacoes       Int       @default(0)

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, ativa])
  @@index([portalClientId, cnpjFornecedor])
  @@map("regras_contabilizacao")
}

/// UMA IMPORTAÇÃO DE EXTRATO OFX FEITA PELO CLIENTE.
///
/// ⚠⚠ Ela existe para o sistema conseguir dizer *"este arquivo você já subiu em 12/08"* — e para
/// `LancamentoDeclarado.ofxImportId` ter escritor. Coluna que ninguém escreve é a guarda morta que
/// este projeto já pagou (`hasAccountingDivergence`: um escritor, zero leitores, meses no ar).
///
/// ⚠ O QUE ELA **NÃO** É: a proteção contra duplicata. Essa vive no
/// `@@unique(portalClientId, hashDedupe)` de `LancamentoDeclarado`, transação a transação — porque
/// **a sobreposição de períodos é o caso NORMAL**: o cliente baixa 01–31/jan e depois 15/jan–15/fev,
/// que é o comportamento esperado de quem usa internet banking. Recusar arquivo repetido barraria o
/// fluxo certo e deixaria passar o errado.
model OfxImport {
  id             String @id @default(uuid())
  portalClientId String

  /// SHA-256 do arquivo. ⚠ INFORMATIVO, nunca bloqueio — ver o aviso acima. Sem `@@unique`: o mesmo
  /// arquivo pode voltar legitimamente depois de linhas terem sido recusadas.
  hashArquivo String
  nomeArquivo String?
  /// `ACCTID` do `<BANKACCTFROM>`. ⚠ NULO quando o arquivo não o traz — e aí o dedupe fica mais
  /// frouxo (por empresa, sem separar contas). A tela precisa dizer isso.
  contaBancaria String?
  bancoId       String?

  /// O relatório, congelado no momento do import. ⚠ Nada some: o que foi descartado e o que ficou
  /// fora do escopo são CONTADOS, senão "não veio nada" e "deu erro" ficam iguais.
  transacoesLidas Int
  criados         Int
  jaImportadas    Int
  /// Transação que o parser derrubou (sem data, valor zero) — com o motivo, em `detalhe`.
  descartadas     Int
  /// ⚠ Créditos. Esta fila é de DESPESA: a forma do lançamento de entrada não foi medida, e criar
  /// item de fila que não pode ser resolvido é beco sem saída. Contados e nomeados.
  foraDoEscopo    Int
  /// Anomalias da identidade (sem conta bancária, sem `FITID`, `FITID` repetido) + os descartes.
  detalhe         Json?

  criadoPor String
  criadoEm  DateTime @default(now())

  portalClient PortalClient @relation(fields: [portalClientId], references: [id], onDelete: Cascade)

  @@index([portalClientId, criadoEm])
  @@index([portalClientId, hashArquivo])
  @@map("ofx_imports")
}
