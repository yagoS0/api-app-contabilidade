# Ambiente
NODE_ENV=development
LOG_LEVEL=info
TZ=America/Sao_Paulo

# Segurança (recomendado)
# Lista de chaves (separadas por vírgula) aceitas pelo backend
API_KEYS=chave-interna-1,chave-interna-2

# Q30: chave-mestra dedicada que cifra os certificados digitais (PFX + senha) em repouso.
# OBRIGATÓRIA (a API não sobe sem ela) e SEM fallback pro JWT_SECRET. Mínimo 32 chars.
# Gere com:  openssl rand -base64 48
CERT_SECRET_KEY=

# === Q35 Fase 2: Cofre AWS KMS (envelope encryption) — OPCIONAL ===
# Com AWS_KMS_CERT_KEY_ID setado, NOVOS certificados (PFX + senha) nascem cifrados por uma DEK
# gerada pelo KMS (formato kms-v1). Sem essas vars, o app segue no modo local (CERT_SECRET_KEY).
# Migração é LAZY: certs antigos seguem funcionando; só uploads novos viram kms-v1.
# Região/credenciais DEDICADAS (não reusa AWS_REGION do S3 de guias). Requer Node >= 20 em produção.
AWS_KMS_CERT_KEY_ID=
AWS_KMS_REGION=sa-east-1
# Se não definir abaixo, cai nas AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY compartilhadas.
AWS_KMS_ACCESS_KEY_ID=
AWS_KMS_SECRET_ACCESS_KEY=

# Autenticação com usuário/senha
# Usuário admin inicial (usado no script npm run prisma:seed)
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=trocar123
# Opcional
ADMIN_NAME=Administrador

# Fallback adicional: array JSON em AUTH_USERS (útil durante migração; pode remover após mover todos para o banco)
# Exemplo: [{"username":"admin","password":"mudar123","role":"admin"}]
AUTH_USERS=[]
JWT_SECRET=
# Opcional: padrão 1h
# JWT_EXPIRES_IN=1h
# Refresh token (opcional; padrão 7d)
# REFRESH_TOKEN_EXPIRES_IN=7d

# Storage (S3 ou compatível) para XML/PDF de notas
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Google Service Account
# Caminho absoluto para o JSON de credenciais
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
# Alternativa para ambientes PaaS: JSON inline em variável secreta
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# E-mail
# Use Gmail API (delegação) OU SMTP. Se USE_GMAIL_API=1, configure o usuário delegado.
# Gmail API: prioridade GOOGLE_APPLICATION_CREDENTIALS_JSON (recomendado no Railway); senão arquivo em GOOGLE_APPLICATION_CREDENTIALS (deve ser .json, não pasta).
USE_GMAIL_API=0
GMAIL_DELEGATED_USER=
# SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente; se vazio, usa GMAIL_DELEGATED_USER
SMTP_FROM=

# Servidor HTTP
HOST=0.0.0.0
PORT=3000

# Guias: PDFs ficam em PostgreSQL (Guide.pdfBytes). Upload pelo portal.
# Serviço FastAPI de extração de PDF (obrigatório para upload de guias). Ex. rede privada:
# PDF_READER_URL=http://pdf-reader.railway.internal:8000
# PDF_READER_TIMEOUT_MS=30000
# Opcional: fixa YYYY-MM para alertas de guia na lista de empresas (padrão = mês civil anterior).
# GUIDE_COMPLIANCE_COMPETENCIA=2026-02

# SERPRO / Integra Contador
# Habilita a base da integracao com PGDAS-D
# SERPRO_ENABLE_PGDASD=0
# SERPRO_ENV=homolog
# SERPRO_AUTH_URL=https://autenticacao.sapi.serpro.gov.br/authenticate
# SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br/integra-contador/v1
# SERPRO_CONSUMER_KEY=
# SERPRO_CONSUMER_SECRET=
# SERPRO_SCOPE=
# SERPRO_TIMEOUT_MS=30000
# Company legada que armazena o PFX/P12 do escritorio/procurador
# SERPRO_CERT_COMPANY_ID=
# SERPRO_PGDASD_WORKER_ENABLED=0

# Q40 — Integra Contador: confirmação de pagamento (PAGTOWEB) + SITFIS.
# ⚠ Manter DESLIGADO (0) até confirmar idServiço/payload no catálogo oficial + validar no sandbox.
# Confirmação de pagamento por comprovante oficial (PAGTOWEB/COMPARRECADACAO):
# INTEGRACAO_SERPRO_PAGTOWEB=0
# SERPRO_PAGTOWEB_SYSTEM=PAGTOWEB
# SERPRO_PAGTOWEB_SERVICE_COMPROVANTE=COMPARRECADACAO72
# Cron próprio de confirmação de pagamento (dia/hora vêm das settings; este é só o opt-in do worker):
# SERPRO_PAYMENT_CONFIRMATION_WORKER_ENABLED=0
# Situação fiscal (SITFIS) — idServiços/versão confirmados no catálogo oficial (Q41).
# Fluxo assíncrono: SOLICITARPROTOCOLO91 (/Apoiar, dados="") → RELATORIOSITFIS92 (/Emitir,
# dados=JSON escapado {"protocoloRelatorio":...}); status HTTP 200=pronto / 202=processando / 304=aguardar.
# Validar versão (2.0 vs 1.0) e os labels do relatório no trial antes de ligar em produção.
# INTEGRACAO_SERPRO_SITFIS=0
# SERPRO_SITFIS_SYSTEM=SITFIS
# SERPRO_SITFIS_SERVICE_PROTOCOLO=SOLICITARPROTOCOLO91
# SERPRO_SITFIS_SERVICE_RELATORIO=RELATORIOSITFIS92
# SERPRO_SITFIS_VERSAO=2.0

# Q42: captura NFS-e (ADN gov.br) em LOTE. Default: lote=true (até 50 docs/chamada) + parada por
# lote incompleto. Só mexer se o Swagger do ADN mudar o parâmetro/rota do lote.
# ADN_LOTE=1          # 0 = volta à consulta unitária (NÃO recomendado — varre 1-em-1)
# ADN_LOTE_MAX=50     # tamanho do lote (sinal de fim: retorno < ADN_LOTE_MAX)

# NFS-e (padrão nacional)
NFSE_CERT_PFX_PATH=/abs/path/to/certificado.pfx
NFSE_CERT_PFX_PASSWORD=senha-certificado
# Base do provedor (ex.: SEFIN Nacional)
NFSE_BASE_URL=https://sefin.nfse.gov.br/SefinNacional
# NFSE_ENV=homolog
# NFSE_PATH=/nfse          # emissão via DPS
# NFSE_CONSULT_PATH=/nfse/consulta  # consulta por período (XML)
# NFSE_DPS_PATH=/dps       # consulta por idDps
# NFSE_NFSE_PATH=/nfse     # consulta por chaveAcesso

# ADN (Ambiente Nacional de Dados)
# ADN_BASE_URL=https://adn.nfse.gov.br/contribuintes
# ADN_DFE_PATH=/DFe  # mantenha o DFe com maiúsculas
# ADN_CNPJ_CONSULTA=12345678000199
# ADN_CERT_PATH=./cert.pem
# ADN_KEY_PATH=./key.pem
# NFSE_BASE_URL=https://api.nacional.nfse.gov.br
