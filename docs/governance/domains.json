      "reviewers": [
        "altan_domain_reviewer",
        "altan_backend_reviewer"
      ],
      "risk": "high",
      "consumers": [
        "guides",
        "commercial"
      ]
    },
    "commercial": {
      "prefixes": [
        "apps/api/src/application/onboarding/",
        "apps/web/src/features/onboarding/",
        "apps/web/src/features/comercial/"
      ],
      "reviewers": [
        "altan_domain_reviewer",
        "altan_ux_reviewer"
      ],
      "risk": "high",
      "consumers": [
        "operations",
        "communication"
      ]
    },
    "operations": {
      "prefixes": [
        "apps/api/src/workers/",
        "apps/api/src/application/operacoes/",
        "apps/api/src/application/company/",
        "apps/api/src/application/companies/",
        "apps/api/src/application/calendario/",
        "apps/api/src/application/tasks/",
        "apps/web/src/features/operacoes/",
        "apps/web/src/features/companies/",
        "apps/web/src/features/calendario/"
      ],
      "reviewers": [
        "altan_domain_reviewer",
        "altan_backend_reviewer"
      ],
      "risk": "high",
      "consumers": [
        "web",
        "portal"
      ]
    },
    "security": {
      "prefixes": [
        "apps/api/src/application/auth/",
        "apps/api/src/application/security/",
        "apps/api/src/middlewares/",
        "apps/api/src/routes/middlewares/",
        "apps/api/src/routes/auth.js",
        "apps/api/src/infrastructure/security/"
      ],
      "reviewers": [
        "altan_backend_reviewer",
        "altan_system_reviewer"
      ],
      "risk": "high",
      "consumers": [
        "api",
        "web",
        "portal"
      ]
    },
    "documentation": {
      "prefixes": [
        "docs/",
        "README.md",
        "CLAUDE.md",
        "DESIGN_SYSTEM.md",
        "LEIA_ME_PRIMEIRO.md",
        "PLANO_MESTRE_CODEX.md",
        "UX_RULES.md"
      ],
      "reviewers": [
        "altan_domain_reviewer"
      ],
      "risk": "low",
      "consumers": []
    }
  }
}
